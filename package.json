{
  "name": "college-erp-saas",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @college-erp/database prisma:generate",
    "db:migrate": "pnpm --filter @college-erp/database prisma:migrate",
    "db:seed": "pnpm --filter @college-erp/database prisma:seed",
    "db:validate": "pnpm --filter @college-erp/database prisma:validate",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@college-erp/eslint-config": "workspace:*",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
