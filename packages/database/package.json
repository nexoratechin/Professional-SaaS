{
  "name": "@college-erp/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --config ../../eslint.config.js",
    "test": "jest --config jest.config.js",
    "clean": "rimraf dist .turbo",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "db:deploy:safe": "ts-node --transpile-only scripts/safe-migrate.ts",
    "db:migration:rollback": "ts-node --transpile-only scripts/migration-rollback.ts",
    "tenant:db:list": "ts-node --transpile-only scripts/tenant-db.ts list",
    "tenant:db:migrate": "ts-node --transpile-only scripts/tenant-db.ts migrate"
  },
  "dependencies": {
    "@college-erp/auth": "workspace:*",
    "@college-erp/backup": "workspace:*",
    "@college-erp/observability": "workspace:*",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.10",
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
