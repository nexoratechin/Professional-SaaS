  studentExams      StudentExam[]

  @@map("sections")
}

// ---------------------------------------------------------------------------
// Student 360 (Phase 2) — the full student domain: profile, guardians, documents,
// admissions/academic/enrollment history, attendance, fees/payments, exams/results,
// certificates, library, hostel, transport, holds, status history, communications, and an
// append-only activity timeline. Every model is tenant-owned (required tenantId) and anchors
// to the Foundation/Organization master data (Campus, Program, AcademicYear, Term, Section,
// Batch). Sub-resources are children of Student with onDelete: Cascade so a student's record
// canvas is compositionally owned; reference models use Restrict/SetNull per convention.
// String-denormalized "history" models (attendanceType, mode, course/head/route names, etc.)
// follow the codebase's free-form-string philosophy: business modules plug into the tenant's
// configuration engine instead of hardcoding enum taxonomies.
// ---------------------------------------------------------------------------

