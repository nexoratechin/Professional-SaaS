model Plan {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  description  String?
  priceCents   Int?         @map("price_cents")
  currency     String       @default("INR")
  billingCycle BillingCycle @default(ANNUAL) @map("billing_cycle")
  isCustom     Boolean      @default(false) @map("is_custom")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  subscriptions Subscription[]
  planFeatures  PlanFeatureFlag[]
  planModules   PlanModule[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String             @map("tenant_id") @db.Uuid
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  planId             String             @map("plan_id")
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(TRIALING)
  billingCycle       BillingCycle       @map("billing_cycle")
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  canceledAt         DateTime?          @map("canceled_at")
  /// True when the tenant (or an admin on their behalf) has opted out of auto-renewal: the
  /// subscription keeps service through the current period end, then the worker sweep turns it
  /// CANCELED instead of renewing it. Reversing it (reinstate) lets the subscription renew again.
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  items    SubscriptionItem[]
  invoices Invoice[]
  payments Payment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("subscriptions")
}

/// moduleKey is only set on items that grant an entitlement â€” ADDON_MODULE (a catalog module
/// purchased directly on this subscription rather than bundled via Plan.planModules) and CUSTOM
/// items representing a negotiated one-off feature grant. It is null for BASE/PER_STUDENT/
/// PER_CAMPUS items, which are pure billing quantities (student/campus counts) with nothing to
/// materialize as an Entitlement â€” see EntitlementsService.recompute.
model SubscriptionItem {
  id             String               @id @default(cuid())
  tenantId       String               @map("tenant_id") @db.Uuid
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscriptionId String               @map("subscription_id")
  subscription   Subscription         @relation(fields: [subscriptionId], references: [id])
  itemType       SubscriptionItemType @map("item_type")
  description    String
  moduleKey      String?              @map("module_key")
  quantity       Int                  @default(1)
  unitPriceCents Int                  @map("unit_price_cents")
  currency       String               @default("INR")
  createdAt      DateTime             @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([subscriptionId])
  @@map("subscription_items")
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  module      String
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  planFeatures    PlanFeatureFlag[]
  tenantOverrides TenantFeatureFlag[]

  @@map("feature_flags")
}

model PlanFeatureFlag {
  id            String      @id @default(cuid())
  planId        String      @map("plan_id")
  plan          Plan        @relation(fields: [planId], references: [id])
  featureFlagId String      @map("feature_flag_id")
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id])

  @@unique([planId, featureFlagId])
  @@map("plan_feature_flags")
}

/// A named add-on capacity/module bundled into a Plan â€” e.g. "5 extra campuses" or "library
/// module" â€” distinct from PlanFeatureFlag (a plain boolean on/off toggle). moduleKey is a
/// free-form catalog key (not an FK to FeatureFlag) since a module can grant a QUANTITY limit
/// that no boolean FeatureFlag models today. No tenantId â€” like Plan/PlanFeatureFlag this is
/// pure catalog data, only ever read/written through PlatformPrismaService.
model PlanModule {
  id         String          @id @default(cuid())
  planId     String          @map("plan_id")
  plan       Plan            @relation(fields: [planId], references: [id])
  moduleKey  String          @map("module_key")
  name       String
  type       EntitlementType @default(BOOLEAN)
  /// Only meaningful when type = QUANTITY (e.g. limitValue = 5 extra campuses). Null for BOOLEAN.
  limitValue Int?            @map("limit_value")
  createdAt  DateTime        @default(now()) @map("created_at")

  @@unique([planId, moduleKey])
  @@map("plan_modules")
}

model TenantFeatureFlag {
  id                      String      @id @default(cuid())
  tenantId                String      @map("tenant_id") @db.Uuid
  tenant                  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  featureFlagId           String      @map("feature_flag_id")
  featureFlag             FeatureFlag @relation(fields: [featureFlagId], references: [id])
  enabled                 Boolean
  reason                  String?
  createdByPlatformUserId String?     @map("created_by_platform_user_id")
  createdAt               DateTime    @default(now()) @map("created_at")

  @@unique([tenantId, featureFlagId])
  @@index([tenantId])
  @@map("tenant_feature_flags")
}

model UsageEvent {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  eventType  String   @map("event_type")
  quantity   Decimal  @db.Decimal(18, 4)
  occurredAt DateTime @default(now()) @map("occurred_at")
  metadata   Json?

  @@index([tenantId, eventType, occurredAt])
  @@map("usage_events")
}

/// The single materialized source of truth entitlement resolution reads from (see
/// EntitlementsService.recompute, called whenever a tenant's subscription/plan/plan-modules
/// change) â€” TenantFeaturesService.getEffectiveFeatures/isEnabled read Entitlement rows instead
/// of live-joining Plan.planFeatures, so a plan swap or module grant takes effect on the very
/// next request with no code deployment. `key` is either a FeatureFlag.key (BOOLEAN, sourced
/// from PLAN/TENANT_OVERRIDE) or a PlanModule.moduleKey (BOOLEAN or QUANTITY, sourced from
/// PLAN_MODULE/SUBSCRIPTION_ITEM). `effectiveUntil` is set to the owning Subscription's
/// currentPeriodEnd at recompute time so an expired subscription's entitlements self-heal
/// (queries filter on effectiveUntil) without the worker needing to run any entitlement logic
/// itself â€” see EntitlementsService.isEntitled/getEffectiveFeatures. TENANT_OVERRIDE rows have
/// effectiveUntil = null (they don't expire with a billing period) and are the only source
/// recompute() preserves rather than deletes-and-rebuilds.
model Entitlement {
  id             String            @id @default(cuid())
  tenantId       String            @map("tenant_id") @db.Uuid
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  key            String
  type           EntitlementType   @default(BOOLEAN)
  boolValue      Boolean           @default(false) @map("bool_value")
  /// Only meaningful when type = QUANTITY. Null for BOOLEAN.
  limitValue     Int?              @map("limit_value")
  source         EntitlementSource
  /// The Plan.id, PlanModule.id, or SubscriptionItem.id this row was materialized from â€”
  /// informational only (recompute always regenerates from the live subscription, never reads
  /// this back), null for TENANT_OVERRIDE.
  sourceRef      String?           @map("source_ref")
  effectiveFrom  DateTime          @default(now()) @map("effective_from")
  effectiveUntil DateTime?         @map("effective_until")
  reason         String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("entitlements")
}

/// Platform-generated billing record for one tenant's subscription period. Always written
/// through PlatformPrismaService with an explicit tenantId (same convention as
/// Subscription/UsageEvent above) â€” tenant admins never create or edit these, only view their
/// own via the tenant self-service read endpoint. No payment-gateway integration exists yet
/// (Phase 6+) â€” `markPaid`/`void` are manual platform-admin reconciliation actions.
model Invoice {
  id                      String        @id @default(cuid())
  tenantId                String        @map("tenant_id") @db.Uuid
  tenant                  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscriptionId          String?       @map("subscription_id")
  subscription            Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoiceNumber           String        @unique @map("invoice_number")
  status                  InvoiceStatus @default(DRAFT)
  currency                String        @default("INR")
  subtotalCents           Int           @map("subtotal_cents")
  taxCents                Int           @default(0) @map("tax_cents")
  totalCents              Int           @map("total_cents")
  periodStart             DateTime      @map("period_start")
  periodEnd               DateTime      @map("period_end")
  issuedAt                DateTime?     @map("issued_at")
  dueAt                   DateTime?     @map("due_at")
  paidAt                  DateTime?     @map("paid_at")
  voidedAt                DateTime?     @map("voided_at")
  createdByPlatformUserId String?       @map("created_by_platform_user_id")
  /// MinIO/S3 key of the generated invoice PDF (always under the owning tenant's prefix, so
  /// StorageService's tenant-key assertion applies). Null until the first time the PDF is
  /// rendered â€” generation is lazy and re-runnable, so a failed upload never bricks a download.
  pdfStorageKey           String?       @map("pdf_storage_key")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("invoices")
}

/// A single payment attempt against a subscription invoice. Every invoice lines up N payments
/// (typically one, but retries produce sequential attempts; the lifecycle sweep also records
/// auto-charges). Payments are platform control-plane data (like Subscription/Invoice): always
/// reached through PlatformPrismaService with explicit tenantId/invoiceId filtering â€” never the
/// tenant-guard extension.
model Payment {
  id                      String        @id @default(cuid())
  tenantId                String        @map("tenant_id") @db.Uuid
  tenant                  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscriptionId          String        @map("subscription_id")
  subscription            Subscription  @relation(fields: [subscriptionId], references: [id])
  invoiceId               String        @map("invoice_id")
  invoice                 Invoice       @relation(fields: [invoiceId], references: [id])
  amountCents             Int           @map("amount_cents")
  currency                String        @default("INR")
  status                  PaymentStatus @default(PENDING)
  method                  PaymentMethod
  /// External gateway transaction id for a real integration (Phase 6+/payments module); null
  /// for manual/offline reconciliation, which is the only mode today.
  gatewayReference        String?       @unique @map("gateway_reference")
  failureReason           String?       @map("failure_reason")
  paidAt                  DateTime?     @map("paid_at")
  refundedAt              DateTime?     @map("refunded_at")
  createdByPlatformUserId String?       @map("created_by_platform_user_id")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([invoiceId])
  @@index([subscriptionId])
  @@index([status])
  @@map("payments")
}

/// SaaS-wide billing knobs, enforced by both apps/api and apps/worker (subscription-lifecycle
/// sweep). A single 'default' row. Tax rate is in basis points (1800 = 18%); invoice
/// numbering is sequential under a configurable prefix using next_invoice_sequence as an
/// atomic counter (see InvoicesService.allocateInvoiceNumber). gracePeriodDays is how long a
/// PAST_DUE subscription keeps access with an overdue invoice before the worker SUSPENDs it;
/// retryIntervalDays is how often the same sweep re-attempts a failed payment.
model BillingConfig {
  id                      String   @id @default("default")
  taxName                 String   @default("GST") @map("tax_name")
  taxRateBps              Int      @default(1800) @map("tax_rate_bps")
  invoicePrefix           String   @default("INV") @map("invoice_prefix")
  nextInvoiceSequence     Int      @default(1) @map("next_invoice_sequence")
  gracePeriodDays         Int      @default(7) @map("grace_period_days")
  renewalDueDays          Int      @default(15) @map("renewal_due_days")
  retryIntervalDays       Int      @default(1) @map("retry_interval_days")
  prorationEnabled        Boolean  @default(true) @map("proration_enabled")
  updatedByPlatformUserId String?  @map("updated_by_platform_user_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("billing_config")
}

model InvoiceLineItem {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id") @db.Uuid
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoiceId      String   @map("invoice_id")
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int      @default(1)
  unitPriceCents Int      @map("unit_price_cents")
  amountCents    Int      @map("amount_cents")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_line_items")
}

/// Support request tracked by the platform ops team. tenantId is OPTIONAL (same convention as
/// LoginEvent/PlatformAuditLog) â€” a ticket can be tenant-specific (raised by a tenant user, or by
/// a platform admin on a tenant's behalf) or a general platform issue with no tenant at all.
/// Always accessed via PlatformPrismaService with explicit tenantId filtering when a tenant
/// context is involved â€” never the tenant-guard extension (this is control-plane data).
model SupportTicket {
  id                       String                @id @default(cuid())
  tenantId                 String?               @map("tenant_id") @db.Uuid
  tenant                   Tenant?               @relation(fields: [tenantId], references: [id])
  subject                  String
  description              String
  status                   SupportTicketStatus   @default(OPEN)
  priority                 SupportTicketPriority @default(MEDIUM)
  raisedByUserId           String?               @map("raised_by_user_id") @db.Uuid
  raisedByPlatformUserId   String?               @map("raised_by_platform_user_id")
  assignedToPlatformUserId String?               @map("assigned_to_platform_user_id")
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")
  resolvedAt               DateTime?             @map("resolved_at")

  comments SupportTicketComment[]

  @@index([tenantId])
  @@index([status])
  @@index([assignedToPlatformUserId])
  @@map("support_tickets")
}

model SupportTicketComment {
  id                   String        @id @default(cuid())
  ticketId             String        @map("ticket_id")
  ticket               SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType           String        @map("author_type")
  authorUserId         String?       @map("author_user_id") @db.Uuid
  authorPlatformUserId String?       @map("author_platform_user_id")
  body                 String
  createdAt            DateTime      @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("support_ticket_comments")
}

/// The single centralized, append-only audit trail for both platform- and tenant-level
/// sensitive actions across every module (auth, RBAC, users, tenants, subscriptions, documents,
/// notifications, security config, and â€” once built â€” the business modules like
/// students/fees/payments/exams). `module` classifies WHICH subsystem produced the entry (see
/// packages/auth's AUDIT_MODULES) so the searchable audit UI can filter by it independently of
/// `action`/`entityType`. `requestId` correlates every entry written during the same inbound
/// HTTP request (see apps/api's RequestIdMiddleware) even across multiple audit writes in one
/// handler. `actorEmail` is a denormalized snapshot of the actor's email AT THE TIME of the
/// action â€” captured once by AuditService itself (not threaded through every call site) so the
/// trail stays human-readable even if the underlying user is later renamed, deactivated, or the
/// tenant is long gone.
/// Known DB-level control not expressible in the Prisma schema DSL: a BEFORE UPDATE OR DELETE
/// trigger (added by migration 20260907170000_add_centralized_immutable_audit_log) rejects any
/// attempt to mutate or remove a row here, even via raw SQL or a future application bug â€”
/// AuditService itself also only ever INSERTs (no update/delete method exists on it).
model PlatformAuditLog {
  id                  String     @id @default(cuid())
  scope               AuditScope
  tenantId            String?    @map("tenant_id") @db.Uuid
  tenant              Tenant?    @relation(fields: [tenantId], references: [id])
  actorType           String     @map("actor_type")
  actorUserId         String?    @map("actor_user_id") @db.Uuid
  actorPlatformUserId String?    @map("actor_platform_user_id")
  /// Denormalized snapshot, not a live relation â€” see model doc comment.
  actorEmail          String?    @map("actor_email")
  action              String
  /// Which subsystem produced this entry â€” see packages/auth's AUDIT_MODULES.
  module              String     @default("platform")
  entityType          String     @map("entity_type")
  entityId            String?    @map("entity_id")
  before              Json?
  after               Json?
  ipAddress           String?    @map("ip_address")
  userAgent           String?    @map("user_agent")
  /// Correlates every audit entry written during the same inbound HTTP request â€” see
  /// apps/api's RequestIdMiddleware. Null for entries written outside an HTTP request (seed
  /// scripts, background jobs).
  requestId           String?    @map("request_id")
  createdAt           DateTime   @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@index([module, createdAt])
  @@index([requestId])
  @@index([actorEmail])
  @@map("platform_audit_logs")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model PlatformUser {
  id                  String           @id @default(cuid())
  email               String           @unique
  passwordHash        String           @map("password_hash")
  fullName            String           @map("full_name")
  role                PlatformUserRole @default(PLATFORM_SUPPORT)
  isActive            Boolean          @default(true) @map("is_active")
  failedLoginAttempts Int              @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?        @map("locked_until")
  /// MFA/TOTP for the platform-admin realm mirrors the tenant-user realm's mechanism (same
  /// packages/auth core, same AES-256-GCM-at-rest encryption) since PlatformUser is the
  /// highest-privilege account in the whole system. Deliberately NOT extended with trusted
  /// devices / suspicious-login detection / password history â€” see PlatformMfaService's doc
  /// comment for that scope boundary.
  mfaEnabled          Boolean          @default(false) @map("mfa_enabled")
  mfaSecretEncrypted  String?          @map("mfa_secret_encrypted")
  mfaEnabledAt        DateTime?        @map("mfa_enabled_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  sessions       PlatformSession[]
  mfaBackupCodes PlatformMfaBackupCode[]
  securityEvents SecurityEvent[]

  @@map("platform_users")
}

model PlatformSession {
  id               String       @id @default(cuid())
  platformUserId   String       @map("platform_user_id")
  platformUser     PlatformUser @relation(fields: [platformUserId], references: [id])
  refreshTokenHash String       @unique @map("refresh_token_hash")
  userAgent        String?      @map("user_agent")
  ipAddress        String?      @map("ip_address")
  expiresAt        DateTime     @map("expires_at")
  revokedAt        DateTime?    @map("revoked_at")
  lastUsedAt       DateTime     @default(now()) @map("last_used_at")
  createdAt        DateTime     @default(now()) @map("created_at")

  @@index([platformUserId])
  @@map("platform_sessions")
}

model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String     @map("tenant_id") @db.Uuid
  tenant              Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  email               String
  passwordHash        String?    @map("password_hash")
  fullName            String     @map("full_name")
  /// Mobile number for SMS/WhatsApp delivery. Nullable: not every user has one, and the
  /// notifications worker marks those deliveries FAILED (not suppressed) so it surfaces clearly.
  phone               String?
  status              UserStatus @default(INVITED)
  emailVerifiedAt     DateTime?  @map("email_verified_at")
  lastLoginAt         DateTime?  @map("last_login_at")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  /// TOTP secret is encrypted at rest (AES-256-GCM, apps/api's MfaSecretCipher) â€” unlike
  /// refresh/reset tokens it must be decryptable to verify a 6-digit code, so it can't be a
  /// one-way hash. mfaEnabled flips true only after enroll+confirm succeeds (see MfaService) â€”
  /// a secret can exist mid-enrollment without mfaEnabled being true yet.
  mfaEnabled          Boolean    @default(false) @map("mfa_enabled")
  mfaSecretEncrypted  String?    @map("mfa_secret_encrypted")
  mfaEnabledAt        DateTime?  @map("mfa_enabled_at")
  createdBy           String?    @map("created_by")
  updatedBy           String?    @map("updated_by")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  userRoles                  UserRole[]
  sessions                   Session[]
  passwordResetTokens        PasswordResetToken[]
  emailVerificationTokens    EmailVerificationToken[]
  mfaBackupCodes             MfaBackupCode[]
  trustedDevices             TrustedDevice[]
  passwordHistory            PasswordHistory[]
  securityEvents             SecurityEvent[]
  facultyAssignments         CourseOfferingFaculty[]       @relation("FacultyAssignedCourseOfferings")
  advisingRecords            AcademicAdvisingRecord[]      @relation("AdvisorAdvisingRecords")
  timetableEntries           TimetableEntry[]              @relation("FacultyTimetableEntries")
  publishedTimetables        Timetable[]                   @relation("TimetablePublisher")
  availabilityBlocks         FacultyAvailability[]         @relation("FacultyAvailabilityBlocks")
  substitutions              TimetableSubstitution[]       @relation("SubstituteTimetableEntries")
  facultyAttendance          FacultyAttendance[]           @relation("FacultyAttendanceLogs")
  correctionRequests         AttendanceCorrectionRequest[] @relation("AttendanceCorrectionRequesters")
  correctionDecisions        AttendanceCorrectionRequest[] @relation("AttendanceCorrectionDeciders")
  deviceMappings             AttendanceDeviceUser[]        @relation("UserDeviceMappings")
  deviceLogs                 AttendanceDeviceLog[]         @relation("UserDeviceLogs")
  examInvigilatorAssignments ExamInvigilatorAssignment[]
  libraryMembers             LibraryMember[]
  transportDrivers           TransportDriver[]
  employeeProfile            Employee?                     @relation("UserEmployeeProfile")
  hrUploadedDocuments        EmployeeDocument[]            @relation("HrDocumentUploaders")
  hrLeaveDecisions           LeaveApplication[]            @relation("LeaveApplicationApprovers")
  hrReviewedPerformances     EmployeePerformanceReview[]   @relation("PerformanceReviewers")
  hrProcessedPayrollRuns     PayrollRun[]                  @relation("PayrollRunProcessors")
  hrApprovedPayrollRuns      PayrollRun[]                  @relation("PayrollRunApprovers")
  pushDevices                UserPushDevice[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("users")
}

model Role {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code      String
  name      String
  isSystem  Boolean   @default(false) @map("is_system")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique
  module      String
  action      PermissionAction
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@index([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roleId       String              @map("role_id") @db.Uuid
  role         Role                @relation(fields: [roleId], references: [id])
  permissionId String              @map("permission_id") @db.Uuid
  permission   Permission          @relation(fields: [permissionId], references: [id])
  /// What kind of scope this role's grant of this permission operates under â€” see
  /// PermissionScopeType. The concrete scope VALUE (which campus/department/program) is bound
  /// per user assignment on UserRole, not here.
  scopeType    PermissionScopeType @default(GLOBAL) @map("scope_type")
  createdBy    String?             @map("created_by")
  createdAt    DateTime            @default(now()) @map("created_at")

  @@unique([roleId, permissionId])
  @@index([tenantId])
  @@map("role_permissions")
}

model UserRole {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId            String      @map("user_id") @db.Uuid
  user              User        @relation(fields: [userId], references: [id])
  roleId            String      @map("role_id") @db.Uuid
  role              Role        @relation(fields: [roleId], references: [id])
  /// Org-unit anchors for this specific assignment, used whenever one of the role's granted
  /// permissions has a CAMPUS/DEPARTMENT/PROGRAM scopeType. At most one is normally set,
  /// matching whichever scope the assignment represents (e.g. a HOD assignment sets
  /// scopeDepartmentId); enforced at the application layer, not a DB constraint.
  scopeCampusId     String?     @map("scope_campus_id") @db.Uuid
  scopeCampus       Campus?     @relation(fields: [scopeCampusId], references: [id], onDelete: SetNull)
  scopeDepartmentId String?     @map("scope_department_id") @db.Uuid
  scopeDepartment   Department? @relation(fields: [scopeDepartmentId], references: [id], onDelete: SetNull)
  scopeProgramId    String?     @map("scope_program_id") @db.Uuid
  scopeProgram      Program?    @relation(fields: [scopeProgramId], references: [id], onDelete: SetNull)
  assignedByUserId  String?     @map("assigned_by_user_id") @db.Uuid
  assignedAt        DateTime    @default(now()) @map("assigned_at")

  @@unique([tenantId, userId, roleId])
  @@index([tenantId])
  @@index([userId])
  @@index([scopeCampusId])
  @@index([scopeDepartmentId])
  @@index([scopeProgramId])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id])
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([tenantId, userId])
  @@map("sessions")
}

model LoginEvent {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String?          @map("tenant_id") @db.Uuid
  tenant         Tenant?          @relation(fields: [tenantId], references: [id])
  emailAttempted String           @map("email_attempted")
  result         LoginEventResult
  ipAddress      String?          @map("ip_address")
  userAgent      String?          @map("user_agent")
  occurredAt     DateTime         @default(now()) @map("occurred_at")

  @@index([tenantId, occurredAt])
  @@index([emailAttempted, occurredAt])
  @@map("login_events")
}

/// Single-use, short-lived token for the forgot/reset-password flow. Only the SHA-256 hash is
/// stored (same convention as refresh tokens) â€” the raw value exists only in the link sent to
/// the user. A successful reset revokes every active Session for the user (see
/// PasswordResetService), so a stolen old session can't outlive a password change.
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([userId])
  @@map("password_reset_tokens")
}

/// Single-use, short-lived token for confirming a user's email address. Verification is
/// tracked (emailVerifiedAt) but deliberately does NOT block login (see UsersService.invite) â€”
/// an admin who invites a user with a known-good email and sets their password has already
/// vouched for the account; gating login on verification is left for a future self-registration
/// flow where nobody has vouched for the email yet.
model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([userId])
  @@map("email_verification_tokens")
}

// ---------------------------------------------------------------------------
// Advanced security controls (tenant-user realm). All required tenantId, so the tenant-guard
// extension auto-scopes them like any other tenant-owned model WHEN accessed through a
// request-scoped TenantScopedPrismaClient. Several of the services that own these tables also
// run pre-authentication (the MFA challenge step of login itself, before a session/JWT exists),
// where no request-scoped tenant context is available yet â€” those call sites deliberately go
// through PlatformPrismaService with an explicit tenantId on every query instead, the same
// established pattern AuthService/PasswordResetService/EmailVerificationService already use for
// User/Session/token rows. Deliberately NOT extended to the platform-admin realm (beyond MFA
// itself, see PlatformUser/PlatformMfaBackupCode) â€” see PlatformMfaService's doc comment.
// ---------------------------------------------------------------------------

/// Single-use recovery codes for when a user's authenticator device is unavailable. Hashed with
/// SHA-256 (packages/auth's high-entropy-opaque-value convention), not bcrypt â€” these are
/// crypto-random, never user-chosen, so bcrypt's slow-by-design property buys nothing here.
model MfaBackupCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([userId])
  @@map("mfa_backup_codes")
}

/// Platform-admin-realm equivalent of MfaBackupCode â€” a separate table (no tenantId at all)
/// rather than a polymorphic column on the tenant-realm table, matching this schema's existing
/// Session/PlatformSession precedent of parallel realm-specific models.
model PlatformMfaBackupCode {
  id             String       @id @default(cuid())
  platformUserId String       @map("platform_user_id")
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  codeHash       String       @unique @map("code_hash")
  usedAt         DateTime?    @map("used_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([platformUserId])
  @@map("platform_mfa_backup_codes")
}

/// "Remember this device" â€” set only after a full MFA challenge succeeds (never as a substitute
/// for MFA, only as a way to skip re-prompting for `trustedDeviceDays`). deviceTokenHash follows
/// the opaque-token/SHA-256 convention; the raw token lives only in an httpOnly cookie.
model TrustedDevice {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId          String    @map("user_id") @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceTokenHash String    @unique @map("device_token_hash")
  label           String?
  userAgent       String?   @map("user_agent")
  ipAddress       String?   @map("ip_address")
  lastUsedAt      DateTime  @default(now()) @map("last_used_at")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([tenantId, userId])
  @@map("trusted_devices")
}

/// Stores each REPLACED password hash (not the current one, which lives on User.passwordHash)
/// so a future change can be checked against the last N â€” see SecuritySettingsService's
/// passwordHistoryCount. Rows beyond the configured count are pruned on each password change.
model PasswordHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([userId, createdAt])
  @@map("password_history")
}

model SecurityEvent {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope          AuditScope
  tenantId       String?               @map("tenant_id") @db.Uuid
  tenant         Tenant?               @relation(fields: [tenantId], references: [id])
  userId         String?               @map("user_id") @db.Uuid
  user           User?                 @relation(fields: [userId], references: [id])
  platformUserId String?               @map("platform_user_id")
  platformUser   PlatformUser?         @relation(fields: [platformUserId], references: [id])
  eventType      SecurityEventType     @map("event_type")
  severity       SecurityEventSeverity @default(INFO)
  ipAddress      String?               @map("ip_address")
  userAgent      String?               @map("user_agent")
  metadata       Json?
  createdAt      DateTime              @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([platformUserId, createdAt])
  @@index([eventType, createdAt])
  @@map("security_events")
}

/// Tenant-level security policy â€” one row per tenant (created lazily on first read/write with
/// defaults, see SecuritySettingsService). Every threshold is nullable so "unset" cleanly means
/// "inherit the platform default" (PlatformSecuritySettings) rather than needing a sentinel
/// value. mfaRequired only takes effect if the tenant's plan grants FEATURE_KEYS.MFA AND
/// PlatformSecuritySettings.mfaGloballyEnabled is true â€” enforced in SecuritySettingsService, not
/// the DB.
model TenantSecuritySettings {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String   @unique @map("tenant_id") @db.Uuid
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  mfaRequired            Boolean  @default(false) @map("mfa_required")
  passwordHistoryCount   Int?     @map("password_history_count")
  maxFailedLoginAttempts Int?     @map("max_failed_login_attempts")
  accountLockoutMinutes  Int?     @map("account_lockout_minutes")
  trustedDeviceDays      Int?     @map("trusted_device_days")
  notifyOnNewDeviceLogin Boolean  @default(true) @map("notify_on_new_device_login")
  blockSuspiciousLogins  Boolean  @default(false) @map("block_suspicious_logins")
  createdBy              String?  @map("created_by")
  updatedBy              String?  @map("updated_by")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("tenant_security_settings")
}

/// Tenant-specific configuration engine â€” a single JSONB document per tenant storing every
/// configurable aspect of the institution: branding, academic calendar, grading, attendance,
/// fee structure, admissions, numbering formats, certificate/notification templates, etc.
/// Created lazily on first read with empty defaults; the `data` JSON field carries all values
/// so adding new configuration sections never requires a schema migration.
model TenantConfiguration {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @unique @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  data      Json     @default("{}")
  version   Int      @default(1)
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tenant_configurations")
}

/// Control-plane singleton (one row; SecuritySettingsService finds-or-creates it) â€” global
/// defaults applied wherever a tenant hasn't overridden, plus platform-realm-only toggles
/// (mfaRequiredForPlatformAdmins) and kill switches a platform admin can flip without a deploy.
model PlatformSecuritySettings {
  id                              String   @id @default(cuid())
  mfaGloballyEnabled              Boolean  @default(true) @map("mfa_globally_enabled")
  mfaRequiredForPlatformAdmins    Boolean  @default(false) @map("mfa_required_for_platform_admins")
  defaultMaxFailedLoginAttempts   Int      @default(5) @map("default_max_failed_login_attempts")
  defaultAccountLockoutMinutes    Int      @default(15) @map("default_account_lockout_minutes")
  defaultPasswordHistoryCount     Int      @default(5) @map("default_password_history_count")
  defaultTrustedDeviceDays        Int      @default(30) @map("default_trusted_device_days")
  suspiciousLoginDetectionEnabled Boolean  @default(true) @map("suspicious_login_detection_enabled")
  updatedBy                       String?  @map("updated_by")
  createdAt                       DateTime @default(now()) @map("created_at")
  updatedAt                       DateTime @updatedAt @map("updated_at")

  @@map("platform_security_settings")
}

// ---------------------------------------------------------------------------
// Organization (master data â€” campuses, departments, programs, academic_years,
// terms, rooms, buildings, sections, batches). CRUD API lives in apps/api's
// organization module; the schema, RBAC permissions, and tenant isolation are
// enforced here and mirrored in packages/auth's permission catalog.
// ---------------------------------------------------------------------------

model Campus {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code        String
  name        String
  addressLine String?   @map("address_line")
  city        String?
  state       String?
  country     String?   @default("India")
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  departments               Department[]
  buildings                 Building[]
  rooms                     Room[]
  roleScopeUsers            UserRole[]
  students                  Student[]
  admissionApplications     AdmissionApplication[]
  courseOfferings           CourseOffering[]
  timetables                Timetable[]                @relation("CampusTimetables")
  hostels                   Hostel[]
  transportVehicles         TransportVehicle[]
  transportRoutes           TransportRoute[]
  employees                 Employee[]                 @relation("EmployeeCampuses")
  inventoryLocations        InventoryLocation[]
  inventoryAssetAssignments InventoryAssetAssignment[] @relation("InventoryAssetCampusAssignees")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@map("campuses")
}

model Department {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  campusId    String?   @map("campus_id") @db.Uuid
  campus      Campus?   @relation(fields: [campusId], references: [id], onDelete: SetNull)
  code        String
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  programs                  Program[]
  roleScopeUsers            UserRole[]
  courses                   Course[]
  employees                 Employee[]                 @relation("EmployeeDepartments")
  hrDesignations            HrDesignation[]            @relation("DepartmentHrDesignations")
  inventoryPurchaseRequests InventoryPurchaseRequest[]
  inventoryAssetAssignments InventoryAssetAssignment[] @relation("InventoryAssetDepartmentAssignees")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([campusId])
  @@index([tenantId, deletedAt])
  @@map("departments")
}

model Program {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departmentId  String?     @map("department_id") @db.Uuid
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  code          String
  name          String
  degreeLevel   String?     @map("degree_level")
  durationYears Int?        @map("duration_years")
  isActive      Boolean     @default(true) @map("is_active")
  createdBy     String?     @map("created_by")
  updatedBy     String?     @map("updated_by")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")

  roleScopeUsers             UserRole[]
  sections                   Section[]
  batches                    Batch[]
  students                   Student[]
  enrollments                StudentEnrollment[]
  admissions                 StudentAdmission[]
  exams                      StudentExam[]
  admissionPrograms          AdmissionProgramOffer[]
  admissionEnquiries         AdmissionEnquiry[]
  admissionCounsellingSlots  AdmissionCounsellingSlot[]
  curricula                  Curriculum[]
  courseOfferings            CourseOffering[]
  academicProgressionRecords AcademicProgressionRecord[]
  feeStructures              FeeStructure[]
  examSessions               ExamSession[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([departmentId])
  @@index([tenantId, deletedAt])
  @@map("programs")
}

model AcademicYear {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code      String
  name      String
  startDate DateTime  @map("start_date")
  endDate   DateTime  @map("end_date")
  isCurrent Boolean   @default(false) @map("is_current")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  terms                      Term[]
  sections                   Section[]                   @relation("AcademicYearSections")
  batches                    Batch[]                     @relation("AcademicYearBatches")
  students                   Student[]
  enrollments                StudentEnrollment[]
  admissions                 StudentAdmission[]
  admissionSessions          AdmissionSession[]
  admissionApplications      AdmissionApplication[]
  courseOfferings            CourseOffering[]
  academicCalendarEvents     AcademicCalendarEvent[]
  academicProgressionRecords AcademicProgressionRecord[]
  feeStructures              FeeStructure[]
  examSessions               ExamSession[]
  placementOutcomes          PlacementOutcome[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isCurrent])
  @@index([tenantId, deletedAt])
  @@map("academic_years")
}

model Term {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  code           String
  name           String
  sequence       Int          @default(1)
  startDate      DateTime     @map("start_date")
  endDate        DateTime     @map("end_date")
  isCurrent      Boolean      @default(false) @map("is_current")
  createdBy      String?      @map("created_by")
  updatedBy      String?      @map("updated_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  studentEnrollments      StudentEnrollment[]
  studentFees             StudentFee[]
  studentExams            StudentExam[]
  attendance              StudentAttendance[]
  courseOfferings         CourseOffering[]
  courseRegistrations     CourseRegistration[]
  academicAdvisingRecords AcademicAdvisingRecord[] @relation("TermAdvisingRecords")
  academicCalendarEvents  AcademicCalendarEvent[]
  courseBacklogs          CourseBacklog[]
  timetables              Timetable[]              @relation("TermTimetables")
  attendanceSessions      AttendanceSession[]      @relation("TermAttendanceSessions")
  feeStructures           FeeStructure[]
  studentFeeAssignments   StudentFeeAssignment[]
  feeDemands              FeeDemand[]
  examSessions            ExamSession[]
  facultyWorkloads        FacultyWorkload[]        @relation("TermFacultyWorkloads")

  @@unique([academicYearId, code])
  @@index([tenantId])
  @@index([academicYearId])
  @@index([tenantId, deletedAt])
  @@map("terms")
}

model Room {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  campusId     String    @map("campus_id") @db.Uuid
  campus       Campus    @relation(fields: [campusId], references: [id], onDelete: Restrict)
  buildingId   String?   @map("building_id") @db.Uuid
  building     Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  code         String
  name         String
  roomType     RoomType  @default(CLASSROOM) @map("room_type")
  capacity     Int?
  buildingName String?   @map("building_name")
  floor        String?
  isActive     Boolean   @default(true) @map("is_active")
  createdBy    String?   @map("created_by")
  updatedBy    String?   @map("updated_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  timetableEntries           TimetableEntry[]            @relation("RoomTimetableEntries")
  attendanceDevices          AttendanceDevice[]
  examSeatingPlans           ExamSeatingPlan[]
  examSubjects               ExamSubject[]
  examInvigilatorAssignments ExamInvigilatorAssignment[]
  inventoryLocations         InventoryLocation[]

  @@unique([campusId, code])
  @@index([tenantId])
  @@index([campusId])
  @@index([buildingId])
  @@index([tenantId, deletedAt])
  @@map("rooms")
}

model Building {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  campusId    String    @map("campus_id") @db.Uuid
  campus      Campus    @relation(fields: [campusId], references: [id], onDelete: Restrict)
  code        String
  name        String
  addressLine String?   @map("address_line")
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  rooms              Room[]
  inventoryLocations InventoryLocation[]

  @@unique([tenantId, campusId, code])
  @@index([tenantId])
  @@index([campusId])
  @@index([tenantId, deletedAt])
  @@map("buildings")
}

/// A cohort of students admitted to a Program for a given AcademicYear (e.g. "B.Tech 2024
/// Batch"). academicYearId is the year the cohort started â€” optional because the admissions
/// module (which will actually tick batches forward) is a later pass.
model Batch {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  programId      String        @map("program_id") @db.Uuid
  program        Program       @relation(fields: [programId], references: [id], onDelete: Restrict)
  academicYearId String?       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear? @relation("AcademicYearBatches", fields: [academicYearId], references: [id], onDelete: SetNull)
  code           String
  name           String
  startDate      DateTime?     @map("start_date")
  endDate        DateTime?     @map("end_date")
  isActive       Boolean       @default(true) @map("is_active")
  createdBy      String?       @map("created_by")
  updatedBy      String?       @map("updated_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  students                   Student[]
  studentEnrollments         StudentEnrollment[]
  courseOfferings            CourseOffering[]
  academicProgressionRecords AcademicProgressionRecord[]

  @@unique([tenantId, programId, code])
  @@index([tenantId])
  @@index([programId])
  @@index([academicYearId])
  @@index([tenantId, deletedAt])
  @@map("batches")
}

/// A division within a Program for a given period (e.g. "CS-A"), used to group students for
/// timetable/attendance/exams. academicYearId is optional for the same reason as Batch's.
model Section {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  programId      String        @map("program_id") @db.Uuid
  program        Program       @relation(fields: [programId], references: [id], onDelete: Restrict)
  academicYearId String?       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear? @relation("AcademicYearSections", fields: [academicYearId], references: [id], onDelete: SetNull)
  code           String
  name           String
  capacity       Int?
  isActive       Boolean       @default(true) @map("is_active")
  createdBy      String?       @map("created_by")
  updatedBy      String?       @map("updated_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  students           Student[]
  studentEnrollments StudentEnrollment[]
  studentExams       StudentExam[]
  courseOfferings    CourseOffering[]
  timetableEntries   TimetableEntry[]    @relation("SectionTimetableEntries")
  attendanceSessions AttendanceSession[] @relation("SectionAttendanceSessions")
  feeStructures      FeeStructure[]

  @@unique([tenantId, programId, code])
  @@index([tenantId])
  @@index([programId])
  @@index([academicYearId])
  @@index([tenantId, deletedAt])
  @@map("sections")
}

// ---------------------------------------------------------------------------
// Student 360 (Phase 2) â€” the full student domain: profile, guardians, documents,
// admissions/academic/enrollment history, attendance, fees/payments, exams/results,
// certificates, library, hostel, transport, holds, status history, communications, and an
// append-only activity timeline. Every model is tenant-owned (required tenantId) and anchors
// to the Foundation/Organization master data (Campus, Program, AcademicYear, Term, Section,
// Batch). Sub-resources are children of Student with onDelete: Cascade so a student's record
// canvas is compositionally owned; reference models use Restrict/SetNull per convention.
// String-denormalized "history" models (attendanceType, mode, course/head/route names, etc.)
