// ---------------------------------------------------------------------------
// Notifications — centralized, tenant-aware notification infrastructure
// (see apps/api's NotificationsModule, apps/worker's NotificationsProcessor +
// NotificationsCampaignProcessor, and package @college-erp/notifications).
//
// One `Notification` row is created per recipient×channel at enqueue time, always with the
// FINAL rendered subject/body (templates are rendered in the API single-pass — the worker never
// re-renders). Jobs on the BullMQ `notifications` queue carry only tenantId + notificationId;
// the worker rebuilds a tenant-scoped client and re-fetches the row, exactly like an HTTP
// request can only ever touch its own tenant. Delivery attempts are appended to
// NotificationDeliveryLog, retries/backoff are BullMQ job attempts, and per-tenant sender
// configuration lives in NotificationProviderConfig (credentials encrypted at rest with the
// NOTIFICATION_SECRET_KEY cipher from @college-erp/notifications).
// ---------------------------------------------------------------------------

model Notification {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recipientUserId   String?               @map("recipient_user_id") @db.Uuid
  channel           NotificationChannel
  subject           String
  body              String
  /// Template this notification was rendered from, when applicable (system/direct sends may be null).
  templateId        String?               @map("template_id") @db.Uuid
  template          NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// Campaign this notification belongs to (a campaign fan-out creates one row per recipient).
  campaignId        String?               @map("campaign_id") @db.Uuid
  campaign          NotificationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  /// Variable values used at render time, for traceability/audit of what a recipient actually got.
  variables         Json?
  /// For scheduled one-off sends: the earliest time the delivery job may run (BullMQ delay).
  scheduledAt       DateTime?             @map("scheduled_at")
  status            NotificationStatus    @default(PENDING)
  error             String?
  /// Provider used for the most recent attempt (e.g. smtp, http, console, in_app).
  provider          String?
  /// Provider-reported message id from the most recent attempt.
  providerMessageId String?               @map("provider_message_id")
  attempts          Int                   @default(0)
  lastAttemptAt     DateTime?             @map("last_attempt_at")
  readAt            DateTime?             @map("read_at")
  sentAt            DateTime?             @map("sent_at")
  createdBy         String?               @map("created_by")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  deliveryLogs NotificationDeliveryLog[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, channel])
  @@index([tenantId, campaignId])
  @@index([recipientUserId])
  @@map("notifications")
}

model NotificationTemplate {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// Stable, referenceable identifier within a tenant (unique even across soft-deleted rows).
  code            String
  name            String
  description     String?
  channel         NotificationChannel
  /// Rendered with {{variable}} interpolation (see @college-erp/notifications renderTemplate).
  subjectTemplate String              @map("subject_template")
  bodyTemplate    String              @map("body_template")
  /// Declared variables: array of {key, description, required} — informational/human-readable.
  variables       Json?
  isActive        Boolean             @default(true) @map("is_active")
  createdBy       String?             @map("created_by")
  updatedBy       String?             @map("updated_by")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  deletedAt       DateTime?           @map("deleted_at")

  notifications Notification[]
  campaigns     NotificationCampaign[]
  eventTriggers NotificationEventTrigger[]

  @@unique([tenantId, code])
  @@index([tenantId, channel])
  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
  @@map("notification_templates")
}

model NotificationCampaign {
  id             String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String                     @map("tenant_id") @db.Uuid
  tenant         Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name           String
  description    String?
  templateId     String                     @map("template_id") @db.Uuid
  template       NotificationTemplate       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  status         NotificationCampaignStatus @default(DRAFT)
  /// The audience filter definition (see NotificationAudienceFilter in @college-erp/types) —
  /// resolved by @college-erp/notifications' resolveAudience at launch time.
  audienceFilter Json                       @map("audience_filter")
  /// Snapshot of the resolved recipient count once the campaign has been launched.
  audienceCount  Int?                       @map("audience_count")
  /// null = launch immediately when the API launches it; future = delayed BullMQ job.
  scheduledAt    DateTime?                  @map("scheduled_at")
  startedAt      DateTime?                  @map("started_at")
  completedAt    DateTime?                  @map("completed_at")
  canceledAt     DateTime?                  @map("canceled_at")
  createdBy      String?                    @map("created_by")
  updatedBy      String?                    @map("updated_by")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")
  deletedAt      DateTime?                  @map("deleted_at")

  notifications Notification[]

  @@index([tenantId, status])
  @@index([tenantId, templateId])
  @@index([tenantId, deletedAt])
  @@map("notification_campaigns")
}

/// Append-only per-attempt delivery record: one row per provider attempt per notification,
/// including provider name, payload/response snapshots, latency, and error. This is the delivery
/// log — retries show up here as successive attempts, so a notification that eventually SENT has
/// an auditable trail of everything the pipeline tried.
model NotificationDeliveryLog {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                     @map("tenant_id") @db.Uuid
  tenant            Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  notificationId    String                     @map("notification_id") @db.Uuid
  notification      Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  attempt           Int                        @default(1)
  channel           NotificationChannel
  provider          String
  status            NotificationDeliveryStatus
  providerMessageId String?                    @map("provider_message_id")
  /// Sanitized request snapshot (no credentials ever written here).
  request           Json?
  response          Json?
  error             String?
  latencyMs         Int?                       @map("latency_ms")
  createdAt         DateTime                   @default(now()) @map("created_at")

  @@index([tenantId, notificationId])
  @@index([tenantId, status])
  @@map("notification_delivery_logs")
}

/// Tenant-specific sender configuration. A channel only delivers when the tenant has an ACTIVE
/// config row whose provider the worker recognizes; the credentials are encrypted at rest
/// (AES-256-GCM, @college-erp/notifications NotificationSecretCipher) and never returned by the
/// API. One row may be flagged isDefault so the worker picks it without ambiguity.
model NotificationProviderConfig {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String              @map("tenant_id") @db.Uuid
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  channel              NotificationChannel
  provider             String
  name                 String?
  /// Non-secret settings (host/port/from/url/headers/body template …).
  config               Json?
  /// Encrypted JSON of the credential bag ({username,password} for SMTP, {token} for gateways).
  credentialsEncrypted String?             @map("credentials_encrypted")
  isActive             Boolean             @default(false) @map("is_active")
  isDefault            Boolean             @default(false) @map("is_default")
  createdBy            String?             @map("created_by")
  updatedBy            String?             @map("updated_by")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@unique([tenantId, channel, provider])
  @@index([tenantId, channel, isActive])
  @@map("notification_provider_configs")
}

/// Event-triggered notification mapping: when a domain module fires `triggerEvent(eventKey, …)`
/// the NotificationsService looks up every ACTIVE trigger for that eventKey and creates +
/// enqueues a notification per trigger's template. Event keys are free-form strings chosen by
/// the emitting module (e.g. `helpdesk.ticket.created`), never an enum, so a future module plugs
/// in with no schema change.
model NotificationEventTrigger {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String               @map("tenant_id") @db.Uuid
  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  eventKey   String               @map("event_key")
  templateId String               @map("template_id") @db.Uuid
  template   NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  isActive   Boolean              @default(true) @map("is_active")
  createdBy  String?              @map("created_by")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  @@unique([tenantId, eventKey, templateId])
  @@index([tenantId, eventKey])
  @@map("notification_event_triggers")
}

/// Per-user, per-channel opt-out: the worker suppresses delivery to a user who disabled a channel
/// (absent row = enabled by default).
model NotificationPreference {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@unique([tenantId, userId, channel])
  @@index([tenantId, userId])
  @@map("notification_preferences")
}

/// Registered push-capable devices per user (mobile app tokens). The worker sends PUSH-channel
/// notifications to every current device token of the recipient.
model UserPushDevice {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken String    @map("device_token")
  platform    String
  lastSeenAt  DateTime? @map("last_seen_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([tenantId, userId, deviceToken])
  @@index([tenantId, userId])
  @@map("user_push_devices")
}

// ---------------------------------------------------------------------------
// Documents (tenant-scoped file metadata â€” see apps/api's StorageService/
// DocumentsModule). The Document row is the LOGICAL document (title, type, lifecycle,
// verification, expiry, retention); every physical upload is a DocumentVersion row
// underneath it (versioning, virus scan, per-file metadata). storageKey always embeds
// the owning tenantId as a path prefix; StorageService refuses to sign a URL for a
// key outside the caller's tenant prefix regardless of what these tables say, so
// tenant isolation for file access is enforced twice: once by the tenant-scoped
// Prisma query that finds the row, once by the key-prefix check before signing.
// Download access is additionally gated by DocumentAccessGrant grants + document
// status, and every download is recorded in DocumentDownloadLog (+ the immutable
// PlatformAuditLog trail via AuditService).
// ---------------------------------------------------------------------------

/// Tenant-configurable catalog of document categories/types. Restricts what may be uploaded
/// for a type (MIME types, file extensions, max size), whether documents can expire, and the
/// retention period applied by the worker's document-retention sweep. Codes are unique per
/// tenant and soft-deletable (deletedAt) so historical documents keep resolving.
model DocumentType {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code              String
  name              String
  description       String?
  /// MIME types allowed for upload (JSON array of strings). Null = inherit the global allowlist.
  allowedMimeTypes  Json?     @map("allowed_mime_types")
  /// File extensions allowed for upload (JSON array of strings, no leading dot). Null = any.
  allowedExtensions Json?     @map("allowed_extensions")
  /// Per-file size cap in bytes. Null = inherit the global DOCUMENT_MAX_UPLOAD_SIZE_BYTES.
  maxSizeBytes      Int?      @map("max_size_bytes")
  /// Marks documents as sensitive — reviewers must verify; downloads are strictly audited.
  isSensitive       Boolean   @default(false) @map("is_sensitive")
  /// Whether documents of this type may be given an explicit expiresAt.
  canExpire         Boolean   @default(false) @map("can_expire")
  /// Retention period in days after upload: the retention sweep EXPIRES the document (and
  /// removes its storage objects) once this period elapses. Null = keep indefinitely.
  retentionDays     Int?      @map("retention_days")
  isActive          Boolean   @default(true) @map("is_active")
  createdBy         String?   @map("created_by")
  updatedBy         String?   @map("updated_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  documents Document[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("document_types")
}

model Document {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  documentTypeId   String?          @map("document_type_id") @db.Uuid
  documentType     DocumentType?    @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)
  title            String           @default("")
  description      String?
  /// Legacy free-form bucket used by the key builder / other modules (helpdesk attachments
  /// reference Document rows by id only — category stays for storage-key partitioning).
  category         String
  status           DocumentStatus   @default(PENDING_UPLOAD)
  /// Free-form structured metadata (issuer, document number, notes, custom fields).
  metadata         Json?
  tags             String[]         @default([])
  /// Current/latest physical file. Kept on the logical row so list views and legacy
  /// consumers (platform dashboard storage usage) don't need to join versions.
  currentVersionId String?          @map("current_version_id") @db.Uuid
  currentVersion   DocumentVersion? @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  /// Denormalized snapshot of the current version's file metadata (see currentVersionId).
  storageKey       String?          @unique @map("storage_key")
  originalFilename String?          @map("original_filename")
  mimeType         String?          @map("mime_type")
  sizeBytes        Int?             @map("size_bytes")
  /// Optional hard expiry (only settable when the document type allows expiry). The retention
  /// sweep (or an explicit expire action) flips the document to EXPIRED once this passes.
  expiresAt        DateTime?        @map("expires_at")
  expiredAt        DateTime?        @map("expired_at")
  verifiedBy       String?          @map("verified_by") @db.Uuid
  verifiedAt       DateTime?        @map("verified_at")
  verificationNote String?          @map("verification_note")
  rejectedBy       String?          @map("rejected_by") @db.Uuid
  rejectedAt       DateTime?        @map("rejected_at")
  rejectionReason  String?          @map("rejection_reason")
  uploadedBy       String?          @map("uploaded_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  versions     DocumentVersion[]     @relation("DocumentVersions")
  accessGrants DocumentAccessGrant[]
  downloadLogs DocumentDownloadLog[]

  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, documentTypeId])
  @@index([tenantId, status])
  @@map("documents")
}

/// One physical file upload of a logical Document. versionNumber is 1-based and unique per
/// document; confirming a new version marks every previous version REPLACED and sets the new
/// one as the document's currentVersion. Virus scanning runs per version (never per logical
/// document) so history is preserved alongside each scan outcome.
model DocumentVersion {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String             @map("tenant_id") @db.Uuid
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  documentId          String             @map("document_id") @db.Uuid
  document            Document           @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber       Int                @map("version_number")
  storageKey          String             @unique @map("storage_key")
  originalFilename    String             @map("original_filename")
  mimeType            String             @map("mime_type")
  sizeBytes           Int?               @map("size_bytes")
  /// Hex SHA-256 of the object bytes, computed server-side at confirm time.
  sha256              String?
  scanStatus          DocumentScanStatus @default(PENDING) @map("scan_status")
  /// The scanner that produced the scan result (e.g. clamav | mock | http).
  scanEngine          String?            @map("scan_engine")
  scanError           String?            @map("scan_error")
  scannedAt           DateTime?          @map("scanned_at")
  uploadedBy          String?            @map("uploaded_by") @db.Uuid
  confirmedAt         DateTime?          @map("confirmed_at")
  /// Id of the version that superseded this one (set when a newer version is confirmed).
  replacedByVersionId String?            @map("replaced_by_version_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  deletedAt           DateTime?          @map("deleted_at")

  documentCurrent Document[] @relation("CurrentDocumentVersion")

  @@unique([documentId, versionNumber])
  @@index([tenantId])
  @@index([documentId])
  @@map("document_versions")
}

/// Explicit per-document access grants: who may view and/or download a specific document.
/// A grant targets one tenant user (granteeUserId) OR one tenant role (granteeRoleId) — the
/// service enforces exactly one of the two. Absent any grant for the caller, access is denied
/// (documents are private by default; uploaders/sensitive types require grants to share).
model DocumentAccessGrant {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  documentId    String              @map("document_id") @db.Uuid
  document      Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  granteeType   DocumentGranteeType @default(USER) @map("grantee_type")
  granteeUserId String?             @map("grantee_user_id") @db.Uuid
  granteeRoleId String?             @map("grantee_role_id")
  canView       Boolean             @default(true) @map("can_view")
  canDownload   Boolean             @default(true) @map("can_download")
  grantedBy     String?             @map("granted_by") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at")

  @@unique([documentId, granteeType, granteeUserId, granteeRoleId])
  @@index([tenantId])
  @@index([documentId])
  @@index([granteeUserId])
  @@index([granteeRoleId])
  @@map("document_access_grants")
}

/// Download-history ledger: one row per signed download URL issuance. Complements the immutable
/// PlatformAuditLog trail with a queryable, per-document operational view (who downloaded which
/// version, when, from where). Both are written on every download.
model DocumentDownloadLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  documentId   String   @map("document_id") @db.Uuid
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionId    String?  @map("version_id") @db.Uuid
  downloadedBy String?  @map("downloaded_by") @db.Uuid
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, documentId])
  @@index([documentId, createdAt])
  @@map("document_download_logs")
}

// ---------------------------------------------------------------------------
// Workflow engine â€” a single, reusable, tenant-configurable state-machine +
// approval-chain engine. It knows nothing about admissions/fees/exams/etc.:
// each future business module attaches to it purely by starting a
// WorkflowInstance against its own entityType/entityId and a
// WorkflowDefinition the tenant configured for that entityType â€” approval
// chains are DATA (rows below), never a hardcoded per-module code path.
// Audit trail is NOT duplicated here â€” every lifecycle event (definition
// created/activated, instance started, task decided, transition fired,
// escalation, completion) is written through the existing centralized
// AuditService/PlatformAuditLog (module = 'workflows').
// ---------------------------------------------------------------------------

model WorkflowDefinition {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code        String
  name        String
  description String?
  /// Free-form string the future business module chooses (e.g. "FeeRefund", "LeaveRequest") â€”
  /// never an enum, so a new consumer never needs a schema change to plug into the engine.
  entityType  String    @map("entity_type")
  version     Int       @default(1)
  /// At most one ACTIVE definition per (tenantId, entityType) is enforced at the application
  /// layer (WorkflowDefinitionsService), not a DB constraint â€” Prisma has no partial unique index
  /// support (see this file's header "Known trade-off" note); activating a new version
  /// deactivates the previous one in the same transaction.
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  states      WorkflowState[]
  transitions WorkflowTransition[]
  instances   WorkflowInstance[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, entityType, isActive])
  @@map("workflow_definitions")
}

model WorkflowState {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                @map("tenant_id") @db.Uuid
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  definitionId       String                @map("definition_id") @db.Uuid
  definition         WorkflowDefinition    @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  code               String
  name               String
  category           WorkflowStateCategory @default(IN_PROGRESS)
  /// Whether a rejected instance sitting in this state can be resubmitted (see
  /// WorkflowEngineService.resubmit) rather than staying permanently terminal.
  allowsResubmission Boolean               @default(false) @map("allows_resubmission")
  sequenceOrder      Int                   @default(0) @map("sequence_order")
  createdAt          DateTime              @default(now()) @map("created_at")

  outgoingTransitions WorkflowTransition[] @relation("WorkflowTransitionFromState")
  incomingTransitions WorkflowTransition[] @relation("WorkflowTransitionToState")
  instancesCurrent    WorkflowInstance[]

  @@unique([definitionId, code])
  @@index([tenantId])
  @@map("workflow_states")
}

model WorkflowTransition {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String                   @map("tenant_id") @db.Uuid
  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  definitionId         String                   @map("definition_id") @db.Uuid
  definition           WorkflowDefinition       @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  code                 String
  name                 String
  fromStateId          String                   @map("from_state_id") @db.Uuid
  fromState            WorkflowState            @relation("WorkflowTransitionFromState", fields: [fromStateId], references: [id])
  toStateId            String                   @map("to_state_id") @db.Uuid
  toState              WorkflowState            @relation("WorkflowTransitionToState", fields: [toStateId], references: [id])
  action               WorkflowTransitionAction
  /// When more than one transition shares the same (fromState, action) â€” e.g. "auto-escalate to
  /// the Principal above â‚¹50,000, otherwise to the HOD" â€” conditions are evaluated in descending
  /// priority order and the first whose conditionExpression matches the instance's context wins.
  priority             Int                      @default(0)
  /// A tiny, safe JSON condition tree (see apps/api's condition-evaluator.ts) evaluated against
  /// WorkflowInstance.context â€” never a stored code string, so there is nothing here that could
  /// execute arbitrary logic. Null means "always eligible".
  conditionExpression  Json?                    @map("condition_expression")
  approvalMode         WorkflowApprovalMode     @default(NONE) @map("approval_mode")
  parallelRule         WorkflowParallelRule?    @map("parallel_rule")
  parallelQuorumCount  Int?                     @map("parallel_quorum_count")
  /// Hours after a task tied to this transition is created before it's considered overdue. Null
  /// means no deadline (never escalates).
  deadlineHours        Int?                     @map("deadline_hours")
  /// Role an overdue task escalates to â€” plain string, not a Role relation, because the target
  /// role is resolved by code within whichever tenant the instance belongs to at escalation time
  /// (same reason Permission-catalog references are strings elsewhere in this schema).
  escalationRoleCode   String?                  @map("escalation_role_code")
  escalationAfterHours Int?                     @map("escalation_after_hours")
  createdAt            DateTime                 @default(now()) @map("created_at")

  approvers WorkflowTransitionApprover[]
  tasks     WorkflowApprovalTask[]

  @@unique([definitionId, code])
  @@index([tenantId])
  @@index([fromStateId])
  @@map("workflow_transitions")
}

/// One "slot" an approval must pass through. Multiple rows sharing the same transitionId model
/// either a SEQUENTIAL chain (ordered by sequenceOrder â€” e.g. HOD then Accountant) or a PARALLEL
/// panel (all created together â€” e.g. any two of three Exam Board members). See
/// WorkflowApproverType for what a slot resolves to.
model WorkflowTransitionApprover {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  transitionId   String               @map("transition_id") @db.Uuid
  transition     WorkflowTransition   @relation(fields: [transitionId], references: [id], onDelete: Cascade)
  approverType   WorkflowApproverType @map("approver_type")
  /// Role.code within this tenant (when approverType = ROLE).
  roleCode       String?              @map("role_code")
  /// A specific tenant User.id (when approverType = SPECIFIC_USER).
  specificUserId String?              @map("specific_user_id") @db.Uuid
  /// Key to read out of WorkflowInstance.context and match against the resolved user's UserRole
  /// scope columns (e.g. "departmentId" -> scopeDepartmentId) â€” reuses the hierarchical RBAC
  /// scope system verbatim rather than inventing a parallel one. Null means GLOBAL-only holders
  /// of the role are eligible.
  scopeField     String?              @map("scope_field")
  sequenceOrder  Int                  @default(0) @map("sequence_order")
  createdAt      DateTime             @default(now()) @map("created_at")

  tasks WorkflowApprovalTask[]

  @@index([tenantId])
  @@index([transitionId])
  @@map("workflow_transition_approvers")
}

model WorkflowInstance {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  definitionId   String                 @map("definition_id") @db.Uuid
  definition     WorkflowDefinition     @relation(fields: [definitionId], references: [id])
  entityType     String                 @map("entity_type")
  entityId       String                 @map("entity_id")
  currentStateId String                 @map("current_state_id") @db.Uuid
  currentState   WorkflowState          @relation(fields: [currentStateId], references: [id])
  status         WorkflowInstanceStatus @default(IN_PROGRESS)
  /// Arbitrary snapshot the starting module provides (e.g. { amount, departmentId }) â€” the only
  /// thing condition evaluation and approver-scope resolution ever look at. Updated on
  /// resubmission with whatever the resubmitter provides.
  context        Json?
  startedBy      String?                @map("started_by") @db.Uuid
  startedAt      DateTime               @default(now()) @map("started_at")
  completedAt    DateTime?              @map("completed_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  tasks WorkflowApprovalTask[]

  /// One workflow instance per business record, forever â€” a resubmission reopens THIS instance
  /// (see WorkflowEngineService.resubmit) rather than spawning a duplicate.
  @@unique([tenantId, entityType, entityId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([definitionId])
  @@map("workflow_instances")
}

model WorkflowApprovalTask {
  id                  String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String                      @map("tenant_id") @db.Uuid
  tenant              Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  instanceId          String                      @map("instance_id") @db.Uuid
  instance            WorkflowInstance            @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  transitionId        String                      @map("transition_id") @db.Uuid
  transition          WorkflowTransition          @relation(fields: [transitionId], references: [id])
  approverSlotId      String?                     @map("approver_slot_id") @db.Uuid
  approverSlot        WorkflowTransitionApprover? @relation(fields: [approverSlotId], references: [id])
  /// Populated at creation for SPECIFIC_USER slots; for ROLE slots stays null until the decision
  /// is made (any matching role/scope holder may decide a pending ROLE task â€” see
  /// WorkflowApproverResolutionService), then records who actually acted.
  assignedUserId      String?                     @map("assigned_user_id") @db.Uuid
  status              WorkflowTaskStatus          @default(PENDING)
  sequenceOrder       Int                         @default(0) @map("sequence_order")
  dueAt               DateTime?                   @map("due_at")
  decidedByUserId     String?                     @map("decided_by_user_id") @db.Uuid
  decidedAt           DateTime?                   @map("decided_at")
  comment             String?
  escalatedAt         DateTime?                   @map("escalated_at")
  /// Set by the escalation sweep (apps/worker) alongside escalatedAt â€” widens who may decide
  /// this task to ALSO include holders of this role, without revoking the original approver's
  /// ability to (status stays PENDING; escalation adds an eligible decider, it doesn't replace
  /// one). No approverSlot row exists for this widened eligibility since it isn't part of the
  /// definition's configured chain â€” it's a runtime SLA response.
  escalatedToRoleCode String?                     @map("escalated_to_role_code")
  createdAt           DateTime                    @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([instanceId])
  @@index([status, dueAt])
  @@index([assignedUserId, status])
  @@map("workflow_approval_tasks")
}

// ---------------------------------------------------------------------------
// Student 360 models (see the header block above for the design notes).
// ---------------------------------------------------------------------------

/// Core identity + profile row for Student 360. fullName is denormalized from
/// first/middle/last names by the students module service (kept denormalized so lists,
/// exports, print-outs, and the timeline don't re-join three columns every time). A student
/// can later link to a User portal account via userId (OWN-scope self-service), but the
/// record exists independently of the login account.
model Student {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String        @map("tenant_id") @db.Uuid
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  campusId              String        @map("campus_id") @db.Uuid
  campus                Campus        @relation(fields: [campusId], references: [id], onDelete: Restrict)
  userId                String?       @map("user_id") @db.Uuid
  admissionNumber       String        @map("admission_number")
  rollNumber            String?       @map("roll_number")
  registrationNumber    String?       @map("registration_number")
  firstName             String        @map("first_name")
  middleName            String?       @map("middle_name")
  lastName              String        @map("last_name")
  fullName              String        @map("full_name")
  gender                StudentGender @default(NOT_SPECIFIED)
  bloodGroup            BloodGroup    @default(UNKNOWN) @map("blood_group")
  dateOfBirth           DateTime?     @map("date_of_birth")
  nationality           String?       @default("Indian")
  category              String?
  /// Current contact information â€” quick access on the profile/cards. Full communication
  /// history lives in StudentCommunication; guardians live in Guardian.
  email                 String?
  alternateEmail        String?       @map("alternate_email")
  primaryPhone          String?       @map("primary_phone")
  alternatePhone        String?       @map("alternate_phone")
  currentAddressLine1   String?       @map("current_address_line_1")
  currentAddressLine2   String?       @map("current_address_line_2")
  city                  String?
  state                 String?
  postalCode            String?       @map("postal_code")
  country               String?       @default("India")
  permanentAddressLine1 String?       @map("permanent_address_line_1")
  permanentAddressLine2 String?       @map("permanent_address_line_2")
  permanentCity         String?       @map("permanent_city")
  permanentState        String?       @map("permanent_state")
  permanentPostalCode   String?       @map("permanent_postal_code")
  permanentCountry      String?       @default("India") @map("permanent_country")
  profilePhotoKey       String?       @map("profile_photo_key")
  status                StudentStatus @default(APPLICANT)
  /// Current placement snapshot â€” an at-a-glance "where is this student now". The full,
  /// year-by-year picture lives in StudentEnrollment.
  programId             String?       @map("program_id") @db.Uuid
  program               Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  batchId               String?       @map("batch_id") @db.Uuid
  batch                 Batch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)
  sectionId             String?       @map("section_id") @db.Uuid
  section               Section?      @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  academicYearId        String?       @map("academic_year_id") @db.Uuid
  academicYear          AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  admittedOn            DateTime?     @map("admitted_on")
  yearOfAdmission       Int?          @map("year_of_admission")
  createdBy             String?       @map("created_by")
  updatedBy             String?       @map("updated_by")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  /// Soft delete: unlike master data, a student's timeline/history is what other rows point
  /// at, so hard-deleting would orphan it. Archiving (deletedAt) is the removal path; status
  /// transitions are the "state" path.
  deletedAt             DateTime?     @map("deleted_at")

  guardians             Guardian[]
  documents             StudentDocument[]
  admissions            StudentAdmission[]
  academicRecords       StudentAcademicRecord[]
  enrollments           StudentEnrollment[]
  attendance            StudentAttendance[]
  fees                  StudentFee[]
  payments              StudentPayment[]
  feeAssignments        StudentFeeAssignment[]        @relation("StudentFeeAssignments")
  feeDemands            FeeDemand[]                   @relation("StudentDemands")
  concessions           FeeConcession[]               @relation("StudentConcessions")
  refunds               FeeRefund[]                   @relation("StudentRefunds")
  exams                 StudentExam[]
  results               StudentResult[]
  certificates          StudentCertificate[]
  libraryLoans          StudentLibraryLoan[]
  libraryMembers        LibraryMember[]
  hostelBookings        StudentHostelBooking[]
  hostelComplaints      HostelComplaint[]
  hostelVisitors        HostelVisitor[]
  transportPasses       StudentTransportPass[]
  holds                 StudentHold[]
  statusHistory         StudentStatusHistory[]
  communications        StudentCommunication[]
  activities            StudentActivity[]
  admissionApplications AdmissionApplication[]
  courseRegistrations   CourseRegistration[]
  advisingRecords       AcademicAdvisingRecord[]
  progressionRecords    AcademicProgressionRecord[]
  backlogs              CourseBacklog[]
  attendanceCorrections AttendanceCorrectionRequest[] @relation("AttendanceCorrectionStudents")
  deviceMappings        AttendanceDeviceUser[]        @relation("StudentDeviceMappings")
  deviceLogs            AttendanceDeviceLog[]         @relation("StudentDeviceLogs")
  examRegistrations     ExamRegistration[]
  examSeatAllocations   ExamSeatAllocation[]
  examMarksEntries      ExamMarksEntry[]
  examComponentMarks    ExamComponentMark[]
  resultCalculations    ResultCalculation[]
  resultProcesses       ResultProcess[]
  resultHistory         ResultHistory[]
  placementResumes      PlacementResume[]
  placementEligibility  PlacementEligibility[]
  placementApplications PlacementApplication[]
  placementSelections   PlacementSelection[]
  placementOffers       PlacementOffer[]
  placementOutcomes     PlacementOutcome[]

  @@unique([tenantId, admissionNumber])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([campusId])
  @@index([programId])
  @@index([batchId])
  @@index([sectionId])
  @@index([tenantId, status])
  @@map("students")
}

/// A student's guardian / family contact / emergency contact. The kind/role taxonomy is an
/// enum because these are well-bounded product concepts; everything else (occupation,
/// address) is free text.
model Guardian {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId          String       @map("student_id") @db.Uuid
  student            Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name               String
  kind               GuardianKind
  role               GuardianRole @default(PRIMARY)
  phone              String?
  email              String?
  occupation         String?
  monthlyIncomeCents Int?         @map("monthly_income_cents")
  address            String?
  createdBy          String?      @map("created_by")
  updatedBy          String?      @map("updated_by")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([studentId])
  @@map("guardians")
}

/// Scanned/uploaded student documents (marksheets, ID proof, photos, certificates). Storage
/// key follows the same tenant-prefixed convention as the control-plane Document model;
/// verification is an explicit first-class step so the records office can vet each file.
model StudentDocument {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                @map("tenant_id") @db.Uuid
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId        String                @map("student_id") @db.Uuid
  student          Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// e.g. ID_PROOF / ACADEMIC / ADDRESS_PROOF / PHOTO / OTHER â€” free-form so the tenant's
  /// admissions document checklist (TenantConfiguration) drives what categories exist.
  category         String
  documentName     String                @map("document_name")
  storageKey       String?               @map("storage_key")
  originalFilename String?               @map("original_filename")
  mimeType         String?               @map("mime_type")
  sizeBytes        Int?                  @map("size_bytes")
  status           StudentDocumentStatus @default(PENDING)
  verifiedAt       DateTime?             @map("verified_at")
  verifiedBy       String?               @map("verified_by") @db.Uuid
  remarks          String?
  uploadedBy       String?               @map("uploaded_by") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([studentId])
  @@index([tenantId, status])
  @@map("student_documents")
}

/// Admission history â€” every admission/application round this student went through (can be
/// more than one: applied, got an offer, deferred, re-admitted). mode is a free-form string
/// (MERIT / MANAGEMENT / LATERAL / DIRECT) so tenant policies don't require a schema change.
model StudentAdmission {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId         String          @map("student_id") @db.Uuid
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  applicationNumber String          @map("application_number")
  programId         String          @map("program_id") @db.Uuid
  program           Program         @relation(fields: [programId], references: [id], onDelete: Restrict)
  academicYearId    String?         @map("academic_year_id") @db.Uuid
  academicYear      AcademicYear?   @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  appliedAt         DateTime        @map("applied_at")
  status            AdmissionStatus @default(APPLIED)
  mode              String?
  offerLetterKey    String?         @map("offer_letter_key")
  admissionFeeCents Int?            @map("admission_fee_cents")
  remarks           String?
  createdBy         String?         @map("created_by")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@unique([tenantId, applicationNumber])
  @@index([tenantId])
  @@index([studentId])
  @@index([programId])
  @@map("student_admissions")
}

/// Academic (prior-education) history â€” institutions/certificates the student earned before
/// (or alongside) the current program: higher-secondary board marksheet, prior degree, etc.
model StudentAcademicRecord {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String                @map("tenant_id") @db.Uuid
  tenant                 Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId              String                @map("student_id") @db.Uuid
  student                Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  institution            String
  board                  String?
  degree                 String?
  yearOfPassing          Int?                  @map("year_of_passing")
  percentage             Float?
  gpa                    Float?
  grade                  String?
  marksObtained          Int?                  @map("marks_obtained")
  marksOutOf             Int?                  @map("marks_out_of")
  rank                   String?
  isHighestQualification Boolean               @default(false) @map("is_highest_qualification")
  verificationStatus     StudentDocumentStatus @default(PENDING) @map("verification_status")
  remarks                String?
  createdBy              String?               @map("created_by")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([studentId])
  @@map("student_academic_records")
}

/// Enrollment history â€” one row per academic year the student was enrolled in a program
/// (with the section/batch they sat in that year). This is the "which cohort, which year"
/// picture; the admission record captures the application side.
model StudentEnrollment {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId      String           @map("student_id") @db.Uuid
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId String           @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  termId         String?          @map("term_id") @db.Uuid
  term           Term?            @relation(fields: [termId], references: [id], onDelete: SetNull)
  programId      String           @map("program_id") @db.Uuid
  program        Program          @relation(fields: [programId], references: [id], onDelete: Restrict)
  sectionId      String?          @map("section_id") @db.Uuid
  section        Section?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  batchId        String?          @map("batch_id") @db.Uuid
  batch          Batch?           @relation(fields: [batchId], references: [id], onDelete: SetNull)
  rollNumber     String?          @map("roll_number")
  semester       Int?
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime?        @map("enrolled_at")
  completedAt    DateTime?        @map("completed_at")
  remarks        String?
  createdBy      String?          @map("created_by")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([tenantId, studentId, academicYearId, programId])
  @@index([tenantId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([tenantId, status])
  @@map("student_enrollments")
}

/// Per-student attendance ledger day/class records. attendanceType is free-form (CLASS / DAY /
/// PERIOD) so the timetable module's shape can drive it without a migration. When the record is
/// written from an AttendanceSession, sessionId links it back to that session (unique per
/// student+session so bulk marking upserts cleanly); markMethod records the capture channel
/// (MANUAL / QR / BIOMETRIC) surfaced from the attendance entitlements.
model StudentAttendance {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId      String             @map("student_id") @db.Uuid
  student        Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId      String?            @map("session_id") @db.Uuid
  session        AttendanceSession? @relation("SessionAttendanceRecords", fields: [sessionId], references: [id], onDelete: SetNull)
  date           DateTime           @map("date")
  attendanceType String             @default("CLASS") @map("attendance_type")
  termId         String?            @map("term_id") @db.Uuid
  term           Term?              @relation(fields: [termId], references: [id], onDelete: SetNull)
  subjectCode    String?            @map("subject_code")
  subjectName    String?            @map("subject_name")
  status         AttendanceStatus   @default(PRESENT)
  markMethod     String             @default("MANUAL") @map("mark_method")
  signInAt       DateTime?          @map("sign_in_at")
  markedByUserId String?            @map("marked_by_user_id") @db.Uuid
  remarks        String?
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@unique([tenantId, sessionId, studentId])
  @@index([tenantId])
  @@index([studentId])
  @@index([studentId, date])
  @@index([tenantId, status])
  @@index([tenantId, sessionId])
  @@map("student_attendance")
}

/// A single held attendance session â€” one class/day/period to be marked for a roster. Anchors
/// on the term/courseOffering/section (any combination) plus a date and optional time window,
/// and may snapshot the timetable entry it was raised from. Lifecycle OPEN â†’ CLOSED (explicit);
/// CLOSED sessions with records are the "classes held" denominator for percentage/shortage
/// reporting.
model AttendanceSession {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                  @map("tenant_id") @db.Uuid
  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  termId           String?                 @map("term_id") @db.Uuid
  term             Term?                   @relation("TermAttendanceSessions", fields: [termId], references: [id], onDelete: SetNull)
  courseOfferingId String?                 @map("course_offering_id") @db.Uuid
  courseOffering   CourseOffering?         @relation("OfferingAttendanceSessions", fields: [courseOfferingId], references: [id], onDelete: SetNull)
  sectionId        String?                 @map("section_id") @db.Uuid
  section          Section?                @relation("SectionAttendanceSessions", fields: [sectionId], references: [id], onDelete: SetNull)
  timetableEntryId String?                 @map("timetable_entry_id") @db.Uuid
  timetableEntry   TimetableEntry?         @relation("EntryAttendanceSessions", fields: [timetableEntryId], references: [id], onDelete: SetNull)
  date             DateTime                @map("date")
  startTime        String?                 @map("start_time")
  endTime          String?                 @map("end_time")
  attendanceType   String                  @default("CLASS") @map("attendance_type")
  subjectCode      String?                 @map("subject_code")
  subjectName      String?                 @map("subject_name")
  title            String?
  notes            String?
  status           AttendanceSessionStatus @default(OPEN)
  markedByUserId   String?                 @map("marked_by_user_id") @db.Uuid
  createdBy        String?                 @map("created_by")
  updatedBy        String?                 @map("updated_by")
  openedAt         DateTime                @default(now()) @map("opened_at")
  closedAt         DateTime?               @map("closed_at")
  closedById       String?                 @map("closed_by_id") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  deletedAt        DateTime?               @map("deleted_at")

  records      StudentAttendance[]           @relation("SessionAttendanceRecords")
  corrections  AttendanceCorrectionRequest[] @relation("SessionAttendanceCorrections")
  facultyMarks FacultyAttendance[]           @relation("SessionFacultyAttendance")
  deviceLogs   AttendanceDeviceLog[]         @relation("SessionDeviceLogs")

  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, termId])
  @@index([tenantId, courseOfferingId])
  @@index([tenantId, sectionId, date])
  @@index([tenantId, status])
  @@index([tenantId, timetableEntryId])
  @@index([tenantId, deletedAt])
  @@map("attendance_sessions")
}

/// A student (or, with manage permission, any actor) requests a status correction on an
/// attendance record. APPROVED applies the change to the underlying StudentAttendance row
/// inside the same transaction; the request itself is the immutable audit trail.
model AttendanceCorrectionRequest {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                     @map("tenant_id") @db.Uuid
  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId          String                     @map("student_id") @db.Uuid
  student            Student                    @relation("AttendanceCorrectionStudents", fields: [studentId], references: [id], onDelete: Cascade)
  sessionId          String?                    @map("session_id") @db.Uuid
  session            AttendanceSession?         @relation("SessionAttendanceCorrections", fields: [sessionId], references: [id], onDelete: SetNull)
  attendanceRecordId String?                    @map("attendance_record_id") @db.Uuid
  fromStatus         AttendanceStatus           @map("from_status")
  toStatus           AttendanceStatus           @map("to_status")
  reason             String
  remarks            String?
  status             AttendanceCorrectionStatus @default(PENDING)
  requestedBy        User?                      @relation("AttendanceCorrectionRequesters", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  requestedByUserId  String?                    @map("requested_by_user_id") @db.Uuid
  decidedBy          User?                      @relation("AttendanceCorrectionDeciders", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedByUserId    String?                    @map("decided_by_user_id") @db.Uuid
  decidedAt          DateTime?                  @map("decided_at")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, studentId])
  @@index([tenantId, sessionId])
  @@map("attendance_correction_requests")
}

/// Faculty/staff attendance â€” one row per user per day with optional check-in/out times. status
/// reuses AttendanceStatus so the taxonomy stays a single enum; sessionId links the mark to a
/// marked attendance session when captured that way.
model FacultyAttendance {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId         String             @map("user_id") @db.Uuid
  user           User               @relation("FacultyAttendanceLogs", fields: [userId], references: [id], onDelete: Restrict)
  date           DateTime           @map("date")
  checkInAt      DateTime?          @map("check_in_at")
  checkOutAt     DateTime?          @map("check_out_at")
  status         AttendanceStatus   @default(PRESENT)
  sessionId      String?            @map("session_id") @db.Uuid
  session        AttendanceSession? @relation("SessionFacultyAttendance", fields: [sessionId], references: [id], onDelete: SetNull)
  markMethod     String             @default("MANUAL") @map("mark_method")
  remarks        String?
  markedByUserId String?            @map("marked_by_user_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@unique([tenantId, userId, date])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, date])
  @@map("faculty_attendance")
}

/// A registered attendance capture device (QR kiosk, biometric/RFID reader, mobile app, or an
/// HTTP/API gateway). The model is deliberately VENDOR-NEUTRAL: vendor, model and protocol are
/// free-form strings and every vendor talks to the ERP through the same normalized event
/// pipeline (AttendanceDeviceLog). Specific vendor wire-protocols slot in as registered adapters
/// (see attendance-devices service / device-adapters) keyed by protocol+vendor â€” the ERP never
/// depends on a specific biometric vendor. Secrets (device push token, vendor comm key) are kept
/// AES-256-GCM encrypted at rest (DEVICE_SECRET_KEY), mirroring the mfa secret cipher pattern.
model AttendanceDevice {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code               String
  name               String
  /// Capture channel: QR | BIOMETRIC | RFID | MOBILE | API. Drives which granular entitlement
  /// (attendance.qr / attendance.biometric / attendance.basic) the device needs to be usable.
  deviceType         String    @map("device_type")
  /// Vendor identifier (e.g. 'ZKTeco', 'BioMetricAttend', 'Generic'). Free-form on purpose so a
  /// new vendor never needs a schema change â€” only a registered adapter.
  vendor             String    @default("Generic")
  model              String?
  /// Wire protocol for pulling/pushing events: HTTP_PULL (server polls an URL), HTTP_PUSH
  /// (device posts into the ingest endpoint, HMAC-signed), TCP, MQTT (adapters), MANUAL.
  protocol           String    @default("HTTP_PUSH")
  ipAddress          String?   @map("ip_address")
  port               Int?
  endpointUrl        String?   @map("endpoint_url")
  serialNumber       String?   @map("serial_number")
  location           String?
  roomId             String?   @map("room_id") @db.Uuid
  room               Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  /// Encrypted device-side push token (HMAC secret for the ingest endpoint / HTTP auth).
  authTokenEncrypted String?   @map("auth_token_encrypted")
  /// Encrypted vendor-to-device communication key (e.g. ZKTeco comm key) for PULL adapters.
  commKeyEncrypted   String?   @map("comm_key_encrypted")
  status             String    @default("ACTIVE")
  lastSeenAt         DateTime? @map("last_seen_at")
  lastSyncAt         DateTime? @map("last_sync_at")
  lastSyncStatus     String?   @map("last_sync_status")
  lastSyncMessage    String?   @map("last_sync_message")
  createdBy          String?   @map("created_by")
  updatedBy          String?   @map("updated_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  mappings AttendanceDeviceUser[] @relation("DeviceMappings")
  logs     AttendanceDeviceLog[]  @relation("DeviceLogs")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, deviceType])
  @@index([tenantId, deletedAt])
  @@map("attendance_devices")
}

/// Mapping between a device-side person identifier (fingerprint template id, RFID/card number,
/// mobile registration id) and an ERP person â€” a Student or a User (staff/faculty). Kept per
/// device so the same external id can mean different people on different devices.
model AttendanceDeviceUser {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  deviceId         String           @map("device_id") @db.Uuid
  device           AttendanceDevice @relation("DeviceMappings", fields: [deviceId], references: [id], onDelete: Cascade)
  externalPersonId String           @map("external_person_id")
  mappedType       String           @map("mapped_type")
  studentId        String?          @map("student_id") @db.Uuid
  student          Student?         @relation("StudentDeviceMappings", fields: [studentId], references: [id], onDelete: SetNull)
  userId           String?          @map("user_id") @db.Uuid
  user             User?            @relation("UserDeviceMappings", fields: [userId], references: [id], onDelete: SetNull)
  label            String?
  isActive         Boolean          @default(true) @map("is_active")
  createdBy        String?          @map("created_by")
  updatedBy        String?          @map("updated_by")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@unique([tenantId, deviceId, externalPersonId])
  @@unique([tenantId, deviceId, studentId])
  @@unique([tenantId, deviceId, userId])
  @@index([tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, userId])
  @@map("attendance_device_users")
}

/// Raw normalized event received from an attendance device â€” the single ingest+reconciliation
/// pipeline for QR / biometric / RFID / API integrations. Every incoming event becomes exactly
/// one row here (unique dedupeKey enforced at the DB), then the processor resolves the device
/// person mapping and applies the mark to the matching open attendance session (student) or
/// daily faculty log (staff) â€” or marks the event UNMAPPED/REJECTED for reconciliation.
model AttendanceDeviceLog {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  deviceId         String             @map("device_id") @db.Uuid
  device           AttendanceDevice   @relation("DeviceLogs", fields: [deviceId], references: [id], onDelete: Cascade)
  eventType        String             @map("event_type")
  externalPersonId String?            @map("external_person_id")
  studentId        String?            @map("student_id") @db.Uuid
  student          Student?           @relation("StudentDeviceLogs", fields: [studentId], references: [id], onDelete: SetNull)
  userId           String?            @map("user_id") @db.Uuid
  user             User?              @relation("UserDeviceLogs", fields: [userId], references: [id], onDelete: SetNull)
  capturedAt       DateTime           @map("captured_at")
  receivedAt       DateTime           @default(now()) @map("received_at")
  ingestSource     String             @default("API") @map("ingest_source")
  /// Deterministic identity hash (deviceId|externalPersonId|eventType|capturedAt) â€” the DB-level
  /// unique index on (tenantId, dedupeKey) is the hard duplicate-prevention boundary.
  dedupeKey        String?            @map("dedupe_key")
  rawPayload       Json               @map("raw_payload")
  status           String             @default("QUEUED")
  processingNote   String?            @map("processing_note")
  sessionId        String?            @map("session_id") @db.Uuid
  session          AttendanceSession? @relation("SessionDeviceLogs", fields: [sessionId], references: [id], onDelete: SetNull)
  /// Points at the applied StudentAttendance or FacultyAttendance row id (opaque).
  appliedRecordId  String?            @map("applied_record_id")
  processedAt      DateTime?          @map("processed_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@unique([tenantId, dedupeKey])
  @@index([tenantId])
  @@index([tenantId, deviceId])
  @@index([tenantId, status])
  @@index([tenantId, capturedAt])
  @@index([tenantId, sessionId])
  @@map("attendance_device_logs")
}

/// A fee demand line on a student's ledger. status is recomputed by the students module on
/// every create/update/payment from amountCents vs paidCents+waivedCents; OVERDUE is derived
/// at read time when dueDate has passed and the line isn't yet PAID.
///
/// When issued through the fees module (FeeStructure â†’ StudentFeeAssignment â†’ FeeDemand) each
/// line carries its originating structure/line/demand and installment index so the demand's
/// totals and late-fee accrual can be reconciled back to the catalog that produced them.
model StudentFee {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String                @map("tenant_id") @db.Uuid
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId            String                @map("student_id") @db.Uuid
  student              Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId               String?               @map("term_id") @db.Uuid
  term                 Term?                 @relation(fields: [termId], references: [id], onDelete: SetNull)
  structureId          String?               @map("structure_id") @db.Uuid
  structure            FeeStructure?         @relation("FeeStructureGeneratedFees", fields: [structureId], references: [id], onDelete: SetNull)
  structureLineId      String?               @map("structure_line_id") @db.Uuid
  structureLine        FeeStructureLine?     @relation("FeeStructureLineGeneratedFees", fields: [structureLineId], references: [id], onDelete: SetNull)
  demandId             String?               @map("demand_id") @db.Uuid
  demand               FeeDemand?            @relation(fields: [demandId], references: [id], onDelete: SetNull)
  installmentIndex     Int                   @default(0) @map("installment_index")
  /// When this fee line was created as a hostel rent charge it points back at the hostel
  /// booking that produced it (see the hostel module) so the hostel ledger can list/report a
  /// student's hostel dues without re-deriving them from fee history heuristics. Null for
  /// academic/structure-generated fees.
  hostelBookingId      String?               @map("hostel_booking_id") @db.Uuid
  hostelBooking        StudentHostelBooking? @relation(fields: [hostelBookingId], references: [id], onDelete: SetNull)
  /// Transport-passes fee line created by the transport module points back at the pass that
  /// produced it (see the transport module), the same way hostelBookingId does for hostel rent
  /// charges — so the transport ledger can report a student's transport dues directly. Null for
  /// academic/structure-generated fees.
  transportPassId      String?               @map("transport_pass_id") @db.Uuid
  transportPass        StudentTransportPass? @relation(fields: [transportPassId], references: [id], onDelete: SetNull)
  headCode             String                @map("head_code")
  headName             String                @map("head_name")
  amountCents          Int                   @map("amount_cents")
  paidCents            Int                   @default(0) @map("paid_cents")
  waivedCents          Int                   @default(0) @map("waived_cents")
  /// Accumulated late-fee charged on this line (flat/percent from the structure's rules).
  lateFeeCents         Int                   @default(0) @map("late_fee_cents")
  lastLateFeeAccruedAt DateTime?             @map("last_late_fee_accrued_at")
  status               FeeStatus             @default(ISSUED)
  dueDate              DateTime?             @map("due_date")
  remarks              String?
  createdBy            String?               @map("created_by")
  updatedBy            String?               @map("updated_by")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  payments    StudentPayment[]
  concessions FeeConcession[]
  allocations StudentFeeAllocation[]

  @@index([tenantId])
  @@index([studentId])
  @@index([tenantId, status])
  @@index([studentId, status])
  @@index([tenantId, demandId])
  @@index([tenantId, structureId])
  @@map("student_fees")
}

/// Payments recorded against a student's fee ledger. reuses the global PaymentMethod and
/// PaymentStatus enums rather than inventing a parallel taxonomy; recordedByUserId is the
/// tenant staff member who logged the receipt.
model StudentPayment {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId        String        @map("student_id") @db.Uuid
  student          Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentFeeId     String?       @map("student_fee_id") @db.Uuid
  studentFee       StudentFee?   @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  receiptNumber    String        @map("receipt_number")
  amountCents      Int           @map("amount_cents")
  currency         String        @default("INR")
  paymentDate      DateTime      @map("payment_date")
  method           PaymentMethod
  status           PaymentStatus @default(SUCCEEDED)
  referenceNumber  String?       @map("reference_number")
  /// Caller-supplied dedupe token (e.g. gateway transaction id, bank UTR): replaying a payment
  /// with the same key returns the original row instead of double-charging the ledger.
  idempotencyKey   String?       @map("idempotency_key")
  recordedByUserId String?       @map("recorded_by_user_id") @db.Uuid
  remarks          String?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  refunds     FeeRefund[]            @relation("PaymentRefunds")
  allocations StudentFeeAllocation[]

  @@unique([tenantId, receiptNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([studentId])
  @@index([studentFeeId])
  @@map("student_payments")
}

/// One inbound payment's allocation to a single StudentFee line. A payment may be split across
/// any number of lines (greedy oldest-due-first); each allocation reduces only that line's
/// paidCents, so the ledger reconciles back to the exact paise per fee item. Written in the same
/// transaction as its StudentPayment and drives the demand/line status recompute.
model StudentFeeAllocation {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  paymentId    String         @map("payment_id") @db.Uuid
  payment      StudentPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  studentFeeId String         @map("student_fee_id") @db.Uuid
  line         StudentFee     @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  amountCents  Int            @map("amount_cents")
  createdAt    DateTime       @default(now()) @map("created_at")

  @@unique([paymentId, studentFeeId])
  @@index([tenantId])
  @@index([tenantId, studentFeeId])
  @@index([tenantId, paymentId])
  @@map("student_fee_allocations")
}

// ---------------------------------------------------------------------------
// Exams (Phase 7) â€” a complete examination surface built on the Organization/Academics and
// Student 360 foundations:
//
//   ExamSession             â†’ one examination cycle for a program/term (reuses ExamType; a
//                             SUPPLEMENTARY session links back to the failed base session).
//   ExamSubject             â†’ one paper within a session, anchored on the academics Course
//                             catalog with its own marks/duration/date/time + default room.
//   ExamEligibilityRule     â†’ data-driven eligibility knobs evaluated against student data.
//   ExamRegistration        â†’ a student registered to sit a session (auto-eligible via rules).
//   ExamHallTicket          â†’ one admit card per registration with per-subject line-item
//                             snapshots (ExamHallTicketSubject copies code/name/marks/venue/seat
//                             at print time so the issued ticket is immutable).
//   ExamSeatingPlan         â†’ a room + label for a subject; ExamSeatAllocation assigns each
//                             registration a seat (ALLOCATED â†’ PRESENT/ABSENT gate for marks).
//   ExamInvigilatorAssignment â†’ user + role + optional room for a subject paper.
//   ExamMarksEntry          â†’ per-registration per-subject marks with DRAFT â†’ SUBMITTED â†’
//                             MODERATED â†’ APPROVED workflow and grace marks.
//   ExamRevaluationRequest  â†’ request â†’ UNDER_REVIEW â†’ RESOLVED/REJECTED; RESOLVED may revise
//                             marks which flow back to the marks entry + published result.
//
// Results are NOT stored twice: publishing a COMPLETED session syncs the APPROVED marks into the
// student-360 StudentExam/StudentResult tables (StudentExam gained a nullable sessionId link so
// the sync is idempotent and the student profile shows these exams unchanged). All rows are
// tenant-scoped (auto-isolated by TenantScopedPrismaService) and sensitive transitions are
// audit-logged via the exams module tag.
// ---------------------------------------------------------------------------

/// One examination cycle for a program/term (e.g. "End-Term November 2026, B.Tech CSE").
/// The session is the unit of scheduling, registration, seating, marks, and result publication.
model ExamSession {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String            @map("tenant_id") @db.Uuid
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name                  String
  code                  String
  programId             String            @map("program_id") @db.Uuid
  program               Program           @relation(fields: [programId], references: [id], onDelete: Restrict)
  academicYearId        String            @map("academic_year_id") @db.Uuid
  academicYear          AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  termId                String?           @map("term_id") @db.Uuid
  term                  Term?             @relation(fields: [termId], references: [id], onDelete: SetNull)
  examType              ExamType          @map("exam_type")
  /// True for SUPPLEMENTARY/reappearance sessions; baseSessionId points at the session the
  /// student originally failed, when one exists.
  isSupplementary       Boolean           @default(false) @map("is_supplementary")
  baseSessionId         String?           @map("base_session_id") @db.Uuid
  baseSession           ExamSession?      @relation("ExamSessionChain", fields: [baseSessionId], references: [id], onDelete: SetNull)
  status                ExamSessionStatus @default(DRAFT)
  startDate             DateTime?         @map("start_date")
  endDate               DateTime?         @map("end_date")
  resultDeclarationDate DateTime?         @map("result_declaration_date")
  /// Free-form, human-readable eligibility policy note (the machine-checked rules live in
  /// ExamEligibilityRule below).
  eligibilityPolicy     String?           @map("eligibility_policy")
  resultPublishedAt     DateTime?         @map("result_published_at")
  resultPublishedBy     String?           @map("result_published_by") @db.Uuid
  /// Grading scheme applied by the result engine for this session; null falls back to the
  /// tenant's default GradingScheme (itself configurable, never hard-coded).
  gradingSchemeId       String?           @map("grading_scheme_id") @db.Uuid
  gradingScheme         GradingScheme?    @relation(fields: [gradingSchemeId], references: [id], onDelete: SetNull)
  /// Per-session grace-marks override, e.g. { enabled: true, maxGraceMarks: 2, graceToPassDiff: 4 }.
  /// When present it wins over the scheme's own grace settings.
  gracePolicy           Json?             @map("grace_policy")
  /// Set when results are locked at session level (hard stop on recalculation/publication).
  resultsLockedAt       DateTime?         @map("results_locked_at")
  remarks               String?
  createdBy             String?           @map("created_by")
  updatedBy             String?           @map("updated_by")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  deletedAt             DateTime?         @map("deleted_at")

  supplementarySessions ExamSession[]         @relation("ExamSessionChain")
  studentExams          StudentExam[]         @relation("StudentExamSessions")
  subjects              ExamSubject[]
  eligibilityRules      ExamEligibilityRule[]
  registrations         ExamRegistration[]
  hallTickets           ExamHallTicket[]
  seatingPlans          ExamSeatingPlan[]
  assessmentComponents  AssessmentComponent[]
  resultCalculations    ResultCalculation[]
  resultProcesses       ResultProcess[]
  resultHistory         ResultHistory[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, programId, termId])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("exam_sessions")
}

/// One paper within a session. Anchored on the academics Course catalog (no duplicate course
/// taxonomy); marks/duration/time are set here because they vary per exam. A single room may be
/// the paper's default venue for hall-ticket printing; fine-grained seating lives in
/// ExamSeatingPlan/ExamSeatAllocation.
model ExamSubject {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessionId       String            @map("session_id") @db.Uuid
  session         ExamSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  courseId        String            @map("course_id") @db.Uuid
  course          Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  roomId          String?           @map("room_id") @db.Uuid
  room            Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  maxMarks        Int               @map("max_marks")
  passMarks       Int               @map("pass_marks")
  durationMinutes Int?              @map("duration_minutes")
  /// Free-form paper/pattern description (e.g. "MCQ + long answers").
  pattern         String?
  examDate        DateTime?         @map("exam_date")
  startTime       String?           @map("start_time")
  endTime         String?           @map("end_time")
  status          ExamSubjectStatus @default(DRAFT)
  remarks         String?
  createdBy       String?           @map("created_by")
  updatedBy       String?           @map("updated_by")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  hallTicketLines        ExamHallTicketSubject[]
  seatingPlans           ExamSeatingPlan[]
  invigilatorAssignments ExamInvigilatorAssignment[]
  marksEntries           ExamMarksEntry[]
  revaluationRequests    ExamRevaluationRequest[]
  assessmentComponents   AssessmentComponent[]       @relation("SubjectComponents")
  componentMarks         ExamComponentMark[]
  resultCalculations     ResultCalculation[]

  @@unique([tenantId, sessionId, courseId])
  @@index([tenantId])
  @@index([tenantId, sessionId])
  @@index([tenantId, status])
  @@map("exam_subjects")
}

/// Data-driven eligibility rule attached to a session; enabled rules are AND-composed by the
/// exams service when computing/report-ing eligible students. Each rule type maps to an
/// existing-data check (student status/enrollment, attendance aggregates, course prerequisites,
/// open backlogs).
model ExamEligibilityRule {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String                  @map("tenant_id") @db.Uuid
  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessionId            String                  @map("session_id") @db.Uuid
  session              ExamSession             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ruleType             ExamEligibilityRuleType @map("rule_type")
  enabled              Boolean                 @default(true)
  /// Required overall attendance % for MINIMUM_ATTENDANCE rules.
  minAttendancePercent Int?                    @map("min_attendance_percent")
  remarks              String?
  createdBy            String?                 @map("created_by")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  @@unique([tenantId, sessionId, ruleType])
  @@index([tenantId, sessionId])
  @@map("exam_eligibility_rules")
}

/// A student registered to sit a session. Subject-level participation is derived per
/// registration from the session's subject list (regular sessions: students registered for the
/// course in the term; supplementary sessions: students holding an OPEN backlog or FAIL for it).
model ExamRegistration {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String                 @map("tenant_id") @db.Uuid
  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessionId    String                 @map("session_id") @db.Uuid
  session      ExamSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId    String                 @map("student_id") @db.Uuid
  student      Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status       ExamRegistrationStatus @default(REGISTERED)
  registeredAt DateTime               @default(now()) @map("registered_at")
  remarks      String?
  createdBy    String?                @map("created_by")
  updatedBy    String?                @map("updated_by")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  hallTicket          ExamHallTicket?
  seatAllocations     ExamSeatAllocation[]
  marksEntries        ExamMarksEntry[]
  revaluationRequests ExamRevaluationRequest[]
  componentMarks      ExamComponentMark[]
  resultCalculations  ResultCalculation[]

  @@unique([tenantId, sessionId, studentId])
  @@index([tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, sessionId])
  @@map("exam_registrations")
}

/// One admit card per registration. The per-subject line items are immutable snapshots (course
/// code/name/marks/venue/seat) frozen at generation time so printed/issued tickets never change
/// when a subject is later edited.
model ExamHallTicket {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  registrationId String               @unique @map("registration_id") @db.Uuid
  registration   ExamRegistration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  sessionId      String               @map("session_id") @db.Uuid
  session        ExamSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ticketNumber   String               @map("ticket_number")
  status         ExamHallTicketStatus @default(ISSUED)
  issuedAt       DateTime?            @map("issued_at")
  issuedBy       String?              @map("issued_by")
  remarks        String?
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  subjects ExamHallTicketSubject[]

  @@unique([tenantId, ticketNumber])
  @@index([tenantId])
  @@index([tenantId, sessionId])
  @@index([tenantId, status])
  @@map("exam_hall_tickets")
}

/// Immutable per-subject line item on a hall ticket (see ExamHallTicket).
model ExamHallTicketSubject {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  hallTicketId String         @map("hall_ticket_id") @db.Uuid
  hallTicket   ExamHallTicket @relation(fields: [hallTicketId], references: [id], onDelete: Cascade)
  subjectId    String         @map("subject_id") @db.Uuid
  subject      ExamSubject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  courseCode   String         @map("course_code")
  courseName   String         @map("course_name")
  maxMarks     Int            @map("max_marks")
  passMarks    Int            @map("pass_marks")
  examDate     DateTime?      @map("exam_date")
  startTime    String?        @map("start_time")
  endTime      String?        @map("end_time")
  roomName     String?        @map("room_name")
  seatNo       String?        @map("seat_no")
  createdAt    DateTime       @default(now()) @map("created_at")

  @@unique([tenantId, hallTicketId, subjectId])
  @@index([tenantId])
  @@index([tenantId, hallTicketId])
  @@map("exam_hall_ticket_subjects")
}

/// A seating plan associates a room (reused from the Organization module) with a subject (or the
/// whole session when subjectId is null) for hall tickets and attendance marking. capacity is a
/// snapshot of the room's usable seats at generation time.
model ExamSeatingPlan {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessionId String       @map("session_id") @db.Uuid
  session   ExamSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subjectId String?      @map("subject_id") @db.Uuid
  subject   ExamSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  roomId    String       @map("room_id") @db.Uuid
  room      Room         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  label     String?
  capacity  Int?
  createdBy String?      @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  allocations ExamSeatAllocation[]

  @@index([tenantId])
  @@index([tenantId, sessionId])
  @@index([tenantId, subjectId])
  @@map("exam_seating_plans")
}

/// One student's allocated seat for a plan. seatNo is unique within the plan's reading room;
/// a registration may only have one allocation per plan. status is the invigilator's gate for
/// marks entry (PRESENT/ABSENT from the attendance sheet).
model ExamSeatAllocation {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String                   @map("tenant_id") @db.Uuid
  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  planId         String                   @map("plan_id") @db.Uuid
  plan           ExamSeatingPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  registrationId String                   @map("registration_id") @db.Uuid
  registration   ExamRegistration         @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  studentId      String                   @map("student_id") @db.Uuid
  student        Student                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  seatNo         String                   @map("seat_no")
  status         ExamSeatAllocationStatus @default(ALLOCATED)
  createdBy      String?                  @map("created_by")
  updatedBy      String?                  @map("updated_by")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  @@unique([tenantId, planId, registrationId])
  @@unique([tenantId, planId, seatNo])
  @@index([tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, planId])
  @@map("exam_seat_allocations")
}

/// A user assigned to invigilate a subject's paper (reuses the tenant User catalog). A paper may
/// have one CHIEF_INVIGILATOR plus multiple INVIGILATORs; the optional room narrows which venue
/// they supervise.
model ExamInvigilatorAssignment {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String              @map("tenant_id") @db.Uuid
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subjectId  String              @map("subject_id") @db.Uuid
  subject    ExamSubject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userId     String              @map("user_id") @db.Uuid
  user       User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       ExamInvigilatorRole @default(INVIGILATOR)
  roomId     String?             @map("room_id") @db.Uuid
  room       Room?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  assignedAt DateTime?           @map("assigned_at")
  createdBy  String?             @map("created_by")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  @@unique([tenantId, subjectId, userId])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, subjectId])
  @@map("exam_invigilator_assignments")
}

/// Marks for one registration on one subject paper, with an approval workflow so an
/// examiner-submitted sheet must be moderated then approved before it can be published.
/// outcome is computed on approval from marksObtained (+ graceMarks) vs the subject's passMarks
/// using the shared ResultOutcome enum; the published StudentResult is derived from it.
model ExamMarksEntry {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  registrationId   String           @map("registration_id") @db.Uuid
  registration     ExamRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  subjectId        String           @map("subject_id") @db.Uuid
  subject          ExamSubject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  studentId        String           @map("student_id") @db.Uuid
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  marksObtained    Int?             @map("marks_obtained")
  graceMarks       Int              @default(0) @map("grace_marks")
  /// PRESENT/ABSENT free taxonomy (drives INCOMPLETE outcomes when no marks were recorded and
  /// lets attendance-only papers exist without inventing a separate table).
  attendanceStatus String           @default("PRESENT") @map("attendance_status")
  status           ExamMarksStatus  @default(DRAFT)
  moderatedBy      String?          @map("moderated_by")
  moderatedAt      DateTime?        @map("moderated_at")
  approvedBy       String?          @map("approved_by")
  approvedAt       DateTime?        @map("approved_at")
  remark           String?
  createdBy        String?          @map("created_by")
  updatedBy        String?          @map("updated_by")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  revaluationRequests ExamRevaluationRequest[]
  resultCalculations  ResultCalculation[]

  @@unique([tenantId, registrationId, subjectId])
  @@index([tenantId])
  @@index([tenantId, subjectId])
  @@index([tenantId, status])
  @@map("exam_marks_entries")
}

/// A student's request to re-evaluate a subject paper after results are published. RESOLVED
/// entries may carry revisedMarks, which flow back into the marks entry (and the published
/// StudentResult) when the revaluation closes.
model ExamRevaluationRequest {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  registrationId String                @map("registration_id") @db.Uuid
  registration   ExamRegistration      @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  subjectId      String                @map("subject_id") @db.Uuid
  subject        ExamSubject           @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  marksEntryId   String?               @map("marks_entry_id") @db.Uuid
  marksEntry     ExamMarksEntry?       @relation(fields: [marksEntryId], references: [id], onDelete: SetNull)
  reason         String
  requestedBy    String?               @map("requested_by")
  requestedAt    DateTime              @default(now()) @map("requested_at")
  status         ExamRevaluationStatus @default(REQUESTED)
  resolvedBy     String?               @map("resolved_by")
  resolvedAt     DateTime?             @map("resolved_at")
  revisedMarks   Int?                  @map("revised_marks")
  remark         String?
  createdBy      String?               @map("created_by")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  @@unique([tenantId, registrationId, subjectId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("exam_revaluation_requests")
}

// ---------------------------------------------------------------------------
// Results calculation engine (Phase 7, part 2) â€” a configurable result-calculation layer that
// sits on top of the exams module (exams keeps marks capture: DRAFT â†’ SUBMITTED â†’ MODERATED â†’
// APPROVED, revaluation, and the student-360 StudentExam/StudentResult sync). Nothing about how
// a grade is derived is hard-coded here: grading schemes (grades â†’ grade points, pass rules,
// grace-marks policy, GPA weighting) are tenant data, any paper may be split into weighted
// assessment components, and every computed result is snapshotted so results are reproducible
// and auditable.
//
//   GradingScheme        â†’ tenant-level, configurable grading policy (pass rule, grade scale,
//                          grace policy, GPA weighting/scale, rounding).
//   GradeScale           â†’ one band: percentage window â†” letter grade â†” grade point.
//   AssessmentComponent  â†’ optional session- or paper-level exam components with weightages
//                          (e.g. Internal 30% + End-Term 70% + Practical 20%).
//   ExamComponentMark    â†’ a student's marks in one component of one paper.
//   ResultCalculation    â†’ the computed, snapshotted result of one student in one paper
//                          (weighted/effective marks, grade, grade point, outcome, schema used).
//   ResultProcess        â†’ one student's whole-session result state machine, GPA, CGPA and
//                          standing (CALCULATED â†’ APPROVED â†’ PUBLISHED â†’ LOCKED).
//   ResultHistory        â†’ an append-only trail of calculation/approval/publication/lock events.
// ---------------------------------------------------------------------------

/// Tenant-level, configurable grading scheme used by the result engine. Grading is entirely
/// data-driven â€” no institution's scheme is baked in. A session either names a scheme or falls
/// back to the tenant's default (created on first use and editable from the UI).
model GradingScheme {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code              String
  name              String
  description       String?
  /// How a paper is judged a pass: PERCENTAGE (>= minPassPercent of the paper's max marks) or
  /// GRADE_POINT (mapped gradePoint >= minPassGradePoint).
  passMode          String    @default("PERCENTAGE") @map("pass_mode")
  minPassPercent    Float?    @map("min_pass_percent")
  minPassGradePoint Float?    @map("min_pass_grade_point")
  /// GPA aggregation: CREDIT_WEIGHTED weights each paper's grade point by Course.creditHours;
  /// SIMPLE averages the grade points of the session's papers.
  weightingMode     String    @default("CREDIT_WEIGHTED") @map("weighting_mode")
  gpaMax            Float     @default(10) @map("gpa_max")
  /// Grace marks, where configured: when graceEnabled and a paper's shortfall from the pass
  /// threshold is <= graceToPassDiff, up to maxGraceMarks are applied so it becomes
  /// PASS_WITH_GRACE. A session-level gracePolicy on ExamSession overrides these.
  graceEnabled      Boolean   @default(false) @map("grace_enabled")
  maxGraceMarks     Float     @default(0) @map("max_grace_marks")
  graceToPassDiff   Float     @default(0) @map("grace_to_pass_diff")
  /// Decimal places used when rounding computed percentages / GPAs.
  roundingDecimals  Int       @default(2) @map("rounding_decimals")
  isDefault         Boolean   @default(false) @map("is_default")
  isActive          Boolean   @default(true) @map("is_active")
  createdBy         String?   @map("created_by")
  updatedBy         String?   @map("updated_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  gradeScale GradeScale[]
  sessions   ExamSession[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isDefault])
  @@map("grading_schemes")
}

/// One band of a GradingScheme's scale: a contiguous percentage window maps to a letter grade
/// and a grade point. Bands for one scheme are owned by the scheme (cascade delete); the engine
/// matches a computed percentage against bands in order (highest minPercent first).
model GradeScale {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  schemeId         String        @map("scheme_id") @db.Uuid
  scheme           GradingScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  grade            String
  minPercent       Float         @map("min_percent")
  maxPercent       Float         @map("max_percent")
  gradePoint       Float         @map("grade_point")
  gradeDescription String?       @map("grade_description")
  createdBy        String?       @map("created_by")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@unique([tenantId, schemeId, grade])
  @@index([tenantId, schemeId])
  @@map("grade_scales")
}

/// Optional, configurable assessment components for a session (e.g. Internal 30, End-Term 70).
/// subjectId null â‡’ the component applies to every paper in the session; otherwise only to that
/// paper. When any component applies to a paper, a student's component marks are aggregated
/// (weighted by `weightage`) onto the paper's own maxMarks; papers without components keep the
/// single entered marks value.
model AssessmentComponent {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessionId String       @map("session_id") @db.Uuid
  session   ExamSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subjectId String?      @map("subject_id") @db.Uuid
  subject   ExamSubject? @relation("SubjectComponents", fields: [subjectId], references: [id], onDelete: Cascade)
  code      String
  name      String
  /// Free taxonomy (INTERNAL / THEORY / PRACTICAL / PROJECT / VIVA / OTHER) â€” keeps paper kinds
  /// configurable without enums.
  kind      String       @default("THEORY")
  /// Percentage weight of this component in the paper's total (may exceed the default 100 total
  /// when components describe supplemental/internal weights; the engine normalizes by the sum).
  weightage Float        @map("weightage")
  maxMarks  Float        @map("max_marks")
  sortOrder Int          @default(0) @map("sort_order")
  createdBy String?      @map("created_by")
  updatedBy String?      @map("updated_by")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  marks ExamComponentMark[]

  @@unique([tenantId, sessionId, subjectId, code])
  @@index([tenantId, sessionId])
  @@index([tenantId, subjectId])
  @@map("assessment_components")
}

/// Marks recorded against one AssessmentComponent for a registered student in a paper. Only
/// used when the paper has components configured; the engine weights these into the paper's
/// total. Single-value papers keep using ExamMarksEntry alone.
model ExamComponentMark {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  registrationId String              @map("registration_id") @db.Uuid
  registration   ExamRegistration    @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  subjectId      String              @map("subject_id") @db.Uuid
  subject        ExamSubject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  componentId    String              @map("component_id") @db.Uuid
  component      AssessmentComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  studentId      String              @map("student_id") @db.Uuid
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  marksObtained  Float               @map("marks_obtained")
  remark         String?
  createdBy      String?             @map("created_by")
  updatedBy      String?             @map("updated_by")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@unique([tenantId, registrationId, subjectId, componentId])
  @@index([tenantId, componentId])
  @@index([tenantId, registrationId])
  @@index([tenantId, subjectId])
  @@map("exam_component_marks")
}

/// Computed result snapshot of one student in one paper, produced by the result engine from the
/// session's APPROVED marks (+ component marks) and the active grading scheme. Rows keep the
/// scheme snapshot and component breakdown used so recalculations and history stay reproducible.
model ResultCalculation {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessionId      String            @map("session_id") @db.Uuid
  session        ExamSession       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  studentId      String            @map("student_id") @db.Uuid
  student        Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  registrationId String?           @map("registration_id") @db.Uuid
  registration   ExamRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  subjectId      String            @map("subject_id") @db.Uuid
  subject        ExamSubject       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  marksEntryId   String?           @map("marks_entry_id") @db.Uuid
  marksEntry     ExamMarksEntry?   @relation(fields: [marksEntryId], references: [id], onDelete: SetNull)
  examId         String?           @map("exam_id") @db.Uuid
  exam           StudentExam?      @relation(fields: [examId], references: [id], onDelete: SetNull)
  processId      String?           @map("process_id") @db.Uuid
  process        ResultProcess?    @relation(fields: [processId], references: [id], onDelete: SetNull)
  /// Marks before any grace adjustment (single value or weighted component total).
  rawMarks       Float?            @map("raw_marks")
  graceApplied   Float             @default(0) @map("grace_applied")
  /// rawMarks + graceApplied, capped at maxMarks.
  effectiveMarks Float?            @map("effective_marks")
  maxMarks       Int               @map("max_marks")
  passMarks      Int               @map("pass_marks")
  percentage     Float?
  grade          String?
  gradePoint     Float?            @map("grade_point")
  outcome        ResultOutcome     @default(INCOMPLETE)
  /// Component-wise breakdown (marks, weightage, weighted marks) used when components applied.
  componentJson  Json?             @map("component_json")
  /// Immutable snapshot of the grading scheme config that produced this calculation.
  schemaJson     Json?             @map("schema_json")
  calculatedAt   DateTime?         @map("calculated_at")
  calculatedBy   String?           @map("calculated_by")
  createdBy      String?           @map("created_by")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  publishedResult StudentResult?

  @@unique([tenantId, sessionId, studentId, subjectId])
  @@index([tenantId, sessionId])
  @@index([tenantId, studentId])
  @@index([tenantId, subjectId])
  @@index([tenantId, processId])
  @@index([tenantId, outcome])
  @@map("result_calculations")
}

/// One student's whole-session result process: state machine (CALCULATED â†’ APPROVED â†’ PUBLISHED
/// â†’ LOCKED), aggregated marks, credits, GPA and standing. CGPA (`cgpa`) is captured at
/// calculation time across every previously published/locked process of the student.
model ResultProcess {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String          @map("tenant_id") @db.Uuid
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessionId           String          @map("session_id") @db.Uuid
  session             ExamSession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  studentId           String          @map("student_id") @db.Uuid
  student             Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  examId              String?         @map("exam_id") @db.Uuid
  exam                StudentExam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
  state               ResultState     @default(CALCULATED)
  standing            ResultStanding?
  subjectCount        Int?            @map("subject_count")
  passedCount         Int?            @map("passed_count")
  failedCount         Int?            @map("failed_count")
  totalRawMarks       Float?          @map("total_raw_marks")
  totalGraceMarks     Float?          @map("total_grace_marks")
  totalEffectiveMarks Float?          @map("total_effective_marks")
  totalMaxMarks       Int?            @map("total_max_marks")
  aggregatePercent    Float?          @map("aggregate_percent")
  creditsAttempted    Int?            @map("credits_attempted")
  creditsEarned       Int?            @map("credits_earned")
  gpa                 Float?
  cgpa                Float?
  /// Bumped on every recalculation; lets consumers detect re-published results.
  calculationVersion  Int             @default(1) @map("calculation_version")
  calculatedAt        DateTime?       @map("calculated_at")
  calculatedBy        String?         @map("calculated_by")
  approvedAt          DateTime?       @map("approved_at")
  approvedBy          String?         @map("approved_by")
  publishedAt         DateTime?       @map("published_at")
  publishedBy         String?         @map("published_by")
  lockedAt            DateTime?       @map("locked_at")
  createdBy           String?         @map("created_by")
  updatedBy           String?         @map("updated_by")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  history ResultHistory[]

  calculations ResultCalculation[]

  @@unique([tenantId, sessionId, studentId])
  @@index([tenantId, sessionId])
  @@index([tenantId, studentId])
  @@index([tenantId, state])
  @@map("result_processes")
}

/// Append-only trail of result lifecycle events (calculation, approval, publication, locking,
/// recalculation â€¦). `details` holds the delta of the event.
model ResultHistory {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessionId   String         @map("session_id") @db.Uuid
  session     ExamSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  processId   String?        @map("process_id") @db.Uuid
  process     ResultProcess? @relation(fields: [processId], references: [id], onDelete: SetNull)
  studentId   String?        @map("student_id") @db.Uuid
  student     Student?       @relation(fields: [studentId], references: [id], onDelete: SetNull)
  /// Event verb: CALCULATED / APPROVED / PUBLISHED / UNPUBLISHED / LOCKED / UNLOCKED / REJECTED.
  event       String
  fromState   ResultState?
  toState     ResultState?
  details     Json?
  actorUserId String?        @map("actor_user_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([tenantId, sessionId])
  @@index([tenantId, studentId])
  @@index([tenantId, processId])
  @@map("result_history")
}

// ---------------------------------------------------------------------------
// Fees & Finance (Phase 14) â€” a complete fee-billing surface built on top of the Student 360
// fee ledger. StudentFee stays the single demand-line table and StudentPayment the receipt/
// ledger entry the students module already owns; this module adds the catalog + planning +
// workflow layers around them:
//
//   FeeHead            â†’ the tenant's fee catalog (code-denormalized on StudentFee later).
//   FeeStructure       â†’ a fee template scoped to academic year/term/program/section with
//                        installment + late-fee rules.
//   FeeStructureLine   â†’ one head within a structure with its amount override.
//   StudentFeeAssignment â†’ binding a structure to a student (per term); generation materializes
//                        the structure's lines into StudentFee rows grouped under FeeDemands.
//   FeeDemand           â†’ an issued demand (one installment) grouping its StudentFee lines;
//                        numbered per tenant via FeeSequence (kind DEMAND).
//   FeeConcession       â†’ scholarship/waiver/concession request against a demand or single line;
//                        APPROVED applies to the ledger via StudentFee.waivedCents.
//   FeeRefund           â†’ refund workflow against a StudentPayment; PROCESSED reverses the
//                        allocation transactionally (reuses student-records semantics).
//   FeeSequence         â†’ atomic per-tenant counters for receipt / demand / refund numbering.
//
// Money invariants: every amount is integer minor units (paise/cents). Payments never exceed a
// line's outstanding balance unless explicitly permitted; payment allocation and status
// recomputation always happen inside the same transaction as the StudentPayment row. Waivers /
// concessions only ever move StudentFee.waivedCents; refunds only ever move paidCents backwards
// by the refunded amount. All mutations write an audit entry (module 'fees').
// ---------------------------------------------------------------------------

/// A tenant-level fee catalog entry. Codes are tenant-unique and denormalized onto StudentFee
/// lines at demand-generation time (so historical demands stay intact even if the head is
/// renamed/archived, mirroring the codebase's free-form-string snapshot philosophy).
model FeeHead {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code               String
  name               String
  frequency          FeeHeadFrequency
  defaultAmountCents Int              @map("default_amount_cents")
  isOptional         Boolean          @default(false) @map("is_optional")
  isRefundable       Boolean          @default(true) @map("is_refundable")
  isActive           Boolean          @default(true) @map("is_active")
  description        String?
  createdBy          String?          @map("created_by")
  updatedBy          String?          @map("updated_by")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  deletedAt          DateTime?        @map("deleted_at")

  structureLines FeeStructureLine[] @relation("FeeHeadLines")
  concessions    FeeConcession[]
  hostels        Hostel[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
  @@map("fee_heads")
}

/// A fee template. Installment math: a structure with installmentCount N splits each line into N
/// equal parts (remainder paise attach to the last installment) and stages them as separate
/// FeeDemands. dueDayOffset is added to the anchor date (term.startDate, else the assignment's
/// effective date) for the first installment; further installments add installmentGapDays.
/// Late-fee rules: after dueDate + lateFeeGraceDays, an accrual adds max(flat, % of unpaid).
model FeeStructure {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name               String
  status             FeeStructureStatus @default(DRAFT)
  academicYearId     String?            @map("academic_year_id") @db.Uuid
  academicYear       AcademicYear?      @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  termId             String?            @map("term_id") @db.Uuid
  term               Term?              @relation(fields: [termId], references: [id], onDelete: SetNull)
  programId          String?            @map("program_id") @db.Uuid
  program            Program?           @relation(fields: [programId], references: [id], onDelete: SetNull)
  sectionId          String?            @map("section_id") @db.Uuid
  section            Section?           @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  installmentCount   Int                @default(1) @map("installment_count")
  dueDayOffset       Int                @default(30) @map("due_day_offset")
  installmentGapDays Int                @default(0) @map("installment_gap_days")
  lateFeePercentBps  Int                @default(0) @map("late_fee_percent_bps")
  lateFeeFlatCents   Int                @default(0) @map("late_fee_flat_cents")
  lateFeeGraceDays   Int                @default(0) @map("late_fee_grace_days")
  description        String?
  createdBy          String?            @map("created_by")
  updatedBy          String?            @map("updated_by")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  lines         FeeStructureLine[]     @relation("FeeStructureLines")
  assignments   StudentFeeAssignment[] @relation("StructureAssignments")
  generatedFees StudentFee[]           @relation("FeeStructureGeneratedFees")

  @@index([tenantId, status])
  @@index([tenantId, academicYearId])
  @@index([tenantId, deletedAt])
  @@map("fee_structures")
}

/// A single head within a FeeStructure, priced for that structure. Referencing FeeHead.code/name
/// is optional â€” amounts are authoritative here and are snapshotted onto generated StudentFee
/// rows (headCode/headName) so demand history survives catalog edits.
model FeeStructureLine {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  structureId String       @map("structure_id") @db.Uuid
  structure   FeeStructure @relation("FeeStructureLines", fields: [structureId], references: [id], onDelete: Cascade)
  headId      String       @map("head_id") @db.Uuid
  head        FeeHead      @relation("FeeHeadLines", fields: [headId], references: [id], onDelete: Restrict)
  amountCents Int          @map("amount_cents")
  isRequired  Boolean      @default(true) @map("is_required")
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  generatedFees StudentFee[] @relation("FeeStructureLineGeneratedFees")

  @@unique([structureId, headId])
  @@index([tenantId, structureId])
  @@index([tenantId, headId])
  @@map("fee_structure_lines")
}

/// Binding of a structure to a student (optionally for a specific term). Generating demands for
/// an assignment materializes StudentFee lines + FeeDemands once; COMPLETED happens when all of
/// its demands are settled, REVOKED stops future issuance without touching the ledger.
model StudentFeeAssignment {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId     String              @map("student_id") @db.Uuid
  student       Student             @relation("StudentFeeAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  structureId   String              @map("structure_id") @db.Uuid
  structure     FeeStructure        @relation("StructureAssignments", fields: [structureId], references: [id], onDelete: Restrict)
  termId        String?             @map("term_id") @db.Uuid
  term          Term?               @relation(fields: [termId], references: [id], onDelete: SetNull)
  status        FeeAssignmentStatus @default(ACTIVE)
  effectiveDate DateTime            @default(now()) @map("effective_date") @db.Date
  notes         String?
  assignedBy    String?             @map("assigned_by")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  demands FeeDemand[] @relation("AssignmentDemands")

  @@unique([tenantId, studentId, structureId, termId])
  @@index([tenantId, studentId])
  @@index([tenantId, structureId])
  @@index([tenantId, status])
  @@index([tenantId, termId])
  @@map("student_fee_assignments")
}

/// A single issued demand (one installment of a structure) grouping its StudentFee lines.
/// Totals are cached on the demand so lists/reports don't aggregate per row; the authoritative
/// per-line state lives on StudentFee and drives the cache refresh after every mutation.
model FeeDemand {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignmentId     String               @map("assignment_id") @db.Uuid
  assignment       StudentFeeAssignment @relation("AssignmentDemands", fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId        String               @map("student_id") @db.Uuid
  student          Student              @relation("StudentDemands", fields: [studentId], references: [id], onDelete: Cascade)
  termId           String?              @map("term_id") @db.Uuid
  term             Term?                @relation(fields: [termId], references: [id], onDelete: SetNull)
  demandNumber     String               @map("demand_number")
  installmentIndex Int                  @default(1) @map("installment_index")
  issueDate        DateTime             @map("issue_date") @db.Date
  dueDate          DateTime             @map("due_date") @db.Date
  status           FeeStatus            @default(ISSUED)
  totalCents       Int                  @map("total_cents")
  paidCents        Int                  @default(0) @map("paid_cents")
  waivedCents      Int                  @default(0) @map("waived_cents")
  lateFeeCents     Int                  @default(0) @map("late_fee_cents")
  notes            String?
  createdBy        String?              @map("created_by")
  updatedBy        String?              @map("updated_by")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  lines       StudentFee[]
  concessions FeeConcession[]

  @@unique([tenantId, demandNumber])
  @@index([tenantId, studentId])
  @@index([tenantId, assignmentId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@map("fee_demands")
}

/// A scholarship / concession / waiver request against a demand (distributed across its lines) or
/// a single StudentFee line. Once APPROVED the computed amount lands on the target line(s) as
/// StudentFee.waivedCents (same channel the students module uses), triggering its status
/// recompute; REVOKED reverses only unused applied amounts.
model FeeConcession {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId    String              @map("student_id") @db.Uuid
  student      Student             @relation("StudentConcessions", fields: [studentId], references: [id], onDelete: Cascade)
  demandId     String?             @map("demand_id") @db.Uuid
  demand       FeeDemand?          @relation(fields: [demandId], references: [id], onDelete: SetNull)
  studentFeeId String?             @map("student_fee_id") @db.Uuid
  studentFee   StudentFee?         @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  headId       String?             @map("head_id") @db.Uuid
  head         FeeHead?            @relation(fields: [headId], references: [id], onDelete: SetNull)
  kind         FeeConcessionKind
  basis        FeeConcessionBasis
  percentBps   Int?                @map("percent_bps")
  amountCents  Int?                @map("amount_cents")
  /// How much of this concession has actually been applied to the ledger so far.
  appliedCents Int                 @default(0) @map("applied_cents")
  /// Per-line split actually applied ([{ studentFeeId, amountCents }]) so REVOKE can reverse
  /// exactly the reduction that was applied rather than guessing from current balances.
  distribution Json?
  reason       String
  status       FeeConcessionStatus @default(PENDING)
  requestedBy  String?             @map("requested_by")
  decidedBy    String?             @map("decided_by")
  decidedAt    DateTime?           @map("decided_at")
  remarks      String?
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@index([tenantId, studentId])
  @@index([tenantId, status])
  @@index([tenantId, demandId])
  @@index([tenantId, studentFeeId])
  @@map("fee_concessions")
}

/// Refund workflow against a single StudentPayment (which may be a partial payment itself).
/// REQUESTED â†’ APPROVED â†’ PROCESSED; PROCESSED reverses the payment's ledger allocation in the
/// same transaction (StudentFee.paidCents âˆ’= refunded, demand/line status recomputed, the
/// StudentPayment marked REFUNDED when fully refunded) and writes a refundNumber receipt.
model FeeRefund {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId       String          @map("student_id") @db.Uuid
  student         Student         @relation("StudentRefunds", fields: [studentId], references: [id], onDelete: Cascade)
  paymentId       String          @map("payment_id") @db.Uuid
  payment         StudentPayment  @relation("PaymentRefunds", fields: [paymentId], references: [id], onDelete: Restrict)
  refundNumber    String          @map("refund_number")
  amountCents     Int             @map("amount_cents")
  method          PaymentMethod
  reason          String
  status          FeeRefundStatus @default(REQUESTED)
  requestedBy     String?         @map("requested_by")
  approvedBy      String?         @map("approved_by")
  approvedAt      DateTime?       @map("approved_at")
  processedBy     String?         @map("processed_by")
  processedAt     DateTime?       @map("processed_at")
  rejectionReason String?         @map("rejection_reason")
  referenceNumber String?         @map("reference_number")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@unique([tenantId, refundNumber])
  @@index([tenantId, studentId])
  @@index([tenantId, paymentId])
  @@index([tenantId, status])
  @@map("fee_refunds")
}

/// Atomic per-tenant counters for receipt/demand/refund numbering. Allocation is
/// update-increment inside the caller's transaction, so concurrent requests never collide.
model FeeSequence {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  kind      FeeSequenceKind
  prefix    String
  nextValue Int             @default(1) @map("next_value")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@unique([tenantId, kind, prefix])
  @@map("fee_sequences")
}

/// An exam session this student sits (registered for). Kept student-tethered so the 360 tab
/// shows "their exams"; results hang off it but survive an exam deletion via SET NULL.
model StudentExam {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId String     @map("student_id") @db.Uuid
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name      String
  examType  ExamType   @map("exam_type")
  termId    String?    @map("term_id") @db.Uuid
  term      Term?      @relation(fields: [termId], references: [id], onDelete: SetNull)
  programId String?    @map("program_id") @db.Uuid
  program   Program?   @relation(fields: [programId], references: [id], onDelete: SetNull)
  sectionId String?    @map("section_id") @db.Uuid
  section   Section?   @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  startDate DateTime?  @map("start_date")
  endDate   DateTime?  @map("end_date")
  status    ExamStatus @default(SCHEDULED)
  createdBy String?    @map("created_by")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  results            StudentResult[]
  resultCalculations ResultCalculation[]
  resultProcesses    ResultProcess[]

  /// Link back to the exam-module session (Phase 7) this row was synced from, when it was
  /// created by the exams result-publication flow rather than the student-360 editor. Nullable so
  /// manual per-student exam rows keep working unchanged; the unique below makes the publication
  /// flow idempotent (one 360 exam row per student per session).
  sessionId String?      @map("session_id") @db.Uuid
  session   ExamSession? @relation("StudentExamSessions", fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, studentId, sessionId])
  @@index([tenantId])
  @@index([studentId])
  @@index([programId])
  @@map("student_exams")
}

/// One subject's result within an exam (or standalone). Outcome drives the pass/fail view;
/// percentage/grade are optional so either grading style (numeric or letter) fits.
model StudentResult {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId     String        @map("student_id") @db.Uuid
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examId        String?       @map("exam_id") @db.Uuid
  exam          StudentExam?  @relation(fields: [examId], references: [id], onDelete: SetNull)
  subjectCode   String        @map("subject_code")
  subjectName   String        @map("subject_name")
  maxMarks      Int           @map("max_marks")
  obtainedMarks Int?          @map("obtained_marks")
  grade         String?
  gradePoint    Float?        @map("grade_point")
  percentage    Float?
  /// Grace marks applied by the result engine to reach a pass (drives PASS_WITH_GRACE).
  graceApplied  Float         @default(0) @map("grace_applied")
  /// Component-wise breakdown when the paper used weighted assessment components.
  componentJson Json?         @map("component_json")
  outcome       ResultOutcome @default(INCOMPLETE)
  publishedAt   DateTime?     @map("published_at")
  publishedBy   String?       @map("published_by") @db.Uuid
  remarks       String?
  createdBy     String?       @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  resultCalculationId String?            @unique @map("result_calculation_id") @db.Uuid
  resultCalculation   ResultCalculation? @relation(fields: [resultCalculationId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([studentId])
  @@index([examId])
  @@map("student_results")
}

/// Certificate / transcript documents and their issuance lifecycle
/// (request â†’ generate â†’ approve â†’ issue), with tamper-evident QR verification,
/// numbering chains, reissue lineage and append-only history.
model StudentCertificate {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId         String               @map("student_id") @db.Uuid
  student           Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  certificateType   CertificateType      @map("certificate_type")
  certificateNumber String?              @map("certificate_number")
  title             String?
  requestDate       DateTime             @map("request_date")
  status            CertificateStatus    @default(REQUESTED)
  /// The template whose branded layout / field config / numbering produced this document.
  templateId        String?              @map("template_id") @db.Uuid
  template          CertificateTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// Random verifier token encoded into the QR; resolves to the public verify page.
  qrToken           String?              @unique @map("qr_token")
  /// Immutable snapshot of branded, student & type-specific fields baked at generation time,
  /// so verification reflects exactly what was printed (independent of later edits).
  contentJson       Json?                @map("content_json")
  generatedAt       DateTime?            @map("generated_at")
  generatedByUserId String?              @map("generated_by_user_id") @db.Uuid
  approvedAt        DateTime?            @map("approved_at")
  approvedByUserId  String?              @map("approved_by_user_id") @db.Uuid
  issuedAt          DateTime?            @map("issued_at")
  issuedByUserId    String?              @map("issued_by_user_id") @db.Uuid
  storageKey        String?              @map("storage_key")
  revokedAt         DateTime?            @map("revoked_at")
  revokedByUserId   String?              @map("revoked_by_user_id") @db.Uuid
  revokeReason      String?              @map("revoke_reason")
  reissuedFromId    String?              @map("reissued_from_id") @db.Uuid
  reissuedFrom      StudentCertificate?  @relation("CertificateReissue", fields: [reissuedFromId], references: [id], onDelete: SetNull)
  reissues          StudentCertificate[] @relation("CertificateReissue")
  remarks           String?
  createdBy         String?              @map("created_by")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  history CertificateHistoryRow[]

  @@unique([tenantId, certificateNumber])
  @@index([tenantId])
  @@index([studentId])
  @@index([tenantId, status])
  @@index([tenantId, certificateType])
  @@map("student_certificates")
}

/// Reusable issuance template: branded layout, dynamic-field config, numbering chain
/// and (optionally) its QR payload used to print identical documents at scale.
model CertificateTemplate {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code            String
  name            String
  certificateType CertificateType @map("certificate_type")
  /// Human-authored field map consumed by the generate step: `{ "student_fullname": "fullName", ... }`.
  fieldConfigJson Json?           @map("field_config_json")
  /// Branding: colors / logoUrl / headerText / footerText / watermark / signedBy.
  brandingJson    Json?           @map("branding_json")
  /// Numbering: `{ prefix, start, padding, perType }`.
  numberingJson   Json?           @map("numbering_json")
  /// Whether the QR (verify token) is embedded on the printed document.
  qrEnabled       Boolean         @default(true) @map("qr_enabled")
  isDefault       Boolean         @default(false) @map("is_default")
  isActive        Boolean         @default(true) @map("is_active")
  createdBy       String?         @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  certificates StudentCertificate[]

  @@unique([tenantId, code])
  @@index([tenantId, certificateType])
  @@map("certificate_templates")
}

/// Append-only state transition log for a certificate document (request â†’ generate â†’
/// approve â†’ issue â†’ revoke â†’ reissue). Every write path appends a row here.
model CertificateHistoryRow {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  certificateId String             @map("certificate_id") @db.Uuid
  certificate   StudentCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  fromStatus    CertificateStatus  @map("from_status")
  toStatus      CertificateStatus  @map("to_status")
  actorUserId   String?            @map("actor_user_id") @db.Uuid
  detailJson    Json?              @map("detail_json")
  createdAt     DateTime           @default(now()) @map("created_at")

  @@index([tenantId, certificateId])
  @@map("certificate_history_rows")
}

/// Library loans for this student. Before the dedicated library catalog module existed these were
/// free-form string records (itemTitle/itemAuthor/itemCode/itemType â€” still supported for the
/// student-360 "quick loan" flow). The library module now writes the same model with a real
/// copyId/memberId link so circulation, inventory and fines are unified on ONE loan table: the
/// copy's status stays in sync here, the member anchors circulation scope, and LibraryFine /
/// LibraryTransaction carry the fine and per-copy history.
model StudentLibraryLoan {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId       String?           @map("student_id") @db.Uuid
  student         Student?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  /// Catalog links â€” set by the library module for catalog-issued loans; null for the legacy
  /// free-form student-360 quick loans.
  copyId          String?           @map("copy_id") @db.Uuid
  copy            LibraryCopy?      @relation(fields: [copyId], references: [id], onDelete: SetNull)
  memberId        String?           @map("member_id") @db.Uuid
  member          LibraryMember?    @relation(fields: [memberId], references: [id], onDelete: SetNull)
  itemTitle       String            @map("item_title")
  itemAuthor      String?           @map("item_author")
  itemCode        String?           @map("item_code")
  itemType        String?           @map("item_type")
  borrowedAt      DateTime          @map("borrowed_at")
  dueDate         DateTime?         @map("due_date")
  returnedAt      DateTime?         @map("returned_at")
  status          LibraryLoanStatus @default(ISSUED)
  /// How many times this loan was renewed (extending the due date); bounded by the library config.
  renewalCount    Int               @default(0) @map("renewal_count")
  lastRenewedAt   DateTime?         @map("last_renewed_at")
  /// Physical state the copy came back in â€” free-form ('GOOD' | 'DAMAGED' | ...) so the tenant's
  /// own vocabulary drives it.
  returnCondition String?           @map("return_condition")
  returnedById    String?           @map("returned_by_id") @db.Uuid
  /// Denormalized snapshot of any fine balance tied to this loan; LibraryFine is the system of record.
  fineCents       Int               @default(0) @map("fine_cents")
  remarks         String?
  createdBy       String?           @map("created_by")
  updatedBy       String?           @map("updated_by")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  fines        LibraryFine[]
  transactions LibraryTransaction[]

  @@index([tenantId])
  @@index([studentId])
  @@index([copyId])
  @@index([memberId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate, status])
  @@map("student_library_loans")
}

/// ---- Hostel Management ---------------------------------------------------
/// Hostel hierarchy: Hostel > HostelBuilding > HostelFloor > HostelRoom > HostelBed.
/// Hostels optionally pin a FeeHead so rent charges route through the shared student fee
/// ledger (StudentFee.hostelBookingId) instead of a parallel billing table. Warden/complaint/
/// visitor rows are hosted on the hostel; occupancy + student stay history live on
/// StudentHostelBooking (see above).

/// A physical hostel (residence hall) on a campus that owns buildings/floors/rooms/beds.
model Hostel {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  campusId            String           @map("campus_id") @db.Uuid
  campus              Campus           @relation(fields: [campusId], references: [id], onDelete: Restrict)
  code                String
  name                String
  genderType          HostelGenderType @default(COED) @map("gender_type")
  /// Primary warden for the hostel (a tenant user id). Used as the default complaint assignee
  /// and for daily-operation notifications until an explicit assignee is chosen.
  wardenUserId        String?          @map("warden_user_id") @db.Uuid
  description         String?
  /// When set, rent charges generated by this hostel's bookings use this head (code/name);
  /// otherwise the module falls back to a "hostel_rent"/"Hostel Rent" pseudo-head.
  feeHeadId           String?          @map("fee_head_id") @db.Uuid
  feeHead             FeeHead?         @relation(fields: [feeHeadId], references: [id], onDelete: SetNull)
  chargeRentOnCheckIn Boolean          @default(true) @map("charge_rent_on_check_in")
  isActive            Boolean          @default(true) @map("is_active")
  createdBy           String?          @map("created_by")
  updatedBy           String?          @map("updated_by")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  deletedAt           DateTime?        @map("deleted_at")

  buildings  HostelBuilding[]
  wardens    HostelWarden[]
  complaints HostelComplaint[]
  visitors   HostelVisitor[]
  bookings   StudentHostelBooking[]

  @@unique([tenantId, campusId, code])
  @@index([tenantId])
  @@index([campusId])
  @@index([tenantId, deletedAt])
  @@map("hostels")
}

model HostelBuilding {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  hostelId  String    @map("hostel_id") @db.Uuid
  hostel    Hostel    @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  code      String
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  floors   HostelFloor[]
  bookings StudentHostelBooking[]

  @@unique([tenantId, hostelId, code])
  @@index([tenantId])
  @@index([hostelId])
  @@index([tenantId, deletedAt])
  @@map("hostel_buildings")
}

model HostelFloor {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  buildingId  String         @map("building_id") @db.Uuid
  building    HostelBuilding @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  /// Physical floor number *within* its building (1..n); for basements use 0 or negative.
  floorNumber Int            @map("floor_number")
  name        String?
  isActive    Boolean        @default(true) @map("is_active")
  createdBy   String?        @map("created_by")
  updatedBy   String?        @map("updated_by")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  rooms    HostelRoom[]
  bookings StudentHostelBooking[]

  @@unique([tenantId, buildingId, floorNumber])
  @@index([tenantId])
  @@index([buildingId])
  @@index([tenantId, deletedAt])
  @@map("hostel_floors")
}

model HostelRoom {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  floorId          String            @map("floor_id") @db.Uuid
  floor            HostelFloor       @relation(fields: [floorId], references: [id], onDelete: Cascade)
  code             String
  name             String?
  sharing          HostelRoomSharing @default(SINGLE) @map("sharing")
  bedCapacity      Int               @default(1) @map("bed_capacity")
  /// Default monthly rent (in paise). A bed's own monthlyRentCents overrides this; a booking's
  /// monthlyRentCents is snapshotted at allocation-time from the bed then the room.
  monthlyRentCents Int               @default(0) @map("monthly_rent_cents")
  hasAttachedBath  Boolean           @default(false) @map("has_attached_bath")
  notes            String?
  isActive         Boolean           @default(true) @map("is_active")
  createdBy        String?           @map("created_by")
  updatedBy        String?           @map("updated_by")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")

  beds       HostelBed[]
  bookings   StudentHostelBooking[]
  complaints HostelComplaint[]

  @@unique([tenantId, floorId, code])
  @@index([tenantId])
  @@index([floorId])
  @@index([tenantId, deletedAt])
  @@map("hostel_rooms")
}

/// A single sleeping place in a room. Status is service-maintained: RESERVED when a booking is
/// allocated but not yet checked in, OCCUPIED once checked in, AVAILABLE after checkout/cancel,
/// MAINTENANCE when offline. Beds are never hard-deleted because bookings reference them.
model HostelBed {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roomId           String          @map("room_id") @db.Uuid
  room             HostelRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  code             String
  status           HostelBedStatus @default(AVAILABLE)
  monthlyRentCents Int?            @map("monthly_rent_cents")
  notes            String?
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  deletedAt        DateTime?       @map("deleted_at")

  bookings StudentHostelBooking[]

  @@unique([tenantId, roomId, code])
  @@index([tenantId])
  @@index([roomId])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("hostel_beds")
}

/// Named warden/assistant assignments on a hostel (userId is a tenant staff member — referenced
/// as a plain Uuid, matching Student.userId style, to avoid loading the whole User graph).
model HostelWarden {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  hostelId   String           @map("hostel_id") @db.Uuid
  hostel     Hostel           @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  userId     String           @map("user_id") @db.Uuid
  role       HostelWardenRole @default(WARDEN)
  isActive   Boolean          @default(true) @map("is_active")
  assignedBy String?          @map("assigned_by")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@unique([tenantId, hostelId, userId, role])
  @@index([tenantId])
  @@index([hostelId])
  @@index([userId])
  @@map("hostel_wardens")
}

model HostelComplaint {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                  @map("tenant_id") @db.Uuid
  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  hostelId         String                  @map("hostel_id") @db.Uuid
  hostel           Hostel                  @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  studentId        String?                 @map("student_id") @db.Uuid
  student          Student?                @relation(fields: [studentId], references: [id], onDelete: SetNull)
  roomId           String?                 @map("room_id") @db.Uuid
  room             HostelRoom?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  category         HostelComplaintCategory
  priority         SupportTicketPriority   @default(MEDIUM)
  status           HostelComplaintStatus   @default(OPEN)
  subject          String
  description      String
  assignedToUserId String?                 @map("assigned_to_user_id") @db.Uuid
  assignedAt       DateTime?               @map("assigned_at")
  resolvedByUserId String?                 @map("resolved_by_user_id") @db.Uuid
  resolutionNotes  String?                 @map("resolution_notes")
  resolvedAt       DateTime?               @map("resolved_at")
  closedAt         DateTime?               @map("closed_at")
  createdBy        String?                 @map("created_by")
  updatedBy        String?                 @map("updated_by")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([hostelId])
  @@index([studentId])
  @@index([tenantId, status])
  @@map("hostel_complaints")
}

/// Visitor logbook for a hostel: who entered (towards which student/room), when, and whether
/// they have exited. GENERAL visitors and school-gate use cases are out of scope — this is the
/// residential log that wardens review for security.
model HostelVisitor {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  hostelId         String              @map("hostel_id") @db.Uuid
  hostel           Hostel              @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  visitorName      String              @map("visitor_name")
  phone            String?
  email            String?
  idProofType      String?             @map("id_proof_type")
  idProofNumber    String?             @map("id_proof_number")
  purpose          String?
  studentId        String?             @map("student_id") @db.Uuid
  student          Student?            @relation(fields: [studentId], references: [id], onDelete: SetNull)
  /// Free-text target (e.g. "Room 204") used when no linked student record exists.
  visitorLabel     String?             @map("visitor_label")
  checkInAt        DateTime            @map("check_in_at")
  checkOutAt       DateTime?           @map("check_out_at")
  status           HostelVisitorStatus @default(INSIDE)
  recordedByUserId String?             @map("recorded_by_user_id") @db.Uuid
  notes            String?
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([hostelId])
  @@index([studentId])
  @@index([tenantId, status])
  @@map("hostel_visitors")
}

/// Hostel allocation/booking for this student across their stay. Post-hostel-module bookings
/// carry structured references (hostel/building/floor/room/bed — all optional so pre-existing
/// free-text student-360 rows and outside bookkeeping stay representable) AND denormalized
/// hostelName/roomNumber/bedNumber snapshots so the student 360 profile keeps rendering without
/// a join. Transfers close the old booking (status CHECKED_OUT) and open a new one linked via
/// previousBookingId, so room history and student hostel history are both derived from this one
/// append-only row set.
model StudentHostelBooking {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId         String                @map("student_id") @db.Uuid
  student           Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hostelId          String?               @map("hostel_id") @db.Uuid
  hostel            Hostel?               @relation(fields: [hostelId], references: [id], onDelete: SetNull)
  buildingId        String?               @map("building_id") @db.Uuid
  building          HostelBuilding?       @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  floorId           String?               @map("floor_id") @db.Uuid
  floor             HostelFloor?          @relation(fields: [floorId], references: [id], onDelete: SetNull)
  roomId            String?               @map("room_id") @db.Uuid
  room              HostelRoom?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  bedId             String?               @map("bed_id") @db.Uuid
  bed               HostelBed?            @relation(fields: [bedId], references: [id], onDelete: SetNull)
  /// Set on a transfer-created booking to point at the booking it replaced — builds the
  /// per-student "who lived where, when" chain without a separate transfer table.
  previousBookingId String?               @map("previous_booking_id") @db.Uuid
  previousBooking   StudentHostelBooking? @relation("HostelTransferChain", fields: [previousBookingId], references: [id], onDelete: SetNull)
  hostelName        String                @map("hostel_name")
  roomNumber        String                @map("room_number")
  bedNumber         String?               @map("bed_number")
  allocationDate    DateTime?             @map("allocation_date")
  checkInDate       DateTime?             @map("check_in_date")
  checkOutDate      DateTime?             @map("check_out_date")
  status            HostelBookingStatus   @default(REQUESTED)
  monthlyRentCents  Int?                  @map("monthly_rent_cents")
  remarks           String?
  createdBy         String?               @map("created_by")
  updatedBy         String?               @map("updated_by")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  subsequentBookings StudentHostelBooking[] @relation("HostelTransferChain")
  feeCharges         StudentFee[]

  @@index([tenantId])
  @@index([studentId])
  @@index([tenantId, status])
  @@index([hostelId])
  @@index([roomId])
  @@index([bedId])
  @@map("student_hostel_bookings")
}

/// Transport pass / route allocation for this student. Since the transport module exists the pass
/// points at the concrete route/stop/vehicle it was issued against (routeCode/routeName/
/// pickupPoint/dropPoint/vehicleNumber are denormalized snapshots kept for backward-compatible reads).
model StudentTransportPass {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId       String              @map("student_id") @db.Uuid
  student         Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  routeId         String?             @map("route_id") @db.Uuid
  route           TransportRoute?     @relation(fields: [routeId], references: [id], onDelete: SetNull)
  stopId          String?             @map("stop_id") @db.Uuid
  stop            TransportStop?      @relation("StudentPassPickupStop", fields: [stopId], references: [id], onDelete: SetNull)
  dropStopId      String?             @map("drop_stop_id") @db.Uuid
  dropStop        TransportStop?      @relation("StudentPassDropStop", fields: [dropStopId], references: [id], onDelete: SetNull)
  vehicleId       String?             @map("vehicle_id") @db.Uuid
  vehicle         TransportVehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId        String?             @map("driver_id") @db.Uuid
  driver          TransportDriver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  routeCode       String?             @map("route_code")
  routeName       String              @map("route_name")
  pickupPoint     String?             @map("pickup_point")
  dropPoint       String?             @map("drop_point")
  vehicleNumber   String?             @map("vehicle_number")
  periodStart     DateTime            @map("period_start")
  periodEnd       DateTime?           @map("period_end")
  status          TransportPassStatus @default(ACTIVE)
  amountCents     Int?                @map("amount_cents")
  dailyPickupTime String?             @map("daily_pickup_time")
  dailyDropTime   String?             @map("daily_drop_time")
  issuedOn        DateTime?           @map("issued_on")
  issuedByUserId  String?             @map("issued_by_user_id")
  remarks         String?
  createdBy       String?             @map("created_by")
  updatedBy       String?             @map("updated_by")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  feeCharges      StudentFee[]

  @@index([tenantId])
  @@index([studentId])
  @@index([tenantId, status])
  @@index([tenantId, routeId])
  @@index([tenantId, vehicleId])
  @@map("student_transport_passes")
}

/// A hold/flag on the student's record (academic/financial/administrative/etc.) â€” e.g.
/// blocks a transcript request until a fee is resolved. Holds are lifted, never deleted.
model StudentHold {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId      String            @map("student_id") @db.Uuid
  student        Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type           StudentHoldType
  reason         String
  placedOn       DateTime          @map("placed_on")
  placedByUserId String?           @map("placed_by_user_id") @db.Uuid
  status         StudentHoldStatus @default(ACTIVE)
  liftedOn       DateTime?         @map("lifted_on")
  liftedByUserId String?           @map("lifted_by_user_id") @db.Uuid
  remarks        String?
  createdBy      String?           @map("created_by")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([studentId])
  @@index([tenantId, status])
  @@map("student_holds")
}

/// Append-only status transition journal for a student. The first row for a student has a null
/// fromStatus (created into its initial state).
model StudentStatusHistory {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId       String         @map("student_id") @db.Uuid
  student         Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromStatus      StudentStatus? @map("from_status")
  toStatus        StudentStatus  @map("to_status")
  reason          String?
  changedByUserId String?        @map("changed_by_user_id") @db.Uuid
  changedAt       DateTime       @default(now()) @map("changed_at")

  @@index([tenantId])
  @@index([studentId])
  @@index([studentId, changedAt])
  @@map("student_status_history")
}

/// Communication history with the student / their guardians (calls, emails, SMS, meetingsâ€¦).
model StudentCommunication {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId         String                 @map("student_id") @db.Uuid
  student           Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type              CommunicationType
  direction         CommunicationDirection @default(OUTBOUND)
  subject           String?
  body              String
  sentAt            DateTime               @map("sent_at")
  recipientType     String                 @default("STUDENT") @map("recipient_type")
  recipientName     String?                @map("recipient_name")
  recipientPhone    String?                @map("recipient_phone")
  recipientEmail    String?                @map("recipient_email")
  conductedByUserId String?                @map("conducted_by_user_id") @db.Uuid
  remarks           String?
  createdBy         String?                @map("created_by")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([studentId])
  @@index([studentId, sentAt])
  @@map("student_communications")
}

/// Append-only activity timeline for Student 360. eventType is a free-form string (e.g.
/// student.created / student.status_changed / fee.payment_recorded / hold.placed) so modules
/// can log events without a schema change; entityType/entityId point at the related row
/// (payment, hold, certificateâ€¦). The timeline endpoint unions these with status-history rows.
model StudentActivity {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId   String   @map("student_id") @db.Uuid
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  eventType   String   @map("event_type")
  title       String
  description String?
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at")
  actorUserId String?  @map("actor_user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([studentId])
  @@index([studentId, occurredAt])
  @@map("student_activities")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// ADMISSIONS (module ADMISSIONS) â€” the pre-student recruitment lifecycle:
// Enquiry â†’ Application â†’ Documents â†’ Verification â†’ Merit â†’ Counselling â†’
// Selection â†’ Offer â†’ Payment â†’ Enrollment (auto-creates the Student record).
// Applicant-facing rows live here; once a student is enrolled the pipeline data
// is copied into the Student 360 sub-resources (StudentAdmission, documents,
// academic records, fee/payment ledger) so admissions stays applicant-centric.
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum AdmissionSessionStatus {
  OPEN
  CLOSED
}

enum AdmissionProgramStatus {
  OPEN
  CLOSED
  FULL
}

/// Pipelined applicant status. The enum order mirrors the lifecycle; stage is derived
/// (docs/merit/program boards filter on status, the pipeline report groups by stage).
enum AdmissionApplicationStatus {
  INITIATED
  SUBMITTED
  UNDER_VERIFICATION
  DOCUMENTS_VERIFIED
  MERIT_LISTED
  COUNSELLING_SCHEDULED
  COUNSELLED
  SELECTED
  OFFERED
  OFFER_ACCEPTED
  FEE_PAID
  ENROLLED
  WAITLISTED
  REJECTED
  CANCELLED
}

enum AdmissionOfferStatus {
  ISSUED
  ACCEPTED
  DECLINED
  EXPIRED
}

/// A recruitment round for an academic year. Holds the pipelineâ€™s defaults â€” fees,
/// dates, seat offers per program (AdmissionProgramOffer) and the dynamic document
/// checklist â€” so an institution can run parallel sessions (UG merit, lateral, midday).
model AdmissionSession {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String                 @map("tenant_id") @db.Uuid
  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code                String
  name                String
  academicYearId      String                 @map("academic_year_id") @db.Uuid
  academicYear        AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  startAt             DateTime               @map("start_at")
  endAt               DateTime               @map("end_at")
  applicationFeeCents Int                    @default(0) @map("application_fee_cents")
  admissionFeeCents   Int                    @default(0) @map("admission_fee_cents")
  status              AdmissionSessionStatus @default(OPEN)
  /// Drag of required document categories (strings) for this session; merged with the
  /// per-program override. Defaults to the moduleâ€™s DEFAULT_DOCUMENT_CHECKLIST.
  requiredDocuments   Json?                  @map("required_documents")
  source              String?                @default("FRONT_DESK")
  meritPublishedAt    DateTime?              @map("merit_published_at")
  createdBy           String?                @map("created_by")
  updatedBy           String?                @map("updated_by")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  programs         AdmissionProgramOffer[]
  enquiries        AdmissionEnquiry[]
  applications     AdmissionApplication[]
  counsellingSlots AdmissionCounsellingSlot[]
  formFields       AdmissionFormField[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([academicYearId])
  @@map("admission_sessions")
}

/// A program offered in a session with seat + fee configuration (the seat matrix).
/// filledSeats is incremented at offer-allocation and freed on decline/cancel; a seat
/// canâ€™t be offered past capacity (status flips FULL).
model AdmissionProgramOffer {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String                 @map("tenant_id") @db.Uuid
  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessionId           String                 @map("session_id") @db.Uuid
  session             AdmissionSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  programId           String                 @map("program_id") @db.Uuid
  program             Program                @relation(fields: [programId], references: [id], onDelete: Restrict)
  seats               Int                    @default(0)
  filledSeats         Int                    @default(0) @map("filled_seats")
  applicationFeeCents Int                    @default(0) @map("application_fee_cents")
  admissionFeeCents   Int                    @default(0) @map("admission_fee_cents")
  tuitionFeeCents     Int                    @default(0) @map("tuition_fee_cents")
  requiredDocuments   Json?                  @map("required_documents")
  status              AdmissionProgramStatus @default(OPEN)
  createdBy           String?                @map("created_by")
  updatedBy           String?                @map("updated_by")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  applications     AdmissionApplication[]
  eligibilityRules AdmissionEligibilityRule[]

  @@unique([tenantId, sessionId, programId])
  @@index([tenantId])
  @@index([sessionId])
  @@index([programId])
  @@map("admission_program_offers")
}

/// A pre-application contact â€” website/web form, walk-in, referralâ€¦ converted once an
/// actual application is created from it (source of the enquiry funnel report).
model AdmissionEnquiry {
  id                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String            @map("tenant_id") @db.Uuid
  tenant                   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessionId                String?           @map("session_id") @db.Uuid
  session                  AdmissionSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  programId                String?           @map("program_id") @db.Uuid
  program                  Program?          @relation(fields: [programId], references: [id], onDelete: SetNull)
  name                     String
  email                    String?
  phone                    String?
  source                   String            @default("WEBSITE")
  message                  String?
  followUpAt               DateTime?         @map("follow_up_at")
  convertedToApplicationId String?           @map("converted_to_application_id") @db.Uuid
  convertedAt              DateTime?         @map("converted_at")
  createdBy                String?           @map("created_by")
  updatedBy                String?           @map("updated_by")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")

  applications AdmissionApplication[]

  @@index([tenantId])
  @@index([sessionId])
  @@map("admission_enquiries")
}

/// The applicantâ€™s application â€” the heart of the pipeline. Structured identity columns
/// mirror Student; extra form answers live in `data` (the dynamic application form driven
/// by TenantConfiguration or the module defaults). guardian is a single JSON object kept
/// in sync with the Guardian row created at enrollment.
model AdmissionApplication {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                @map("tenant_id") @db.Uuid
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  applicationNumber  String                @map("application_number")
  sessionId          String                @map("session_id") @db.Uuid
  session            AdmissionSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  admissionProgramId String                @map("admission_program_id") @db.Uuid
  admissionProgram   AdmissionProgramOffer @relation(fields: [admissionProgramId], references: [id], onDelete: Restrict)
  campusId           String                @map("campus_id") @db.Uuid
  campus             Campus                @relation(fields: [campusId], references: [id], onDelete: Restrict)
  academicYearId     String                @map("academic_year_id") @db.Uuid
  academicYear       AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  enquiryId          String?               @map("enquiry_id") @db.Uuid
  enquiry            AdmissionEnquiry?     @relation(fields: [enquiryId], references: [id], onDelete: SetNull)

  firstName    String        @map("first_name")
  middleName   String?       @map("middle_name")
  lastName     String        @map("last_name")
  fullName     String        @map("full_name")
  gender       StudentGender @default(NOT_SPECIFIED)
  dateOfBirth  DateTime?     @map("date_of_birth")
  email        String?
  phone        String?
  category     String?
  nationality  String?       @default("Indian")
  addressLine1 String?       @map("address_line_1")
  addressLine2 String?       @map("address_line_2")
  city         String?
  state        String?
  postalCode   String?       @map("postal_code")
  country      String?       @default("India")
  guardian     Json?
  /// Answers to the dynamic application form (TenantConfiguration-driven / default schema).
  data         Json?
  remarks      String?

  status         AdmissionApplicationStatus @default(INITIATED)
  submittedAt    DateTime?                  @map("submitted_at")
  submittedBy    String?                    @map("submitted_by") @db.Uuid
  rejectedReason String?                    @map("rejected_reason")

  meritScore     Float?
  meritRank      Int?                  @map("merit_rank")
  /// Breakdown of the merit computation (component name â†’ points) so reviewers can see and
  /// dispute exactly how a score was derived. Non-null once meritScored.
  scoreBreakdown Json?                 @map("score_breakdown")
  /// When this application matches an existing one (email/phone/name+dob), itâ€™s flagged as a
  /// duplicate; points to the canonical application of record.
  duplicateOfId  String?               @map("duplicate_of_id") @db.Uuid
  duplicateOf    AdmissionApplication? @relation("AdmissionApplicationDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)

  counsellingSlotId String?                   @map("counselling_slot_id") @db.Uuid
  counsellingSlot   AdmissionCounsellingSlot? @relation(fields: [counsellingSlotId], references: [id], onDelete: SetNull)
  counselledAt      DateTime?                 @map("counselled_at")
  selectedAt        DateTime?                 @map("selected_at")

  feePaidAt         DateTime? @map("fee_paid_at")
  feeReceiptNumber  String?   @map("fee_receipt_number")
  enrolledStudentId String?   @map("enrolled_student_id") @db.Uuid
  enrolledStudent   Student?  @relation(fields: [enrolledStudentId], references: [id], onDelete: SetNull)
  enrolledAt        DateTime? @map("enrolled_at")

  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  documents      AdmissionDocument[]
  qualifications AdmissionQualification[]
  offers         AdmissionOffer[]
  payments       AdmissionFeePayment[]
  activities     AdmissionActivity[]
  duplicates     AdmissionApplication[]   @relation("AdmissionApplicationDuplicates")
  messages       AdmissionMessage[]

  @@unique([tenantId, applicationNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([sessionId])
  @@index([admissionProgramId])
  @@index([campusId])
  @@index([academicYearId])
  @@index([meritScore])
  @@index([duplicateOfId])
  @@map("admission_applications")
}

/// Applicant document (scanned/uploaded before the student exists). Mirrors StudentDocument;
/// verification is a first-class step that gates DOCUMENTS_VERIFIED.
model AdmissionDocument {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                @map("tenant_id") @db.Uuid
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  applicationId    String                @map("application_id") @db.Uuid
  application      AdmissionApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  category         String
  documentName     String                @map("document_name")
  storageKey       String?               @map("storage_key")
  originalFilename String?               @map("original_filename")
  mimeType         String?               @map("mime_type")
  sizeBytes        Int?                  @map("size_bytes")
  status           StudentDocumentStatus @default(PENDING)
  verifiedAt       DateTime?             @map("verified_at")
  verifiedBy       String?               @map("verified_by") @db.Uuid
  remarks          String?
  uploadedBy       String?               @map("uploaded_by") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([applicationId])
  @@index([tenantId, status])
  @@map("admission_documents")
}

/// Prior-education qualification entered with the application. Mirrors StudentAcademicRecord;
/// the highest qualification feeds the default merit score computation.
model AdmissionQualification {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String                @map("tenant_id") @db.Uuid
  tenant                 Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  applicationId          String                @map("application_id") @db.Uuid
  application            AdmissionApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  institution            String
  board                  String?
  degree                 String?
  yearOfPassing          Int?                  @map("year_of_passing")
  percentage             Float?
  gpa                    Float?
  grade                  String?
  marksObtained          Int?                  @map("marks_obtained")
  marksOutOf             Int?                  @map("marks_out_of")
  rank                   String?
  isHighestQualification Boolean               @default(false) @map("is_highest_qualification")
  verificationStatus     StudentDocumentStatus @default(PENDING) @map("verification_status")
  remarks                String?
  createdBy              String?               @map("created_by")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([applicationId])
  @@map("admission_qualifications")
}

/// Counselling slot on a session (optionally program-scoped). Capacity gates bookings.
model AdmissionCounsellingSlot {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessionId   String           @map("session_id") @db.Uuid
  session     AdmissionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  programId   String?          @map("program_id") @db.Uuid
  program     Program?         @relation(fields: [programId], references: [id], onDelete: SetNull)
  date        DateTime         @map("date")
  venue       String?
  capacity    Int              @default(1)
  bookedCount Int              @default(0) @map("booked_count")
  createdBy   String?          @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  applications AdmissionApplication[]

  @@index([tenantId])
  @@index([sessionId])
  @@index([programId])
  @@map("admission_counselling_slots")
}

/// An offer letter issued to a SELECTED applicant (seats are held at issuance and freed on
/// decline/cancel). Offers are accepted â†’ FEE_PAID â†’ ENROLLED.
model AdmissionOffer {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  applicationId     String               @map("application_id") @db.Uuid
  application       AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  offerNumber       String               @map("offer_number")
  admissionFeeCents Int                  @default(0) @map("admission_fee_cents")
  issuedAt          DateTime             @map("issued_at")
  expiresAt         DateTime             @map("expires_at")
  status            AdmissionOfferStatus @default(ISSUED)
  acceptedAt        DateTime?            @map("accepted_at")
  declinedAt        DateTime?            @map("declined_at")
  remarks           String?
  createdBy         String?              @map("created_by")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@unique([tenantId, offerNumber])
  @@unique([tenantId, applicationId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([applicationId])
  @@map("admission_offers")
}

/// Applicant-side payment for the admission fee (the applicant isnâ€™t a student yet, so it
/// canâ€™t live on the student ledger). Reuses the global PaymentMethod/PaymentStatus enums.
/// On enrollment itâ€™s copied to the created Studentâ€™s fee ledger.
model AdmissionFeePayment {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  applicationId    String               @map("application_id") @db.Uuid
  application      AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  amountCents      Int                  @map("amount_cents")
  currency         String               @default("INR")
  paymentDate      DateTime             @map("payment_date")
  method           PaymentMethod
  status           PaymentStatus        @default(SUCCEEDED)
  referenceNumber  String?              @map("reference_number")
  receiptNumber    String               @map("receipt_number")
  remarks          String?
  recordedByUserId String?              @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
  @@index([applicationId])
  @@map("admission_fee_payments")
}

/// Applicant-side timeline mirror (AdmissionActivity). Records every pipeline transition so a
/// profile page can show an audit trail without polling the platform audit log.
model AdmissionActivity {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  applicationId String               @map("application_id") @db.Uuid
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  eventType     String               @map("event_type")
  title         String
  description   String?
  entityType    String?              @map("entity_type")
  entityId      String?              @map("entity_id") @db.Uuid
  occurredAt    DateTime             @default(now()) @map("occurred_at")
  actorUserId   String?              @map("actor_user_id") @db.Uuid
  createdAt     DateTime             @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([applicationId])
  @@index([applicationId, occurredAt])
  @@map("admission_activities")
}

/// Input type for a configurable admission form field for a session. Replaces/supplements the
/// default ADMISSION_FORM_FIELDS so each institution can shape its application form without code.
model AdmissionFormField {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessionId     String             @map("session_id") @db.Uuid
  session       AdmissionSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  code          String
  label         String
  fieldType     AdmissionFieldType @map("field_type")
  placeholder   String?
  required      Boolean            @default(false)
  /// Select/radio option list (string values). Emitted in the form JSON sent to applicants.
  options       Json?
  helpText      String?            @map("help_text")
  sequenceOrder Int                @default(0) @map("sequence_order")
  isActive      Boolean            @default(true) @map("is_active")
  createdBy     String?            @map("created_by")
  updatedBy     String?            @map("updated_by")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@unique([tenantId, sessionId, code])
  @@index([tenantId])
  @@index([sessionId])
  @@map("admission_form_fields")
}

/// One eligibility predicate evaluated against an application (program-scoped). A rule can
/// target an applicant category and carries a typed config; all active rules must pass before
/// an application is eligible for a program (advisory at submission, enforced at scoring).
model AdmissionEligibilityRule {
  id                String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                       @map("tenant_id") @db.Uuid
  tenant            Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  programId         String                       @map("program_id") @db.Uuid
  program           AdmissionProgramOffer        @relation(fields: [programId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  ruleType          AdmissionEligibilityRuleType @map("rule_type")
  /// Typed rule configuration, e.g. { minPercentage: 60 }, { minGpa: 6.5 }, { minMarks: 75, marksOutOf: 100 },
  /// { minAgeYears: 16 }, { allowedCategories: ['General'] }, or custom { each: { id: 'X', expression: '...' } }.
  config            Json?
  appliesToCategory String?                      @map("applies_to_category")
  sequenceOrder     Int                          @default(0) @map("sequence_order")
  isActive          Boolean                      @default(true) @map("is_active")
  createdBy         String?                      @map("created_by")
  updatedBy         String?                      @map("updated_by")
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([programId])
  @@index([tenantId, isActive])
  @@map("admission_eligibility_rules")
}

/// Outbound communication to an applicant (or their guardian) recorded on the application
/// thread. Mirrors StudentCommunication; each send also enqueues a Notification.
model AdmissionMessage {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String                  @map("tenant_id") @db.Uuid
  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  applicationId         String                  @map("application_id") @db.Uuid
  application           AdmissionApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  subject               String
  body                  String
  channel               AdmissionMessageChannel
  sentBy                String?                 @map("sent_by") @db.Uuid
  sentAt                DateTime                @default(now()) @map("sent_at")
  relatedNotificationId String?                 @map("related_notification_id") @db.Uuid
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([applicationId])
  @@index([applicationId, sentAt])
  @@map("admission_messages")
}

enum AdmissionFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  EMAIL
  PHONE
  SELECT
  RADIO
  CHECKBOX
}

enum AdmissionEligibilityRuleType {
  MIN_PERCENTAGE
  MIN_GPA
  MIN_MARKS
  MIN_AGE
  MAX_AGE
  CATEGORY_ALLOWED
  CUSTOM
}

enum AdmissionMessageChannel {
  EMAIL
  SMS
  IN_APP
}

// ---------------------------------------------------------------------------
// Academics (Phase 4) â€” course catalog, curricula & curriculum versions, course
// offerings (with faculty assignment), student course registration, academic
// advising, academic progression / promotion / backlogs, and the academic
// calendar. Reuses Foundation/Organization master data (Program, AcademicYear,
// Term â€” the semester anchor, Campus, Department, Section, Batch) and Student
// 360 (Student, StudentEnrollment). Faculty are User rows (HR module not built
// yet), so offerings/advising reference userId. Business rules (prerequisite
// satisfaction, registration windows/capacity/waitlist, promotion thresholds)
// are enforced in the Academics API service layer.
// ---------------------------------------------------------------------------

enum CourseType {
  CORE
  ELECTIVE
  OPEN_ELECTIVE
  LABORATORY
  PROJECT
  INTERNSHIP
  MINOR
  OTHER
}

enum CurriculumVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CourseOfferingStatus {
  PLANNED
  ACTIVE
  CLOSED
  CANCELLED
  COMPLETED
}

enum FacultyAssignmentRole {
  PRIMARY
  CO_TEACHER
  ASSISTANT
}

enum CourseRegistrationStatus {
  REGISTERED
  CONFIRMED
  WAITLISTED
  WITHDRAWN
  DROPPED
  COMPLETED
}

enum AdvisingPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AdvisingStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum ProgressionStatus {
  CONTINUING
  PROMOTED
  REAPPEARING
  DETAINED
  GRADUATED
  WITHDRAWN
}

enum BacklogStatus {
  OPEN
  CLEARED
  EXEMPTED
}

/// Core course catalog entry. Owned by a tenant; optionally anchored to the
/// department that owns the course. Soft-deleted (archive) rather than hard
/// removed because curricula/offerings/history reference courses.
model Course {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  code         String
  name         String
  description  String?
  creditHours  Int         @default(3) @map("credit_hours")
  courseType   CourseType  @default(CORE) @map("course_type")
  /// Open taxonomy (GRADING / PASS_FAIL / SELF_STUDY) so tenant policies drive
  /// the grading scheme without a schema change.
  gradingBasis String?     @map("grading_basis")
  isActive     Boolean     @default(true) @map("is_active")
  createdBy    String?     @map("created_by")
  updatedBy    String?     @map("updated_by")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")

  prerequisites     CoursePrerequisite[] @relation("CoursePrerequisiteCourse")
  requiredBy        CoursePrerequisite[] @relation("CoursePrerequisiteRequired")
  curriculumCourses CurriculumCourse[]
  courseOfferings   CourseOffering[]
  backlogs          CourseBacklog[]
  examSubjects      ExamSubject[]

  @@unique([tenantId, code])
  @@index([tenantId, deletedAt])
  @@index([departmentId])
  @@map("courses")
}

/// Pre-requisite edge between two courses. A course may list multiple required
/// courses; the rule is satisfied when the student cleared each required course
/// (optionally with minGrade). Enforced at registration time by the service.
model CoursePrerequisite {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  courseId         String   @map("course_id") @db.Uuid
  course           Course   @relation("CoursePrerequisiteCourse", fields: [courseId], references: [id], onDelete: Restrict)
  requiredCourseId String   @map("required_course_id") @db.Uuid
  requiredCourse   Course   @relation("CoursePrerequisiteRequired", fields: [requiredCourseId], references: [id], onDelete: Restrict)
  /// Optional minimum grade required in the prerequisite (e.g. "B").
  minGrade         String?  @map("min_grade")
  description      String?
  createdBy        String?  @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, courseId, requiredCourseId])
  @@index([tenantId])
  @@index([requiredCourseId])
  @@map("course_prerequisites")
}

/// A named curriculum for a program (e.g. "B.Tech CSE 2026"). Versions below.
model Curriculum {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  programId   String    @map("program_id") @db.Uuid
  program     Program   @relation(fields: [programId], references: [id], onDelete: Restrict)
  code        String
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  versions CurriculumVersion[]

  @@unique([tenantId, code])
  @@index([tenantId, programId])
  @@index([tenantId, deletedAt])
  @@map("curricula")
}

/// A revision of a curriculum's course map. Only one non-archived version is
/// CURRENT (isCurrent) at a time; the course map lives in CurriculumCourse so a
/// version keeps a complete snapshot.
model CurriculumVersion {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  curriculumId    String                  @map("curriculum_id") @db.Uuid
  curriculum      Curriculum              @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  versionNumber   Int                     @map("version_number")
  name            String?
  description     String?
  status          CurriculumVersionStatus @default(DRAFT)
  effectiveFrom   DateTime?               @map("effective_from")
  effectiveTo     DateTime?               @map("effective_to")
  minTotalCredits Int?                    @map("min_total_credits")
  isCurrent       Boolean                 @default(false) @map("is_current")
  createdBy       String?                 @map("created_by")
  updatedBy       String?                 @map("updated_by")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  courses CurriculumCourse[]

  @@unique([tenantId, curriculumId, versionNumber])
  @@index([tenantId, curriculumId])
  @@index([tenantId, status])
  @@map("curriculum_versions")
}

/// Course membership in a CurriculumVersion: which course is taught in which
/// semester, whether it is compulsory, and any credit override that modifies the
/// course's default creditHours within this version.
model CurriculumCourse {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  curriculumVersionId String            @map("curriculum_version_id") @db.Uuid
  curriculumVersion   CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)
  courseId            String            @map("course_id") @db.Uuid
  course              Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  /// 1-based semester slot in the program (matches the curriculum's semester grid).
  semester            Int
  /// Open taxonomy (CORE / ELECTIVE / OPEN_ELECTIVE ...) aligned to CourseType.
  category            String?
  isCompulsory        Boolean           @default(true) @map("is_compulsory")
  sequence            Int               @default(0)
  minGrade            String?           @map("min_grade")
  creditOverride      Int?              @map("credit_override")
  createdBy           String?           @map("created_by")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@unique([tenantId, curriculumVersionId, courseId])
  @@index([tenantId, curriculumVersionId, semester])
  @@index([tenantId, courseId])
  @@map("curriculum_courses")
}

/// A concrete run of a course in a term for a section/batch (e.g. CS101 2026-1
/// Section A). Registers seats and windows; faculty assignment is separate
/// (CourseOfferingFaculty) so multiple instructors can share an offering.
model CourseOffering {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  courseId          String               @map("course_id") @db.Uuid
  course            Course               @relation(fields: [courseId], references: [id], onDelete: Restrict)
  termId            String               @map("term_id") @db.Uuid
  term              Term                 @relation(fields: [termId], references: [id], onDelete: Restrict)
  academicYearId    String               @map("academic_year_id") @db.Uuid
  academicYear      AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  programId         String               @map("program_id") @db.Uuid
  program           Program              @relation(fields: [programId], references: [id], onDelete: Restrict)
  sectionId         String?              @map("section_id") @db.Uuid
  section           Section?             @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  batchId           String?              @map("batch_id") @db.Uuid
  batch             Batch?               @relation(fields: [batchId], references: [id], onDelete: SetNull)
  campusId          String?              @map("campus_id") @db.Uuid
  campus            Campus?              @relation(fields: [campusId], references: [id], onDelete: SetNull)
  code              String
  /// Credit override for this offering; falls back to course creditHours.
  creditHours       Int?                 @map("credit_hours")
  status            CourseOfferingStatus @default(PLANNED)
  mode              String?
  capacity          Int?
  waitlistCapacity  Int?                 @default(0) @map("waitlist_capacity")
  enrollmentStartAt DateTime?            @map("enrollment_start_at")
  enrollmentEndAt   DateTime?            @map("enrollment_end_at")
  schedule          Json?
  createdBy         String?              @map("created_by")
  updatedBy         String?              @map("updated_by")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  deletedAt         DateTime?            @map("deleted_at")

  faculty            CourseOfferingFaculty[]
  registrations      CourseRegistration[]
  timetableEntries   TimetableEntry[]        @relation("OfferingTimetableEntries")
  attendanceSessions AttendanceSession[]     @relation("OfferingAttendanceSessions")

  @@unique([tenantId, code])
  @@index([tenantId, termId])
  @@index([tenantId, courseId])
  @@index([tenantId, programId])
  @@index([tenantId, sectionId])
  @@index([tenantId, batchId])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("course_offerings")
}

/// Faculty assignment to a course offering. Faculty are User rows (HR module not
/// built yet); assignments are additive so multiple instructors can coordinate.
model CourseOfferingFaculty {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  courseOfferingId  String                @map("course_offering_id") @db.Uuid
  courseOffering    CourseOffering        @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  userId            String                @map("user_id") @db.Uuid
  user              User                  @relation("FacultyAssignedCourseOfferings", fields: [userId], references: [id], onDelete: Restrict)
  role              FacultyAssignmentRole @default(CO_TEACHER)
  allocationPercent Int?                  @map("allocation_percent")
  isActive          Boolean               @default(true) @map("is_active")
  createdBy         String?               @map("created_by")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@unique([tenantId, courseOfferingId, userId])
  @@index([tenantId, userId])
  @@map("course_offering_faculty")
}

/// A student's registration in a course offering for a term. Capacity/waitlist
/// handling and prerequisite validation happen in the service layer.
model CourseRegistration {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                   @map("tenant_id") @db.Uuid
  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId        String                   @map("student_id") @db.Uuid
  student          Student                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  courseOfferingId String                   @map("course_offering_id") @db.Uuid
  courseOffering   CourseOffering           @relation(fields: [courseOfferingId], references: [id], onDelete: Restrict)
  termId           String                   @map("term_id") @db.Uuid
  term             Term                     @relation(fields: [termId], references: [id], onDelete: Restrict)
  status           CourseRegistrationStatus @default(REGISTERED)
  waitlistPosition Int?                     @map("waitlist_position")
  enrolledAt       DateTime                 @default(now()) @map("enrolled_at")
  approvedByUserId String?                  @map("approved_by_user_id") @db.Uuid
  dropReason       String?                  @map("drop_reason")
  completedAt      DateTime?                @map("completed_at")
  createdBy        String?                  @map("created_by")
  updatedBy        String?                  @map("updated_by")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  backlogs         CourseBacklog[] @relation("BacklogRegistration")
  backlogClearedIn CourseBacklog[] @relation("BacklogClearedRegistration")

  @@unique([tenantId, studentId, courseOfferingId])
  @@index([tenantId, status])
  @@index([tenantId, studentId, termId])
  @@map("course_registrations")
}

/// Academic advising / counselling session with a student. sessionType is free-form
/// (ACADEMIC / COURSE_PLANNING / BACKLOG / CAREER / OTHER); resolution is explicit.
model AcademicAdvisingRecord {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId     String           @map("student_id") @db.Uuid
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  advisorUserId String           @map("advisor_user_id") @db.Uuid
  advisor       User             @relation("AdvisorAdvisingRecords", fields: [advisorUserId], references: [id], onDelete: Restrict)
  termId        String?          @map("term_id") @db.Uuid
  term          Term?            @relation("TermAdvisingRecords", fields: [termId], references: [id], onDelete: SetNull)
  sessionType   String           @default("ACADEMIC") @map("session_type")
  summary       String
  details       String?
  actionItems   String?          @map("action_items")
  priority      AdvisingPriority @default(NORMAL)
  status        AdvisingStatus   @default(OPEN)
  followUpAt    DateTime?        @map("follow_up_at")
  resolvedAt    DateTime?        @map("resolved_at")
  createdBy     String?          @map("created_by")
  updatedBy     String?          @map("updated_by")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([tenantId, studentId])
  @@index([tenantId, advisorUserId])
  @@index([tenantId, status])
  @@map("academic_advising_records")
}

/// Year/term snapshot of a student's progression through their program: the
/// semester horizon, earned/required credits, backlog counts, and a promotion
/// decision. Append-only history that the promotion process writes.
model AcademicProgressionRecord {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId       String            @map("student_id") @db.Uuid
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  programId       String            @map("program_id") @db.Uuid
  program         Program           @relation(fields: [programId], references: [id], onDelete: Restrict)
  academicYearId  String            @map("academic_year_id") @db.Uuid
  academicYear    AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  batchId         String?           @map("batch_id") @db.Uuid
  batch           Batch?            @relation(fields: [batchId], references: [id], onDelete: SetNull)
  fromSemester    Int               @map("from_semester")
  toSemester      Int               @map("to_semester")
  status          ProgressionStatus
  creditsEarned   Int?              @map("credits_earned")
  creditsRequired Int?              @map("credits_required")
  gpaScore        Float?            @map("gpa_score")
  backlogOpen     Int               @default(0) @map("backlog_open")
  backlogCleared  Int               @default(0) @map("backlog_cleared")
  decisionBy      String?           @map("decision_by") @db.Uuid
  decidedAt       DateTime?         @map("decided_at")
  remarks         String?
  createdBy       String?           @map("created_by")
  updatedBy       String?           @map("updated_by")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([tenantId, studentId])
  @@index([tenantId, academicYearId])
  @@index([tenantId, status])
  @@map("academic_progression_records")
}

/// A failed (backlog) course a student must clear to be promoted. Clearing is an
/// explicit transition that the progression/promotion flow applies to a later
/// successful registration.
model CourseBacklog {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String              @map("tenant_id") @db.Uuid
  tenant                  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId               String              @map("student_id") @db.Uuid
  student                 Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId                String              @map("course_id") @db.Uuid
  course                  Course              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  registrationId          String?             @map("registration_id") @db.Uuid
  registration            CourseRegistration? @relation("BacklogRegistration", fields: [registrationId], references: [id], onDelete: SetNull)
  termId                  String              @map("term_id") @db.Uuid
  term                    Term                @relation(fields: [termId], references: [id], onDelete: Restrict)
  status                  BacklogStatus       @default(OPEN)
  clearedAt               DateTime?           @map("cleared_at")
  clearedInRegistrationId String?             @map("cleared_in_registration_id") @db.Uuid
  clearedInRegistration   CourseRegistration? @relation("BacklogClearedRegistration", fields: [clearedInRegistrationId], references: [id], onDelete: SetNull)
  remarks                 String?
  createdBy               String?             @map("created_by")
  updatedBy               String?             @map("updated_by")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  @@unique([tenantId, studentId, courseId, termId])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
  @@map("course_backlogs")
}

/// Academic calendar / event announcements. eventType and appliesTo are free-form
/// taxonomy (REGISTRATION / FEE / EXAM / HOLIDAY / EVENT; GLOBAL / PROGRAM /
/// DEPARTMENT) so tenants drive their own categories. Publishing is opt-in.
model AcademicCalendarEvent {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  termId         String?      @map("term_id") @db.Uuid
  term           Term?        @relation(fields: [termId], references: [id], onDelete: SetNull)
  eventType      String       @default("EVENT") @map("event_type")
  title          String
  description    String?
  startAt        DateTime     @map("start_at")
  endAt          DateTime     @map("end_at")
  appliesTo      String?      @default("GLOBAL") @map("applies_to")
  color          String?
  isPublished    Boolean      @default(false) @map("is_published")
  createdBy      String?      @map("created_by")
  updatedBy      String?      @map("updated_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([tenantId, academicYearId])
  @@index([tenantId, eventType])
  @@index([tenantId, isPublished])
  @@map("academic_calendar_events")
}

// ---------------------------------------------------------------------------
// Timetable (Phase 4) â€” weekly timetable construction on top of Foundation/
// Organization (Term, Campus, Room, Section, Building) and Academics (CourseOffering,
// CourseOfferingFaculty): the weekly grid (Timetable â†’ TimetablePeriod), assigned sessions
// (TimetableEntry), non-teaching days (TimetableHoliday), recurring faculty busy/unavailable
// times (FacultyAvailability), detected collisions (TimetableConflict), date-specific faculty
// swaps (TimetableSubstitution), and an append-only change log (TimetableHistory). The week
// model is day-of-week + numbered period slots; a timetable belongs to one term and one campus,
// and entries anchor to the offering's section (copied at write time so section conflicts work
// even when a future offering's sectionId is cleared). Conflict detection is a hard service-level
// gate on every write plus an explicit recheck sweep that materializes TimetableConflict rows â€”
// there are deliberately no DB unique constraints on the entry cells so consumption ordering and
// manual fixes are possible with the sweep as the source of truth.
// ---------------------------------------------------------------------------

enum TimetableStatus {
  DRAFT
  GENERATED
  PUBLISHED
  ARCHIVED
}

enum TimetableEntryType {
  LECTURE
  LAB
  TUTORIAL
  OTHER
}

enum TimetableConflictType {
  ROOM
  FACULTY
  SECTION
}

enum SubstitutionStatus {
  REQUESTED
  APPROVED
  DECLINED
  CANCELLED
  EXECUTED
}

/// A weekly timetable for a term on a campus. workingDays stores the active 0-6 weekday set;
/// the period grid lives in TimetablePeriod; assigned sessions live in TimetableEntry. Status
/// moves DRAFT â†’ GENERATED â†’ PUBLISHED â†’ ARCHIVED (generation and publication are explicit).
model Timetable {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  termId        String          @map("term_id") @db.Uuid
  term          Term            @relation("TermTimetables", fields: [termId], references: [id], onDelete: Restrict)
  campusId      String          @map("campus_id") @db.Uuid
  campus        Campus          @relation("CampusTimetables", fields: [campusId], references: [id], onDelete: Restrict)
  name          String
  code          String?
  status        TimetableStatus @default(DRAFT)
  /// ISO weekday numbers (0 = Sunday â€¦ 6 = Saturday) on which the timetable runs.
  workingDays   Json            @map("working_days")
  generatedAt   DateTime?       @map("generated_at")
  publishedAt   DateTime?       @map("published_at")
  publishedById String?         @map("published_by_id") @db.Uuid
  publishedBy   User?           @relation("TimetablePublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  createdBy     String?         @map("created_by")
  updatedBy     String?         @map("updated_by")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")

  periods       TimetablePeriod[]       @relation("TimetablePeriods")
  entries       TimetableEntry[]
  holidays      TimetableHoliday[]      @relation("TimetableHolidays")
  conflicts     TimetableConflict[]     @relation("TimetableConflicts")
  substitutions TimetableSubstitution[] @relation("TimetableSubstitutions")
  history       TimetableHistory[]      @relation("TimetableHistoryRows")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, termId])
  @@index([tenantId, campusId])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("timetables")
}

/// A numbered time slot in a timetable's grid (e.g. period 1 = 09:00-10:00). The grid is
/// replaced wholesale by the admin UI; breaks are marked so the generator skips them.
model TimetablePeriod {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  timetableId String    @map("timetable_id") @db.Uuid
  timetable   Timetable @relation("TimetablePeriods", fields: [timetableId], references: [id], onDelete: Cascade)
  sequence    Int
  startTime   String    @map("start_time")
  endTime     String    @map("end_time")
  isBreak     Boolean   @default(false) @map("is_break")
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  entries TimetableEntry[] @relation("PeriodTimetableEntries")

  @@unique([timetableId, sequence])
  @@index([tenantId, timetableId])
  @@map("timetable_periods")
}

/// A single scheduled session in the weekly grid. sectionId is copied from the offering at
/// write time; assignedUserId defaults to the offering's PRIMARY faculty but a manual entry
/// can override it (and the substitute flow swaps it per-date). title overrides the derived
/// display label for manual/OTHER entries.
model TimetableEntry {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  timetableId      String             @map("timetable_id") @db.Uuid
  timetable        Timetable          @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  periodId         String             @map("period_id") @db.Uuid
  period           TimetablePeriod    @relation("PeriodTimetableEntries", fields: [periodId], references: [id], onDelete: Restrict)
  dayOfWeek        Int                @map("day_of_week")
  courseOfferingId String?            @map("course_offering_id") @db.Uuid
  courseOffering   CourseOffering?    @relation("OfferingTimetableEntries", fields: [courseOfferingId], references: [id], onDelete: SetNull)
  sectionId        String?            @map("section_id") @db.Uuid
  section          Section?           @relation("SectionTimetableEntries", fields: [sectionId], references: [id], onDelete: SetNull)
  assignedUserId   String?            @map("assigned_user_id") @db.Uuid
  assignedUser     User?              @relation("FacultyTimetableEntries", fields: [assignedUserId], references: [id], onDelete: SetNull)
  roomId           String?            @map("room_id") @db.Uuid
  room             Room?              @relation("RoomTimetableEntries", fields: [roomId], references: [id], onDelete: SetNull)
  entryType        TimetableEntryType @default(LECTURE) @map("entry_type")
  title            String?
  notes            String?
  createdBy        String?            @map("created_by")
  updatedBy        String?            @map("updated_by")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  substitutions      TimetableSubstitution[] @relation("EntrySubstitutions")
  attendanceSessions AttendanceSession[]     @relation("EntryAttendanceSessions")

  @@index([tenantId, timetableId])
  @@index([tenantId, timetableId, dayOfWeek])
  @@index([tenantId, timetableId, periodId, dayOfWeek])
  @@index([tenantId, sectionId, dayOfWeek])
  @@index([tenantId, assignedUserId, dayOfWeek])
  @@index([tenantId, roomId, dayOfWeek])
  @@map("timetable_entries")
}

/// A date on which the timetable does not run (institutional/term holiday).
model TimetableHoliday {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  timetableId String    @map("timetable_id") @db.Uuid
  timetable   Timetable @relation("TimetableHolidays", fields: [timetableId], references: [id], onDelete: Cascade)
  date        DateTime  @map("date") @db.Date
  name        String
  description String?
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([timetableId, date])
  @@index([tenantId, timetableId])
  @@map("timetable_holidays")
}

/// Recurring time blocks a faculty member is NOT available (or explicitly available) for
/// teaching, e.g. admin duty, research day, another campus's load. isBlocked=true marks an
/// unavailability window the generator must avoid; false marks a guaranteed-free window. Blocks
/// are optionality scoped to a term/campus (null = applies everywhere).
model FacultyAvailability {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation("FacultyAvailabilityBlocks", fields: [userId], references: [id], onDelete: Cascade)
  termId    String?  @map("term_id") @db.Uuid
  campusId  String?  @map("campus_id") @db.Uuid
  dayOfWeek Int      @map("day_of_week")
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  isBlocked Boolean  @default(true) @map("is_blocked")
  note      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, userId])
  @@index([tenantId, termId])
  @@index([tenantId, campusId])
  @@map("faculty_availability")
}

/// A detected scheduling collision. Written by the manual-entry/update gate and by the explicit
/// recheck sweep (source: 'write' | 'sweep' | 'substitution'). entryAId/entryBId reference
/// TimetableEntry rows; for date-specific substitution conflicts substitutionAId/B carry the
/// TimetableSubstitution ids and the day/period identify the colliding slot.
model TimetableConflict {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  timetableId     String                @map("timetable_id") @db.Uuid
  timetable       Timetable             @relation("TimetableConflicts", fields: [timetableId], references: [id], onDelete: Cascade)
  conflictType    TimetableConflictType @map("conflict_type")
  dayOfWeek       Int                   @map("day_of_week")
  periodId        String?               @map("period_id") @db.Uuid
  entryAId        String?               @map("entry_a_id") @db.Uuid
  entryBId        String?               @map("entry_b_id") @db.Uuid
  substitutionAId String?               @map("substitution_a_id") @db.Uuid
  substitutionBId String?               @map("substitution_b_id") @db.Uuid
  description     String
  source          String                @default("sweep")
  detectedAt      DateTime              @default(now()) @map("detected_at")
  resolvedAt      DateTime?             @map("resolved_at")
  resolvedById    String?               @map("resolved_by_id") @db.Uuid
  createdBy       String?               @map("created_by")
  createdAt       DateTime              @default(now()) @map("created_at")

  @@index([tenantId, timetableId])
  @@index([tenantId, timetableId, resolvedAt])
  @@index([tenantId, entryAId])
  @@index([tenantId, entryBId])
  @@map("timetable_conflicts")
}

/// A date-specific faculty swap for one entry (a substitute takes the entry on a given date).
/// Only APPROVED substitutions take effect; EXECUTED is applied by the status sweep once the
/// effective date has passed.
model TimetableSubstitution {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  timetableId      String             @map("timetable_id") @db.Uuid
  timetable        Timetable          @relation("TimetableSubstitutions", fields: [timetableId], references: [id], onDelete: Cascade)
  entryId          String             @map("entry_id") @db.Uuid
  entry            TimetableEntry     @relation("EntrySubstitutions", fields: [entryId], references: [id], onDelete: Cascade)
  originalUserId   String?            @map("original_user_id") @db.Uuid
  substituteUserId String             @map("substitute_user_id") @db.Uuid
  substituteUser   User               @relation("SubstituteTimetableEntries", fields: [substituteUserId], references: [id], onDelete: Restrict)
  effectiveDate    DateTime           @map("effective_date") @db.Date
  reason           String?
  status           SubstitutionStatus @default(REQUESTED)
  requestedById    String?            @map("requested_by_id") @db.Uuid
  decidedById      String?            @map("decided_by_id") @db.Uuid
  decidedAt        DateTime?          @map("decided_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@unique([tenantId, entryId, effectiveDate])
  @@index([tenantId, timetableId, status])
  @@index([tenantId, substituteUserId, effectiveDate])
  @@map("timetable_substitutions")
}

/// Append-only change log for a timetable: structure edits, generation, publication, entry /
/// holiday / substitution events. Mirrors the audit trail at the timetable's own grain.
model TimetableHistory {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  timetableId String    @map("timetable_id") @db.Uuid
  timetable   Timetable @relation("TimetableHistoryRows", fields: [timetableId], references: [id], onDelete: Cascade)
  action      String
  actorId     String?   @map("actor_id") @db.Uuid
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([tenantId, timetableId])
  @@index([tenantId, timetableId, createdAt])
  @@map("timetable_history")
}

// ---------------------------------------------------------------------------
// Library (module: library) â€” a full catalog (books, authors, publishers, categories),
// physical copies with barcode/QR identity and condition tracking, members (anchored to
// Student and/or User), circulation (issue / return / renewal / reservation), fines
// (overdue / lost / damage), notifications, per-copy inventory transactions, a tenant
// config knob, sequence allocators, and report aggregates. Circulation writes reuse the
// existing StudentLibraryLoan table (see its doc comment) so no parallel loans model exists.
// Every model is tenant-owned; the tenant-guard client scopes them automatically.
// ---------------------------------------------------------------------------

enum LibraryMemberType {
  STUDENT
  FACULTY
  STAFF
  OTHER
}

enum LibraryMemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  CLOSED
}

/// Circulation state of a physical copy. RESERVED is a hold against a reservation; LOST and
/// DAMAGED are terminal item states (the loan gets LOST / returned DAMAGED and fines apply).
enum LibraryCopyStatus {
  AVAILABLE
  ISSUED
  RESERVED
  LOST
  DAMAGED
  WITHDRAWN
}

/// Physical condition, independent of circulation status.
enum LibraryCopyCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum LibraryReservationStatus {
  WAITING
  READY
  FULFILLED
  CANCELLED
  EXPIRED
}

enum LibraryFineType {
  OVERDUE
  LOST
  DAMAGE
  OTHER
}

enum LibraryFineStatus {
  PENDING
  PAID
  WAIVED
}

/// Append-only per-copy inventory/circulation events â€” powers the inventory history tab and
/// report aggregates (most borrowed, returns, damages, losses).
enum LibraryTransactionType {
  ADDED
  ISSUED
  RETURNED
  RENEWED
  LOST
  DAMAGED
  RESERVED
  READY
  FULFILLED
  CANCELLED
  WITHDRAWN
}

enum LibrarySequenceKind {
  MEMBER
  COPY
}

/// Catalog category â€” optionally tree-shaped via parentId.
model LibraryCategory {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code        String
  name        String
  description String?
  parentId    String?          @map("parent_id") @db.Uuid
  parent      LibraryCategory? @relation("LibraryCategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  createdBy   String?          @map("created_by")
  updatedBy   String?          @map("updated_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  children LibraryCategory[] @relation("LibraryCategoryChildren")
  books    LibraryBook[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@map("library_categories")
}

model LibraryPublisher {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code        String
  name        String
  addressLine String?   @map("address_line")
  city        String?
  country     String?   @default("India")
  phone       String?
  email       String?
  website     String?
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  books LibraryBook[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@map("library_publishers")
}

model LibraryAuthor {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code      String
  firstName String    @map("first_name")
  lastName  String?   @map("last_name")
  /// Denormalized full name for lists/reports (same convention as Student.fullName).
  fullName  String    @map("full_name")
  bio       String?
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  bookLinks LibraryBookAuthor[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, fullName])
  @@index([tenantId, deletedAt])
  @@map("library_authors")
}

/// Title-level catalog record. A book is "the title"; physical availability lives on LibraryCopy.
model LibraryBook {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String            @map("tenant_id") @db.Uuid
  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  isbn                 String?
  title                String
  subtitle             String?
  language             String?           @default("English")
  edition              String?
  pageCount            Int?              @map("page_count")
  publicationYear      Int?              @map("publication_year")
  description          String?
  coverStorageKey      String?           @map("cover_storage_key")
  categoryId           String            @map("category_id") @db.Uuid
  category             LibraryCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  publisherId          String?           @map("publisher_id") @db.Uuid
  publisher            LibraryPublisher? @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  /// What a lost/damaged copy costs to replace â€” used when the library assesses LOST/DAMAGE fines.
  replacementCostCents Int?              @map("replacement_cost_cents")
  /// Default loan window for copies of this title; overridable per loan.
  maxLoanDays          Int               @default(14) @map("max_loan_days")
  isActive             Boolean           @default(true) @map("is_active")
  createdBy            String?           @map("created_by")
  updatedBy            String?           @map("updated_by")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  deletedAt            DateTime?         @map("deleted_at")

  authors      LibraryBookAuthor[]
  copies       LibraryCopy[]
  reservations LibraryReservation[]

  @@index([tenantId])
  @@index([tenantId, title])
  @@index([tenantId, isbn])
  @@index([tenantId, categoryId])
  @@index([tenantId, deletedAt])
  @@map("library_books")
}

/// Book â†” author join (many-to-many), tenant-owned for mechanical isolation.
model LibraryBookAuthor {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bookId    String        @map("book_id") @db.Uuid
  book      LibraryBook   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  authorId  String        @map("author_id") @db.Uuid
  author    LibraryAuthor @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now()) @map("created_at")

  @@unique([tenantId, bookId, authorId])
  @@index([tenantId, authorId])
  @@map("library_book_authors")
}

/// A physical, individually-identifiable copy of a book. barcode (and accessionNumber) are the
/// scanner-facing ids; QR self-service pages embed `{ tenantSlug, copyBarcode }`.
model LibraryCopy {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bookId             String               @map("book_id") @db.Uuid
  book               LibraryBook          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  accessionNumber    String               @map("accession_number")
  barcode            String
  shelfLocation      String?              @map("shelf_location")
  acquisitionType    String?              @map("acquisition_type")
  acquisitionDate    DateTime?            @map("acquisition_date")
  purchasePriceCents Int?                 @map("purchase_price_cents")
  condition          LibraryCopyCondition @default(GOOD)
  status             LibraryCopyStatus    @default(AVAILABLE)
  notes              String?
  createdBy          String?              @map("created_by")
  updatedBy          String?              @map("updated_by")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  loans        StudentLibraryLoan[]
  reservations LibraryReservation[]
  transactions LibraryTransaction[]

  @@unique([tenantId, barcode])
  @@unique([tenantId, accessionNumber])
  @@index([tenantId])
  @@index([tenantId, bookId, status])
  @@map("library_copies")
}

/// A library patron. Prefer anchoring to a Student (libraryLoans/circulation then ride the
/// student's OWN scope); a User link lets faculty/staff (or self-service accounts) borrow too.
/// soft-deleted via deletedAt (loans/reservations/fines stay).
model LibraryMember {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberNumber    String              @map("member_number")
  studentId       String?             @map("student_id") @db.Uuid
  student         Student?            @relation(fields: [studentId], references: [id], onDelete: SetNull)
  userId          String?             @map("user_id") @db.Uuid
  user            User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName        String              @map("full_name")
  email           String?
  phone           String?
  memberType      LibraryMemberType   @default(STUDENT) @map("member_type")
  status          LibraryMemberStatus @default(ACTIVE)
  /// Per-member loan cap override of the LibraryConfig default.
  maxLoans        Int?                @map("max_loans")
  membershipStart DateTime?           @map("membership_start")
  membershipEnd   DateTime?           @map("membership_end")
  notes           String?
  createdBy       String?             @map("created_by")
  updatedBy       String?             @map("updated_by")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  deletedAt       DateTime?           @map("deleted_at")

  loans        StudentLibraryLoan[]
  reservations LibraryReservation[]
  fines        LibraryFine[]
  transactions LibraryTransaction[]

  @@unique([tenantId, memberNumber])
  @@unique([tenantId, studentId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, memberType])
  @@index([tenantId, deletedAt])
  @@map("library_members")
}

/// A member's claim on a title (or, once a librarian assigns one, on a specific copy).
/// WAITING â†’ READY (copy assigned / became available) â†’ FULFILLED (issued on that loan) /
/// CANCELLED / EXPIRED (holdUntil passed unused).
model LibraryReservation {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String                   @map("tenant_id") @db.Uuid
  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bookId      String                   @map("book_id") @db.Uuid
  book        LibraryBook              @relation(fields: [bookId], references: [id], onDelete: Restrict)
  copyId      String?                  @map("copy_id") @db.Uuid
  copy        LibraryCopy?             @relation(fields: [copyId], references: [id], onDelete: SetNull)
  memberId    String                   @map("member_id") @db.Uuid
  member      LibraryMember            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status      LibraryReservationStatus @default(WAITING)
  reservedAt  DateTime                 @default(now()) @map("reserved_at")
  /// When a READY hold lapses unattended (LibraryConfig.reservationHoldDays).
  holdUntil   DateTime?                @map("hold_until")
  fulfilledAt DateTime?                @map("fulfilled_at")
  cancelledBy String?                  @map("cancelled_by") @db.Uuid
  cancelledAt DateTime?                @map("cancelled_at")
  notes       String?
  createdBy   String?                  @map("created_by")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, memberId, status])
  @@index([tenantId, bookId, status])
  @@map("library_reservations")
}

/// Fines system of record â€” assessed for overdue (per LibraryConfig), lost or damaged copies.
/// Overdue fines start as a running estimate and are finalized on return; LOST/DAMAGE fines are
/// assessed against the book's replacement cost. Settled by PAID or WAIVED.
model LibraryFine {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  loanId         String?             @map("loan_id") @db.Uuid
  loan           StudentLibraryLoan? @relation(fields: [loanId], references: [id], onDelete: SetNull)
  memberId       String              @map("member_id") @db.Uuid
  member         LibraryMember       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type           LibraryFineType
  amountCents    Int                 @map("amount_cents")
  paidCents      Int                 @default(0) @map("paid_cents")
  status         LibraryFineStatus   @default(PENDING)
  reason         String?
  paidAt         DateTime?           @map("paid_at")
  paidByUserId   String?             @map("paid_by_user_id") @db.Uuid
  waivedAt       DateTime?           @map("waived_at")
  waivedByUserId String?             @map("waived_by_user_id") @db.Uuid
  createdBy      String?             @map("created_by")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, memberId, status])
  @@index([tenantId, status])
  @@index([loanId])
  @@map("library_fines")
}

/// Append-only per-copy inventory/circulation ledger â€” ADDED on acquisition, ISSUED/RETURNED/
/// RENEWED on circulation actions, DAMAGED/LOST/WITHDRAWN on condition/status changes. Feeds
/// the inventory tab and report aggregates without a separate cross-model timeline query.
model LibraryTransaction {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String                 @map("tenant_id") @db.Uuid
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  copyId      String                 @map("copy_id") @db.Uuid
  copy        LibraryCopy            @relation(fields: [copyId], references: [id], onDelete: Cascade)
  loanId      String?                @map("loan_id") @db.Uuid
  loan        StudentLibraryLoan?    @relation(fields: [loanId], references: [id], onDelete: SetNull)
  memberId    String?                @map("member_id") @db.Uuid
  member      LibraryMember?         @relation(fields: [memberId], references: [id], onDelete: SetNull)
  type        LibraryTransactionType
  occurredAt  DateTime               @default(now()) @map("occurred_at")
  actorUserId String?                @map("actor_user_id") @db.Uuid
  notes       String?
  metadata    Json?
  createdAt   DateTime               @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, copyId, occurredAt])
  @@index([tenantId, occurredAt])
  @@map("library_transactions")
}

/// Library-wide operating knobs â€” a single row per tenant, created lazily by the library module.
model LibraryConfig {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String   @unique @map("tenant_id") @db.Uuid
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  defaultLoanDays        Int      @default(14) @map("default_loan_days")
  maxLoansPerMember      Int      @default(5) @map("max_loans_per_member")
  renewalLimit           Int      @default(2) @map("renewal_limit")
  overdueFinePerDayCents Int      @default(100) @map("overdue_fine_per_day_cents")
  reservationHoldDays    Int      @default(2) @map("reservation_hold_days")
  createdBy              String?  @map("created_by")
  updatedBy              String?  @map("updated_by")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("library_configs")
}

/// Atomic per-tenant counter rows for member-number / copy-accession numbering (mirrors
/// FeeSequence). Allocation is update-increment inside the caller's $transaction.
model LibrarySequence {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  kind      LibrarySequenceKind
  prefix    String
  nextValue Int                 @default(1) @map("next_value")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@unique([tenantId, kind, prefix])
  @@map("library_sequences")
}

// ---------------------------------------------------------------------------
// Transport Management (Phase 8) — vehicles, drivers, routes/stops, trip runs,
// student passes & fees, maintenance, GPS tracking architecture, alerts & reports.
// The module lives in apps/api/src/modules/transport; the GPS provider abstraction
// in packages/gps (mock provider + registry + adapter protocol) is shared with the
// worker's scheduled GPS sweep (apps/worker/src/queues/transport-gps).
// ---------------------------------------------------------------------------

/// A school vehicle (bus/van/car) held on the transport register. registrationNumber is unique per
/// tenant. Status/paperwork are tracked here and mirrored into checked-in at trip dispatch time.
model TransportVehicle {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  campusId           String?                @map("campus_id") @db.Uuid
  campus             Campus?                @relation(fields: [campusId], references: [id], onDelete: SetNull)
  type               TransportVehicleType   @default(BUS)
  registrationNumber String                 @map("registration_number")
  chassisNumber      String?                @map("chassis_number")
  engineNumber       String?                @map("engine_number")
  make               String?
  model              String?
  yearOfManufacture  Int?                   @map("year_of_manufacture")
  fuelType           String?                @map("fuel_type")
  seatingCapacity    Int?                   @map("seating_capacity")
  standingCapacity   Int?                   @map("standing_capacity")
  isAc               Boolean                @default(false) @map("is_ac")
  /// GPS hardware/device id, when the vehicle is fitted. Polled by the GPS provider adapters.
  gpsDeviceId        String?                @map("gps_device_id")
  status             TransportVehicleStatus @default(IN_SERVICE)
  /// Derivable-at-read convenience flags (registration/fitness/insurance/permit expiry) are
  /// computed by the transport service's vehicle builder from its TransportVehicleDocument rows.
  createdBy          String?                @map("created_by")
  updatedBy          String?                @map("updated_by")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  deletedAt          DateTime?              @map("deleted_at")

  documents          TransportVehicleDocument[]
  driverAssignments  TransportDriverAssignment[]
  routes             TransportRoute[]
  trips              TransportTrip[]
  gpsPositions       TransportGPSPosition[]
  alerts             TransportAlert[]
  passAssignments    StudentTransportPass[]
  maintenanceRecords TransportMaintenanceRecord[]

  @@unique([tenantId, registrationNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("transport_vehicles")
}

/// A regulatory/ownership document attached to a vehicle (insurance, fitness cert, permit, PUC, …).
/// Uploaded files live in the shared Documents/storage infrastructure; this row carries the
/// storageKey + metadata. status is recomputed on read from expiryDate by the service builder.
model TransportVehicleDocument {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                  @map("tenant_id") @db.Uuid
  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicleId        String                  @map("vehicle_id") @db.Uuid
  vehicle          TransportVehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  documentType     TransportDocumentType   @map("document_type")
  documentNumber   String?                 @map("document_number")
  issueDate        DateTime?               @map("issue_date")
  expiryDate       DateTime?               @map("expiry_date")
  issuer           String?
  storageKey       String?                 @map("storage_key")
  originalFilename String?                 @map("original_filename")
  mimeType         String?                 @map("mime_type")
  sizeBytes        Int?                    @map("size_bytes")
  status           TransportDocumentStatus @default(VALID)
  remarks          String?
  createdBy        String?                 @map("created_by")
  updatedBy        String?                 @map("updated_by")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, documentType, status])
  @@map("transport_vehicle_documents")
}

/// A driver eligible to run a transport route. licenseNumber is unique per tenant. Optionally
/// linked to a User account (userId) so a driver can sign in and see their own trips.
model TransportDriver {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId          String?               @map("user_id") @db.Uuid
  user            User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  name            String
  phone           String?
  alternatePhone  String?               @map("alternate_phone")
  email           String?
  licenseNumber   String                @map("license_number")
  licenseClass    String?               @map("license_class")
  licenseExpiry   DateTime?             @map("license_expiry")
  profilePhotoKey String?               @map("profile_photo_key")
  joinedAt        DateTime?             @map("joined_at")
  status          TransportDriverStatus @default(ACTIVE)
  notes           String?
  createdBy       String?               @map("created_by")
  updatedBy       String?               @map("updated_by")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  deletedAt       DateTime?             @map("deleted_at")

  assignments     TransportDriverAssignment[]
  trips           TransportTrip[]
  passAssignments StudentTransportPass[]

  @@unique([tenantId, licenseNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("transport_drivers")
}

/// Assignment history of a driver to a fleet vehicle — currently riding/assigned vs released.
/// The route-level "who rides today" still lives on the trip's driverId; this is the persistent
/// driver↔vehicle fleet assignment ledger (and the source for roster planning).
model TransportDriverAssignment {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  driverId   String           @map("driver_id") @db.Uuid
  driver     TransportDriver  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId  String           @map("vehicle_id") @db.Uuid
  vehicle    TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  isActive   Boolean          @default(true) @map("is_active")
  assignedAt DateTime         @default(now()) @map("assigned_at")
  releasedAt DateTime?        @map("released_at")
  remarks    String?
  createdBy  String?          @map("created_by")
  updatedBy  String?          @map("updated_by")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, driverId, isActive])
  @@index([tenantId, vehicleId, isActive])
  @@map("transport_driver_assignments")
}

/// A scheduled school route between stops. Fee for the route is carried as monthlyFeeCents and is
/// charged onto the student fee ledger (StudentFee.transportPassId) when a pass is allocated.
model TransportRoute {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String               @map("tenant_id") @db.Uuid
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  campusId             String?              @map("campus_id") @db.Uuid
  campus               Campus?              @relation(fields: [campusId], references: [id], onDelete: SetNull)
  code                 String               @map("code")
  name                 String
  status               TransportRouteStatus @default(ACTIVE)
  distanceKm           Float?               @map("distance_km")
  estimatedDurationMin Int?                 @map("estimated_duration_min")
  monthlyFeeCents      Int?                 @map("monthly_fee_cents")
  description          String?
  isActive             Boolean              @default(true) @map("is_active")
  vehicleId            String?              @map("vehicle_id") @db.Uuid
  vehicle              TransportVehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  createdBy            String?              @map("created_by")
  updatedBy            String?              @map("updated_by")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  deletedAt            DateTime?            @map("deleted_at")

  stops           TransportStop[]
  trips           TransportTrip[]
  passAssignments StudentTransportPass[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("transport_routes")
}

/// Physical pick-up/drop-off point along a route, ordered by `order`. Coordinates are what the
/// GPS geofence evaluator compares against live vehicle positions. pickupTime/dropTime are local
/// clock strings ("07:30") defining the intended schedule for the associated leg/direction.
model TransportStop {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  routeId           String            @map("route_id") @db.Uuid
  route             TransportRoute    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name              String
  order             Int
  type              TransportStopType @default(PICKUP)
  address           String?
  latitude          Float?
  longitude         Float?
  pickupTime        String?           @map("pickup_time")
  dropTime          String?           @map("drop_time")
  reachRadiusMeters Int               @default(50) @map("reach_radius_meters")
  isActive          Boolean           @default(true) @map("is_active")
  createdBy         String?           @map("created_by")
  updatedBy         String?           @map("updated_by")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  deletedAt         DateTime?         @map("deleted_at")

  tripStops           TransportTripStop[]
  passAssignments     StudentTransportPass[] @relation("StudentPassPickupStop")
  dropPassAssignments StudentTransportPass[] @relation("StudentPassDropStop")

  @@unique([tenantId, routeId, order])
  @@index([tenantId])
  @@index([tenantId, routeId])
  @@map("transport_stops")
}

/// A planned/executed run of a route on a given date. Status moves SCHEDULED → ONGOING (driver
/// starts the route in the app) → COMPLETED; CANCELLED with a reason. GPS positions during the run
/// are linked through transportGpsPositions.tripId and alerts through transportAlerts.tripId.
model TransportTrip {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  routeId            String              @map("route_id") @db.Uuid
  route              TransportRoute      @relation(fields: [routeId], references: [id], onDelete: Restrict)
  vehicleId          String?             @map("vehicle_id") @db.Uuid
  vehicle            TransportVehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverId           String?             @map("driver_id") @db.Uuid
  driver             TransportDriver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  date               DateTime            @map("date")
  status             TransportTripStatus @default(SCHEDULED)
  scheduledDeparture DateTime?           @map("scheduled_departure")
  scheduledArrival   DateTime?           @map("scheduled_arrival")
  actualDepartureAt  DateTime?           @map("actual_departure_at")
  actualArrivalAt    DateTime?           @map("actual_arrival_at")
  distanceKm         Float?              @map("distance_km")
  cancelledAt        DateTime?           @map("cancelled_at")
  cancelReason       String?             @map("cancel_reason")
  remarks            String?
  createdBy          String?             @map("created_by")
  updatedBy          String?             @map("updated_by")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  tripStops    TransportTripStop[]
  gpsPositions TransportGPSPosition[]
  alerts       TransportAlert[]

  @@unique([tenantId, routeId, date])
  @@index([tenantId])
  @@index([tenantId, routeId, date])
  @@index([tenantId, vehicleId, date])
  @@index([tenantId, status])
  @@map("transport_trips")
}

/// Per-stop checkpoints of a trip run (used for route tracking: boarded/alighted counts, actual
/// arrival/departure, skipped stops).
model TransportTripStop {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tripId            String        @map("trip_id") @db.Uuid
  trip              TransportTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  stopId            String        @map("stop_id") @db.Uuid
  stop              TransportStop @relation(fields: [stopId], references: [id], onDelete: Restrict)
  order             Int
  scheduledTime     DateTime?     @map("scheduled_time")
  actualArrivalAt   DateTime?     @map("actual_arrival_at")
  actualDepartureAt DateTime?     @map("actual_departure_at")
  studentsBoarded   Int           @default(0) @map("students_boarded")
  studentsAlighted  Int           @default(0) @map("students_alighted")
  skipped           Boolean       @default(false)
  notes             String?

  @@index([tenantId])
  @@index([tenantId, tripId])
  @@map("transport_trip_stops")
}

/// Fleet maintenance/repair record for a vehicle.
model TransportMaintenanceRecord {
  id            String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String                     @map("tenant_id") @db.Uuid
  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicleId     String                     @map("vehicle_id") @db.Uuid
  vehicle       TransportVehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type          TransportMaintenanceType
  status        TransportMaintenanceStatus @default(SCHEDULED)
  scheduledDate DateTime?                  @map("scheduled_date")
  startedAt     DateTime?                  @map("started_at")
  completedAt   DateTime?                  @map("completed_at")
  odometerKm    Int?                       @map("odometer_km")
  description   String?
  vendor        String?
  costCents     Int?                       @map("cost_cents")
  performedBy   String?                    @map("performed_by")
  notes         String?
  createdBy     String?                    @map("created_by")
  updatedBy     String?                    @map("updated_by")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, status])
  @@map("transport_maintenance_records")
}

/// One GPS fix for a vehicle. Written either by the ingress endpoint (device/provider push),
/// by an on-demand poll from the transport module's GPS service, or by the worker's scheduled
/// polling sweep (both of which route through the shared packages/gps provider abstraction).
model TransportGPSPosition {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicleId      String           @map("vehicle_id") @db.Uuid
  vehicle        TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tripId         String?          @map("trip_id") @db.Uuid
  trip           TransportTrip?   @relation(fields: [tripId], references: [id], onDelete: SetNull)
  latitude       Float
  longitude      Float
  speedKmh       Float?           @map("speed_kmh")
  heading        Int?             @map("heading")
  accuracyMeters Float?           @map("accuracy_meters")
  recordedAt     DateTime         @default(now()) @map("recorded_at")
  source         String           @default("mock")
  rawData        Json?            @map("raw_data")

  @@index([tenantId])
  @@index([tenantId, vehicleId, recordedAt])
  @@index([tenantId, tripId, recordedAt])
  @@map("transport_gps_positions")
}

/// A transport alert — GPS-derived (SPEEDING/OFF_ROUTE/GEOFENCE from the sweep/ingress pipeline)
/// or operator/flag-driven (MAINTENANCE_DUE/DOCUMENT_EXPIRING/DELAYED/OTHER). CRITICAL alerts are
/// fanned out to transport-manager users as notifications on creation.
model TransportAlert {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String                 @map("tenant_id") @db.Uuid
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicleId            String?                @map("vehicle_id") @db.Uuid
  vehicle              TransportVehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  tripId               String?                @map("trip_id") @db.Uuid
  trip                 TransportTrip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  type                 TransportAlertType
  severity             TransportAlertSeverity
  title                String
  message              String
  latitude             Float?
  longitude            Float?
  meta                 Json?
  acknowledgedAt       DateTime?              @map("acknowledged_at")
  acknowledgedByUserId String?                @map("acknowledged_by_user_id")
  resolvedAt           DateTime?              @map("resolved_at")
  resolvedByUserId     String?                @map("resolved_by_user_id")
  resolution           String?
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, severity, resolvedAt])
  @@index([tenantId, vehicleId, createdAt])
  @@index([tenantId, tripId])
  @@map("transport_alerts")
}

/// Per-tenant GPS provider wiring — which provider adapter the tenant's vehicles are tracked
/// through, whether polling is enabled, and provider-specific settings. This is what keeps the
/// GPS integration provider-agnostic: adding a vendor means registering an adapter implementing
/// the TransportGpsProvider interface in packages/gps, not touching the module's data model.
model TransportGpsConfig {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @unique @map("tenant_id") @db.Uuid
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  provider            String    @default("mock")
  enabled             Boolean   @default(false)
  pollEnabled         Boolean   @default(false) @map("poll_enabled")
  pollIntervalSeconds Int       @default(30) @map("poll_interval_seconds")
  settings            Json?
  lastPolledAt        DateTime? @map("last_polled_at")
  createdBy           String?   @map("created_by")
  updatedBy           String?   @map("updated_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("transport_gps_configs")
}

/// HR module — Phase 9 (HR + placements + analytics). All models are tenant-scoped and follow
/// the standard soft-delete / audit-column conventions used across the schema.
/// Reused existing infrastructure: FacultyAttendance (HR/faculty daily attendance),
/// TimetableEntry.assignedUserId (faculty timetable), Department/Campus/User/Term master data.
enum EmployeeType {
  FACULTY
  STAFF
  ADMIN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  VISITING
  ADJUNCT
  INTERN
}

enum EmployeeEmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  RESIGNED
  RETIRED
  TERMINATED
}

enum JoiningStatus {
  PENDING
  ONBOARDED
  CONFIRMED
  CLOSED
}

enum EmployeeExitType {
  RESIGNATION
  RETIREMENT
  TERMINATION
  END_OF_CONTRACT
  MUTUAL_SEPARATION
}

enum EmployeeDocumentType {
  APPOINTMENT_LETTER
  OFFER_LETTER
  ID_PROOF
  EDUCATIONAL_CERTIFICATE
  EXPERIENCE_LETTER
  PAYSLIP
  RELIEVING_LETTER
  NO_DUE_CERTIFICATE
  OTHER
}

enum FacultyWorkloadType {
  TEACHING
  ADMINISTRATIVE
  RESEARCH
  EXAM_DUTY
  EXTENSION
  OTHER
}

enum LeaveCategory {
  CASUAL
  SICK
  EARNED
  MATERNITY
  PATERNITY
  UNPAID
  HALF_DAY
  COMPENSATORY
  SPECIAL
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PerformanceReviewType {
  SELF
  SUPERVISOR
  PEER
  COMMITTEE
}

enum PerformanceReviewStatus {
  DRAFT
  SUBMITTED
  APPROVED
  COMPLETED
  REJECTED
}

enum PayrollRunStatus {
  DRAFT
  PROCESSING
  PROCESSED
  APPROVED
  PAID
  CANCELLED
}

enum PayrollRunLineStatus {
  DRAFT
  PROCESSED
  APPROVED
  PAID
  CANCELLED
}

/// Master record for every employee (faculty, staff, admin) in a tenant. `userId` links the
/// employee to a platform login (invited via the users module) when one exists, otherwise the
/// employee exists standalone. Soft-deleted via `deletedAt` — exit records are kept on
/// `employee_exits` and the master row is deactivated instead of purged.
model Employee {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String                   @map("tenant_id") @db.Uuid
  tenant                   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employeeCode             String                   @map("employee_code")
  userId                   String?                  @unique @map("user_id") @db.Uuid
  user                     User?                    @relation("UserEmployeeProfile", fields: [userId], references: [id], onDelete: SetNull)
  employeeType             EmployeeType             @default(FACULTY) @map("employee_type")
  honorific                String?
  firstName                String                   @map("first_name")
  middleName               String?                  @map("middle_name")
  lastName                 String                   @map("last_name")
  gender                   String?
  dateOfBirth              DateTime?                @map("date_of_birth") @db.Date
  personalEmail            String?                  @map("personal_email")
  phone                    String?
  alternatePhone           String?                  @map("alternate_phone")
  addressLine1             String?                  @map("address_line1")
  addressLine2             String?                  @map("address_line2")
  city                     String?
  state                    String?
  postalCode               String?                  @map("postal_code")
  country                  String?                  @default("India")
  departmentId             String                   @map("department_id") @db.Uuid
  department               Department               @relation("EmployeeDepartments", fields: [departmentId], references: [id], onDelete: Restrict)
  designationId            String?                  @map("designation_id") @db.Uuid
  designation              HrDesignation?           @relation("DesignationEmployees", fields: [designationId], references: [id], onDelete: SetNull)
  campusId                 String?                  @map("campus_id") @db.Uuid
  campus                   Campus?                  @relation("EmployeeCampuses", fields: [campusId], references: [id], onDelete: SetNull)
  reportingToId            String?                  @map("reporting_to_id") @db.Uuid
  reportingTo              Employee?                @relation("EmployeeReportsTo", fields: [reportingToId], references: [id], onDelete: SetNull)
  reports                  Employee[]               @relation("EmployeeReportsTo")
  employmentType           EmploymentType           @default(FULL_TIME) @map("employment_type")
  employmentStatus         EmployeeEmploymentStatus @default(ACTIVE) @map("employment_status")
  joinDate                 DateTime?                @map("join_date") @db.Date
  confirmationDate         DateTime?                @map("confirmation_date") @db.Date
  exitDate                 DateTime?                @map("exit_date") @db.Date
  emergencyContactName     String?                  @map("emergency_contact_name")
  emergencyContactPhone    String?                  @map("emergency_contact_phone")
  emergencyContactRelation String?                  @map("emergency_contact_relation")
  panNumber                String?                  @map("pan_number")
  aadhaarNumber            String?                  @map("aadhaar_number")
  bankAccountNumber        String?                  @map("bank_account_number")
  bankName                 String?                  @map("bank_name")
  bankIfsc                 String?                  @map("bank_ifsc")
  uanNumber                String?                  @map("uan_number")
  qualification            String?
  specialization           String?
  profilePhotoKey          String?                  @map("profile_photo_key")
  notes                    String?
  createdBy                String?                  @map("created_by")
  updatedBy                String?                  @map("updated_by")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  deletedAt                DateTime?                @map("deleted_at")

  joinings                  EmployeeJoining[]
  exits                     EmployeeExit[]
  documents                 EmployeeDocument[]
  workloads                 FacultyWorkload[]
  leaveBalances             LeaveBalance[]
  leaveApplications         LeaveApplication[]
  performanceReviews        EmployeePerformanceReview[]
  salaryStructures          SalaryStructure[]
  payrollLines              PayrollRunLine[]
  inventoryAssetAssignments InventoryAssetAssignment[]  @relation("InventoryAssetEmployeeAssignees")

  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@index([tenantId, designationId])
  @@index([tenantId, campusId])
  @@index([tenantId, employeeType])
  @@index([tenantId, employmentStatus])
  @@index([tenantId, deletedAt])
  @@map("employees")
}

/// Role designations (Professor, Assistant Professor, Accountant, ...). Optional department
/// binding; empty department means the designation applies tenant-wide.
model HrDesignation {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departmentId String?     @map("department_id") @db.Uuid
  department   Department? @relation("DepartmentHrDesignations", fields: [departmentId], references: [id], onDelete: SetNull)
  code         String
  name         String
  description  String?
  rank         Int         @default(0)
  isActive     Boolean     @default(true) @map("is_active")
  createdBy    String?     @map("created_by")
  updatedBy    String?     @map("updated_by")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")

  employees Employee[] @relation("DesignationEmployees")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, departmentId])
  @@index([tenantId, deletedAt])
  @@map("hr_designations")
}

/// Recruitment / onboarding record. Onboarding an employee (joining status ONBOARDED) stamps
/// `joinDate` on the related Employee master row.
model EmployeeJoining {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employeeId       String        @map("employee_id") @db.Uuid
  employee         Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  joiningStatus    JoiningStatus @default(PENDING) @map("joining_status")
  offerDate        DateTime?     @map("offer_date") @db.Date
  effectiveDate    DateTime?     @map("effective_date") @db.Date
  probationMonths  Int?          @map("probation_months")
  confirmationDate DateTime?     @map("confirmation_date") @db.Date
  remarks          String?
  createdBy        String?       @map("created_by")
  updatedBy        String?       @map("updated_by")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("employee_joinings")
}

/// Offboarding / exit record. Recording an exit deactivates the employee master row (sets
/// `exitDate` + employmentStatus) so exits are auditable history, never a hard delete.
model EmployeeExit {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employeeId         String           @map("employee_id") @db.Uuid
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  exitType           EmployeeExitType @map("exit_type")
  effectiveDate      DateTime?        @map("effective_date") @db.Date
  lastWorkingDate    DateTime?        @map("last_working_date") @db.Date
  noticePeriodDays   Int?             @map("notice_period_days")
  relievingDate      DateTime?        @map("relieving_date") @db.Date
  reason             String?
  noDueStatus        String?          @default("PENDING") @map("no_due_status")
  noDueClearedAt     DateTime?        @map("no_due_cleared_at")
  relievingLetterKey String?          @map("relieving_letter_key")
  settlementAmount   Decimal?         @map("settlement_amount") @db.Decimal(12, 2)
  remarks            String?
  createdBy          String?          @map("created_by")
  updatedBy          String?          @map("updated_by")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, exitType])
  @@map("employee_exits")
}

/// Employee documents. `fileKey` points at a StorageService (S3/MinIO) object and the file is
/// uploaded via a signed URL — the same flow the documents/students module uses. PAYSLIP type
/// rows can be linked from a PayrollRunLine.
model EmployeeDocument {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employeeId       String               @map("employee_id") @db.Uuid
  employee         Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType     EmployeeDocumentType @map("document_type")
  title            String?
  description      String?
  fileKey          String?              @map("file_key")
  contentType      String?              @map("content_type")
  sizeBytes        Int?                 @map("size_bytes")
  uploadedByUserId String?              @map("uploaded_by_user_id") @db.Uuid
  uploadedByUser   User?                @relation("HrDocumentUploaders", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  isVerified       Boolean              @default(false) @map("is_verified")
  verifiedByUserId String?              @map("verified_by_user_id")
  verifiedAt       DateTime?            @map("verified_at")
  createdBy        String?              @map("created_by")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  payslipLines PayrollRunLine[] @relation("PayslipDocuments")

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, documentType])
  @@map("employee_documents")
}

/// Faculty workload allocations per term. Teaching workload can additionally be derived from
/// timetables (TimetableEntry.assignedUserId) — this table covers the non-timetable breakdown.
model FacultyWorkload {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employeeId    String              @map("employee_id") @db.Uuid
  employee      Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  termId        String?             @map("term_id") @db.Uuid
  term          Term?               @relation("TermFacultyWorkloads", fields: [termId], references: [id], onDelete: SetNull)
  workloadType  FacultyWorkloadType @map("workload_type")
  title         String
  description   String?
  hoursPerWeek  Float               @default(0) @map("hours_per_week")
  effectiveFrom DateTime?           @map("effective_from") @db.Date
  effectiveTo   DateTime?           @map("effective_to") @db.Date
  isActive      Boolean             @default(true) @map("is_active")
  createdBy     String?             @map("created_by")
  updatedBy     String?             @map("updated_by")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, employeeId, termId])
  @@index([tenantId, workloadType])
  @@map("faculty_workloads")
}

/// Leave catalogue (CASUAL, SICK, EARNED, ...). Tenant-owned master data.
model LeaveType {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code             String
  name             String
  category         LeaveCategory @map("category")
  description      String?
  color            String?       @default("#3b82f6")
  maxDaysPerYear   Int?          @map("max_days_per_year")
  isPaid           Boolean       @default(true) @map("is_paid")
  requiresApproval Boolean       @default(true) @map("requires_approval")
  isActive         Boolean       @default(true) @map("is_active")
  createdBy        String?       @map("created_by")
  updatedBy        String?       @map("updated_by")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  leaveBalances     LeaveBalance[]
  leaveApplications LeaveApplication[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("leave_types")
}

/// Per-employee, per-year running leave ledger for one leave type.
model LeaveBalance {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employeeId     String    @map("employee_id") @db.Uuid
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId    String    @map("leave_type_id") @db.Uuid
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year           Int
  openingBalance Float     @default(0) @map("opening_balance")
  creditedDays   Float     @default(0) @map("credited_days")
  availedDays    Float     @default(0) @map("availed_days")
  adjustedDays   Float     @default(0) @map("adjusted_days")
  closingBalance Float?    @map("closing_balance")
  createdBy      String?   @map("created_by")
  updatedBy      String?   @map("updated_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, employeeId, leaveTypeId, year])
  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@map("leave_balances")
}

/// A leave application. Approving/rejecting decrements or restores the applicant's LeaveBalance
/// availedDays. `createdBy` holds the requesting user id (the employee may not have a login).
model LeaveApplication {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employeeId       String      @map("employee_id") @db.Uuid
  employee         Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId      String      @map("leave_type_id") @db.Uuid
  leaveType        LeaveType   @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  fromDate         DateTime    @map("from_date") @db.Date
  toDate           DateTime    @map("to_date") @db.Date
  durationDays     Float       @map("duration_days")
  halfDayOption    String?     @map("half_day_option")
  reason           String?
  attachmentKey    String?     @map("attachment_key")
  status           LeaveStatus @default(PENDING) @map("status")
  approvedByUserId String?     @map("approved_by_user_id") @db.Uuid
  approvedByUser   User?       @relation("LeaveApplicationApprovers", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  decidedAt        DateTime?   @map("decided_at")
  decisionRemarks  String?     @map("decision_remarks")
  createdBy        String?     @map("created_by")
  updatedBy        String?     @map("updated_by")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, employeeId, status])
  @@index([tenantId, status, fromDate])
  @@map("leave_applications")
}

/// Performance review (self/supervisor/peer/committee). Optional score 0–9.99, JSON goals.
model EmployeePerformanceReview {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String                  @map("tenant_id") @db.Uuid
  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employeeId          String                  @map("employee_id") @db.Uuid
  employee            Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewPeriodStart   DateTime?               @map("review_period_start") @db.Date
  reviewPeriodEnd     DateTime?               @map("review_period_end") @db.Date
  reviewType          PerformanceReviewType   @map("review_type")
  status              PerformanceReviewStatus @default(DRAFT) @map("status")
  score               Decimal?                @db.Decimal(3, 2)
  goals               Json?
  achievements        String?
  areasForImprovement String?                 @map("areas_for_improvement")
  overallComments     String?                 @map("overall_comments")
  reviewerUserId      String?                 @map("reviewer_user_id") @db.Uuid
  reviewerUser        User?                   @relation("PerformanceReviewers", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  reviewedAt          DateTime?               @map("reviewed_at")
  createdBy           String?                 @map("created_by")
  updatedBy           String?                 @map("updated_by")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, status, reviewType])
  @@map("employee_performance_reviews")
}

/// Pay bands / compensation for an employee over a period. allowances & deductions are JSON
/// arrays of { head, amount }. Payroll lines snapshot gross/net from the active structure.
model SalaryStructure {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employeeId    String    @map("employee_id") @db.Uuid
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime? @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  basicAmount   Decimal   @map("basic_amount") @db.Decimal(12, 2)
  hraAmount     Decimal   @default(0) @map("hra_amount") @db.Decimal(12, 2)
  allowances    Json?
  deductions    Json?
  grossAmount   Decimal   @map("gross_amount") @db.Decimal(12, 2)
  netAmount     Decimal   @map("net_amount") @db.Decimal(12, 2)
  isActive      Boolean   @default(true) @map("is_active")
  createdBy     String?   @map("created_by")
  updatedBy     String?   @map("updated_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  payrollLines PayrollRunLine[]

  @@index([tenantId])
  @@index([tenantId, employeeId, isActive])
  @@index([tenantId, employeeId, effectiveFrom])
  @@map("salary_structures")
}

/// A monthly payroll run for a tenant. One run per tenant/month/year. Processing materializes
/// PayrollRunLine rows from active salary structures; approving locks the run.
model PayrollRun {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  month             Int
  year              Int
  title             String?
  status            PayrollRunStatus @default(DRAFT) @map("status")
  processedByUserId String?          @map("processed_by_user_id") @db.Uuid
  processedByUser   User?            @relation("PayrollRunProcessors", fields: [processedByUserId], references: [id], onDelete: SetNull)
  approvedByUserId  String?          @map("approved_by_user_id") @db.Uuid
  approvedByUser    User?            @relation("PayrollRunApprovers", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  processedAt       DateTime?        @map("processed_at")
  approvedAt        DateTime?        @map("approved_at")
  notes             String?
  createdBy         String?          @map("created_by")
  updatedBy         String?          @map("updated_by")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  lines PayrollRunLine[]

  @@unique([tenantId, month, year])
  @@index([tenantId])
  @@index([tenantId, status, year])
  @@map("payroll_runs")
}

/// Per-employee line of a payroll run. Payslips are stored as PAYSLIP-type EmployeeDocument
/// rows; field `payslipDocumentId` links them so payroll integrates with the document store.
model PayrollRunLine {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  runId             String               @map("run_id") @db.Uuid
  run               PayrollRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId        String               @map("employee_id") @db.Uuid
  employee          Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  salaryStructureId String?              @map("salary_structure_id") @db.Uuid
  salaryStructure   SalaryStructure?     @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)
  daysWorked        Int?                 @map("days_worked")
  grossAmount       Decimal              @map("gross_amount") @db.Decimal(12, 2)
  totalDeductions   Decimal              @default(0) @map("total_deductions") @db.Decimal(12, 2)
  netAmount         Decimal              @map("net_amount") @db.Decimal(12, 2)
  earnings          Json?
  deductions        Json?
  status            PayrollRunLineStatus @default(DRAFT) @map("status")
  paidAt            DateTime?            @map("paid_at")
  payslipDocumentId String?              @map("payslip_document_id") @db.Uuid
  payslipDocument   EmployeeDocument?    @relation("PayslipDocuments", fields: [payslipDocumentId], references: [id], onDelete: SetNull)
  referenceNumber   String?              @map("reference_number")
  createdBy         String?              @map("created_by")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, runId])
  @@index([tenantId, employeeId])
  @@map("payroll_run_lines")
}

// ---------------------------------------------------------------------------
// PLACEMENTS
// ---------------------------------------------------------------------------

/// Enterprise/company master for the placement cell. Companies are lightweight master
/// records the placement office maintains (they are NOT user accounts).
enum PlacementCompanyType {
  MNC
  INDIAN_MNC
  STARTUP
  PSU
  CORPORATE
  SME
  GOVT_ORG
  NGO
  OTHER
}

/// How a placement drive is conducted.
enum PlacementDriveMode {
  ON_CAMPUS
  OFF_CAMPUS
  VIRTUAL
}

/// Lifecycle of a placement drive.
enum PlacementDriveStatus {
  DRAFT
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum PlacementPositionType {
  FULL_TIME
  INTERNSHIP
  CONTRACT
  TRAINEE
}

/// Eligibility state of a student against a drive/position.
enum PlacementEligibilityStatus {
  PENDING
  ELIGIBLE
  NOT_ELIGIBLE
  EXEMPTED
}

enum PlacementApplicationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
  WITHDRAWN
}

enum PlacementRoundType {
  APTITUDE_TEST
  TECHNICAL_TEST
  PSYCHOMETRIC_TEST
  GROUP_DISCUSSION
  TECHNICAL_INTERVIEW
  HR_INTERVIEW
  MANAGERIAL_INTERVIEW
  CASE_STUDY
  OTHER
}

enum PlacementRoundStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

/// Outcome of a student in a round.
enum PlacementRoundResultStatus {
  PENDING
  SELECTED
  REJECTED
  ON_HOLD
  ABSENT
}

enum PlacementOfferStatus {
  ISSUED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum PlacementJoiningStatus {
  PENDING
  JOINED
  NOT_JOINED
  POSTPONED
}

/// Final placement state of a student for an academic year.
enum PlacementOutcomeStatus {
  PLACED
  NOT_PLACED
  OPTED_OUT
  UNREGISTERED
}

/// Recruiting company the placement office works with.
model PlacementCompany {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code             String
  name             String
  companyType      PlacementCompanyType @default(OTHER) @map("company_type")
  industry         String?
  website          String?
  description      String?
  headquartersCity String?              @map("headquarters_city")
  addressLine1     String?              @map("address_line_1")
  addressLine2     String?              @map("address_line_2")
  city             String?
  state            String?
  country          String?              @default("India")
  isActive         Boolean              @default(true) @map("is_active")
  createdBy        String?              @map("created_by")
  updatedBy        String?              @map("updated_by")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  deletedAt        DateTime?            @map("deleted_at")

  contacts PlacementContact[]
  drives   PlacementDrive[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@map("placement_companies")
}

/// People at a PlacementCompany the placement cell coordinates with.
model PlacementContact {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  companyId   String           @map("company_id") @db.Uuid
  company     PlacementCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fullName    String           @map("full_name")
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean          @default(false) @map("is_primary")
  isActive    Boolean          @default(true) @map("is_active")
  createdBy   String?          @map("created_by")
  updatedBy   String?          @map("updated_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  companyCoordinate PlacementDrive[] @relation("PlacementDriveCoordinators")

  @@index([tenantId])
  @@index([companyId])
  @@index([tenantId, deletedAt])
  @@map("placement_contacts")
}

/// A placement drive: a batch of positions (PlacementPosition) run for one company.
model PlacementDrive {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String               @map("tenant_id") @db.Uuid
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  companyId            String               @map("company_id") @db.Uuid
  company              PlacementCompany     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  code                 String
  title                String
  description          String?
  mode                 PlacementDriveMode   @default(ON_CAMPUS)
  status               PlacementDriveStatus @default(DRAFT)
  driveDate            DateTime?            @map("drive_date")
  applicationDeadline  DateTime?            @map("application_deadline")
  venue                String?
  coordinatorContactId String?              @map("coordinator_contact_id") @db.Uuid
  coordinatorContact   PlacementContact?    @relation("PlacementDriveCoordinators", fields: [coordinatorContactId], references: [id], onDelete: SetNull)
  eligibilityNotes     String?              @map("eligibility_notes")
  createdBy            String?              @map("created_by")
  updatedBy            String?              @map("updated_by")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  deletedAt            DateTime?            @map("deleted_at")

  positions    PlacementPosition[]
  eligibility  PlacementEligibility[]
  applications PlacementApplication[]
  rounds       PlacementRound[]
  selections   PlacementSelection[]
  offers       PlacementOffer[]
  joinings     PlacementJoining[]
  outcomes     PlacementOutcome[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([companyId])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("placement_drives")
}

/// A concrete job/position being hired for as part of a drive. Holds the eligibility
/// criteria (minCgpa/minPercentage/maxBacklogs) used to evaluate student eligibility.
model PlacementPosition {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String                @map("tenant_id") @db.Uuid
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  driveId       String                @map("drive_id") @db.Uuid
  drive         PlacementDrive        @relation(fields: [driveId], references: [id], onDelete: Cascade)
  title         String
  positionType  PlacementPositionType @default(FULL_TIME) @map("position_type")
  location      String?
  openings      Int?                  @default(1)
  description   String?
  minCgpa       Float?                @map("min_cgpa")
  minPercentage Float?                @map("min_percentage")
  maxBacklogs   Int?                  @map("max_backlogs")
  packageCents  Int?                  @map("package_cents")
  packageNotes  String?               @map("package_notes")
  isActive      Boolean               @default(true) @map("is_active")
  createdBy     String?               @map("created_by")
  updatedBy     String?               @map("updated_by")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  deletedAt     DateTime?             @map("deleted_at")

  eligibility  PlacementEligibility[]
  applications PlacementApplication[]
  selections   PlacementSelection[]
  offers       PlacementOffer[]
  outcomes     PlacementOutcome[]

  @@index([tenantId])
  @@index([driveId])
  @@index([tenantId, deletedAt])
  @@map("placement_positions")
}

/// Pre-computed eligibility of a student for a drive/position. `criteriaSnapshot` and
/// `studentSnapshot` freeze what was evaluated so results are auditable after the fact.
model PlacementEligibility {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                     @map("tenant_id") @db.Uuid
  tenant            Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  driveId           String                     @map("drive_id") @db.Uuid
  drive             PlacementDrive             @relation(fields: [driveId], references: [id], onDelete: Cascade)
  positionId        String                     @map("position_id") @db.Uuid
  position          PlacementPosition          @relation(fields: [positionId], references: [id], onDelete: Cascade)
  studentId         String                     @map("student_id") @db.Uuid
  student           Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status            PlacementEligibilityStatus @default(PENDING)
  criteriaSnapshot  Json?                      @map("criteria_snapshot")
  studentSnapshot   Json?                      @map("student_snapshot")
  remarks           String?
  evaluatedByUserId String?                    @map("evaluated_by_user_id") @db.Uuid
  evaluatedAt       DateTime?                  @map("evaluated_at")
  createdBy         String?                    @map("created_by")
  updatedBy         String?                    @map("updated_by")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  @@unique([tenantId, driveId, positionId, studentId])
  @@index([tenantId])
  @@index([studentId])
  @@index([driveId])
  @@index([positionId])
  @@map("placement_eligibility")
}

/// A student's resume / CV document kept for placement applications. Stored as a signed-URL
/// object key (like EmployeeDocument); uploaded by either the student or staff.
model PlacementResume {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId        String    @map("student_id") @db.Uuid
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title            String
  fileKey          String    @map("file_key")
  contentType      String?   @map("content_type")
  sizeBytes        Int?      @map("size_bytes")
  isPrimary        Boolean   @default(false) @map("is_primary")
  uploadedByUserId String?   @map("uploaded_by_user_id") @db.Uuid
  createdBy        String?   @map("created_by")
  updatedBy        String?   @map("updated_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  applications PlacementApplication[]

  @@index([tenantId])
  @@index([studentId])
  @@index([tenantId, deletedAt])
  @@map("placement_resumes")
}

/// A student's application to a specific position in a drive.
model PlacementApplication {
  id            String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String                     @map("tenant_id") @db.Uuid
  tenant        Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  driveId       String                     @map("drive_id") @db.Uuid
  drive         PlacementDrive             @relation(fields: [driveId], references: [id], onDelete: Restrict)
  positionId    String                     @map("position_id") @db.Uuid
  position      PlacementPosition          @relation(fields: [positionId], references: [id], onDelete: Restrict)
  studentId     String                     @map("student_id") @db.Uuid
  student       Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  resumeId      String?                    @map("resume_id") @db.Uuid
  resume        PlacementResume?           @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  status        PlacementApplicationStatus @default(APPLIED)
  appliedAt     DateTime                   @default(now()) @map("applied_at")
  shortlistedAt DateTime?                  @map("shortlisted_at")
  rejectedAt    DateTime?                  @map("rejected_at")
  withdrawnAt   DateTime?                  @map("withdrawn_at")
  remarks       String?
  createdBy     String?                    @map("created_by")
  updatedBy     String?                    @map("updated_by")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")

  roundResults PlacementRoundResult[]
  selection    PlacementSelection?
  offer        PlacementOffer?

  @@unique([tenantId, driveId, positionId, studentId])
  @@index([tenantId])
  @@index([driveId])
  @@index([positionId])
  @@index([studentId])
  @@index([tenantId, status])
  @@map("placement_applications")
}

/// An interview/test round within a drive. Results per student live in PlacementRoundResult.
model PlacementRound {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  driveId        String               @map("drive_id") @db.Uuid
  drive          PlacementDrive       @relation(fields: [driveId], references: [id], onDelete: Cascade)
  sequence       Int
  roundType      PlacementRoundType   @default(OTHER) @map("round_type")
  title          String?
  scheduledAt    DateTime?            @map("scheduled_at")
  locationOrLink String?              @map("location_or_link")
  status         PlacementRoundStatus @default(SCHEDULED)
  notes          String?
  createdBy      String?              @map("created_by")
  updatedBy      String?              @map("updated_by")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  deletedAt      DateTime?            @map("deleted_at")

  results PlacementRoundResult[]

  @@unique([tenantId, driveId, sequence])
  @@index([tenantId])
  @@index([driveId])
  @@map("placement_rounds")
}

/// Per-student outcome for a specific placement round.
model PlacementRoundResult {
  id               String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                     @map("tenant_id") @db.Uuid
  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roundId          String                     @map("round_id") @db.Uuid
  round            PlacementRound             @relation(fields: [roundId], references: [id], onDelete: Cascade)
  applicationId    String                     @map("application_id") @db.Uuid
  application      PlacementApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  result           PlacementRoundResultStatus @default(PENDING)
  score            Float?
  feedback         String?
  assessedByUserId String?                    @map("assessed_by_user_id") @db.Uuid
  assessedAt       DateTime?                  @map("assessed_at")
  createdBy        String?                    @map("created_by")
  updatedBy        String?                    @map("updated_by")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")

  @@unique([tenantId, roundId, applicationId])
  @@index([tenantId])
  @@index([roundId])
  @@index([applicationId])
  @@map("placement_round_results")
}

/// A student selected for a position (post-rounds) before an offer is issued.
model PlacementSelection {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  driveId          String               @map("drive_id") @db.Uuid
  drive            PlacementDrive       @relation(fields: [driveId], references: [id], onDelete: Restrict)
  positionId       String               @map("position_id") @db.Uuid
  position         PlacementPosition    @relation(fields: [positionId], references: [id], onDelete: Restrict)
  applicationId    String               @unique @map("application_id") @db.Uuid
  application      PlacementApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  studentId        String               @map("student_id") @db.Uuid
  student          Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  selectedByUserId String?              @map("selected_by_user_id") @db.Uuid
  selectedAt       DateTime             @default(now()) @map("selected_at")
  notes            String?
  createdBy        String?              @map("created_by")
  updatedBy        String?              @map("updated_by")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  offer PlacementOffer?

  @@unique([tenantId, applicationId])
  @@index([tenantId])
  @@index([driveId])
  @@index([positionId])
  @@index([studentId])
  @@map("placement_selections")
}

/// Offer letter issued to a student for a drive/position after selection.
model PlacementOffer {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  driveId           String               @map("drive_id") @db.Uuid
  drive             PlacementDrive       @relation(fields: [driveId], references: [id], onDelete: Restrict)
  positionId        String               @map("position_id") @db.Uuid
  position          PlacementPosition    @relation(fields: [positionId], references: [id], onDelete: Restrict)
  applicationId     String               @unique @map("application_id") @db.Uuid
  application       PlacementApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  selectionId       String?              @unique @map("selection_id") @db.Uuid
  selection         PlacementSelection?  @relation(fields: [selectionId], references: [id], onDelete: SetNull)
  studentId         String               @map("student_id") @db.Uuid
  student           Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  offerLetterNumber String               @map("offer_letter_number")
  packageCents      Int?                 @map("package_cents")
  joiningLocation   String?              @map("joining_location")
  status            PlacementOfferStatus @default(ISSUED)
  issuedAt          DateTime             @default(now()) @map("issued_at")
  acceptedAt        DateTime?            @map("accepted_at")
  declinedAt        DateTime?            @map("declined_at")
  expiryDate        DateTime?            @map("expiry_date")
  notes             String?
  createdBy         String?              @map("created_by")
  updatedBy         String?              @map("updated_by")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  deletedAt         DateTime?            @map("deleted_at")

  joining  PlacementJoining?
  outcomes PlacementOutcome[]

  @@unique([tenantId, offerLetterNumber])
  @@index([tenantId])
  @@index([driveId])
  @@index([positionId])
  @@index([studentId])
  @@index([tenantId, status])
  @@map("placement_offers")
}

/// Joining details after an accepted offer.
model PlacementJoining {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String                 @map("tenant_id") @db.Uuid
  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  driveId             String                 @map("drive_id") @db.Uuid
  drive               PlacementDrive         @relation(fields: [driveId], references: [id], onDelete: Restrict)
  offerId             String                 @unique @map("offer_id") @db.Uuid
  offer               PlacementOffer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  expectedJoiningDate DateTime?              @map("expected_joining_date")
  actualJoiningDate   DateTime?              @map("actual_joining_date")
  joiningLocation     String?                @map("joining_location")
  status              PlacementJoiningStatus @default(PENDING)
  remarks             String?
  createdBy           String?                @map("created_by")
  updatedBy           String?                @map("updated_by")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([offerId])
  @@map("placement_joinings")
}

/// Final placement state per student per academic year — the record backing placement
/// statistics, package analytics and department reports. `finalPackageCents` snapshots the
/// accepted offer package.
model PlacementOutcome {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  academicYearId    String                 @map("academic_year_id") @db.Uuid
  academicYear      AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  studentId         String                 @map("student_id") @db.Uuid
  student           Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  driveId           String?                @map("drive_id") @db.Uuid
  drive             PlacementDrive?        @relation(fields: [driveId], references: [id], onDelete: SetNull)
  positionId        String?                @map("position_id") @db.Uuid
  position          PlacementPosition?     @relation(fields: [positionId], references: [id], onDelete: SetNull)
  offerId           String?                @map("offer_id") @db.Uuid
  offer             PlacementOffer?        @relation(fields: [offerId], references: [id], onDelete: SetNull)
  outcomeStatus     PlacementOutcomeStatus @default(UNREGISTERED) @map("outcome_status")
  finalPackageCents Int?                   @map("final_package_cents")
  placedAt          DateTime?              @map("placed_at")
  declaredByUserId  String?                @map("declared_by_user_id") @db.Uuid
  remarks           String?
  createdBy         String?                @map("created_by")
  updatedBy         String?                @map("updated_by")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  @@unique([tenantId, academicYearId, studentId])
  @@index([tenantId])
  @@index([academicYearId])
  @@index([studentId])
  @@index([tenantId, outcomeStatus])
  @@map("placement_outcomes")
}

// ---------------------------------------------------------------------------
// Inventory & Asset Management (Phase 8) — vendors, product categories, products,
// storage locations, stock ledger (receipts / transfers / adjustments), the
// purchase flow (requests → approvals → purchase orders → goods receipts, which
// post stock on completion), and fixed assets (registration, assignment,
// maintenance, warranty claims, straight-line depreciation and disposal).
// The module lives in apps/api/src/modules/inventory.
// ---------------------------------------------------------------------------

enum InventorySequenceKind {
  VENDOR
  CATEGORY
  PRODUCT
  LOCATION
  PURCHASE_REQUEST
  PURCHASE_ORDER
  GOODS_RECEIPT
  STOCK_TRANSFER
  STOCK_ADJUSTMENT
  ASSET
  ASSET_TAG
  MAINTENANCE
  WARRANTY_CLAIM
  DISPOSAL
}

/// Atomic per-tenant series allocator — same contract as library/fee sequences.
model InventorySequence {
  id        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String                @map("tenant_id") @db.Uuid
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  kind      InventorySequenceKind
  prefix    String
  nextValue Int                   @default(1) @map("next_value")
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  @@unique([tenantId, kind, prefix])
  @@map("inventory_sequences")
}

/// One catalog category, optionally tree-shaped via parentId. `kind` splits the same
/// table into product categories and fixed-asset categories so both flows share one
/// management surface without mixing codes.
enum InventoryCategoryKind {
  PRODUCT
  ASSET
}

model InventoryCategory {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String                @map("tenant_id") @db.Uuid
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  kind        InventoryCategoryKind @default(PRODUCT)
  code        String
  name        String
  description String?
  parentId    String?               @map("parent_id") @db.Uuid
  parent      InventoryCategory?    @relation("InventoryCategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  createdBy   String?               @map("created_by")
  updatedBy   String?               @map("updated_by")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  deletedAt   DateTime?             @map("deleted_at")

  children InventoryCategory[] @relation("InventoryCategoryChildren")
  products InventoryProduct[]
  assets   InventoryAsset[]

  @@unique([tenantId, kind, code])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@map("inventory_categories")
}

enum InventoryVendorStatus {
  ACTIVE
  INACTIVE
}

model InventoryVendor {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String                @map("tenant_id") @db.Uuid
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code          String
  name          String
  gstin         String?
  contactPerson String?               @map("contact_person")
  phone         String?
  email         String?
  addressLine1  String?               @map("address_line1")
  addressLine2  String?               @map("address_line2")
  city          String?
  state         String?
  postalCode    String?               @map("postal_code")
  country       String?               @default("India")
  website       String?
  paymentTerms  String?               @map("payment_terms")
  status        InventoryVendorStatus @default(ACTIVE)
  notes         String?
  createdBy     String?               @map("created_by")
  updatedBy     String?               @map("updated_by")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  deletedAt     DateTime?             @map("deleted_at")

  purchaseRequests   InventoryPurchaseRequest[]
  purchaseOrders     InventoryPurchaseOrder[]
  goodsReceipts      InventoryGoodsReceipt[]
  assets             InventoryAsset[]
  maintenanceRecords InventoryAssetMaintenance[] @relation("InventoryMaintenanceVendors")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@map("inventory_vendors")
}

model InventoryProduct {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  categoryId     String            @map("category_id") @db.Uuid
  category       InventoryCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  code           String
  sku            String?
  name           String
  description    String?
  unit           String            @default("PCS")
  unitPriceCents Int?              @map("unit_price_cents")
  reorderLevel   Int               @default(0) @map("reorder_level")
  isActive       Boolean           @default(true) @map("is_active")
  createdBy      String?           @map("created_by")
  updatedBy      String?           @map("updated_by")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  stockItems      InventoryStockItem[]
  movements       InventoryStockMovement[]
  requestItems    InventoryPurchaseRequestItem[]
  orderItems      InventoryPurchaseOrderItem[]
  receiptItems    InventoryGoodsReceiptItem[]
  transferItems   InventoryStockTransferItem[]
  adjustmentItems InventoryStockAdjustmentItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId, deletedAt])
  @@map("inventory_products")
}

enum InventoryLocationType {
  WAREHOUSE
  STORE
  LAB
  ROOM
  OTHER
}

model InventoryLocation {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String                @map("tenant_id") @db.Uuid
  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code       String
  name       String
  type       InventoryLocationType @default(STORE)
  campusId   String?               @map("campus_id") @db.Uuid
  campus     Campus?               @relation(fields: [campusId], references: [id], onDelete: SetNull)
  buildingId String?               @map("building_id") @db.Uuid
  building   Building?             @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  roomId     String?               @map("room_id") @db.Uuid
  room       Room?                 @relation(fields: [roomId], references: [id], onDelete: SetNull)
  isActive   Boolean               @default(true) @map("is_active")
  notes      String?
  createdBy  String?               @map("created_by")
  updatedBy  String?               @map("updated_by")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  deletedAt  DateTime?             @map("deleted_at")

  stockItems      InventoryStockItem[]
  movements       InventoryStockMovement[]
  receiptItems    InventoryGoodsReceiptItem[]
  transferringOut InventoryStockTransfer[]    @relation("InventoryTransferFromLocations")
  transferringIn  InventoryStockTransfer[]    @relation("InventoryTransferToLocations")
  adjustments     InventoryStockAdjustment[]
  assets          InventoryAsset[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, campusId])
  @@index([tenantId, deletedAt])
  @@map("inventory_locations")
}

/// Current balance per product per location. Updated transactionally alongside a
/// StockMovement ledger write so the movement history never diverges from balances.
model InventoryStockItem {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  productId        String            @map("product_id") @db.Uuid
  product          InventoryProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId       String            @map("location_id") @db.Uuid
  location         InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantityOnHand   Int               @default(0) @map("quantity_on_hand")
  reservedQuantity Int               @default(0) @map("reserved_quantity")
  lastMovementAt   DateTime?         @map("last_movement_at")
  createdBy        String?           @map("created_by")
  updatedBy        String?           @map("updated_by")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@unique([tenantId, locationId, productId])
  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, locationId])
  @@map("inventory_stock_items")
}

enum InventoryStockMovementType {
  INITIAL
  RECEIPT
  ISSUE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_ADD
  ADJUSTMENT_SUBTRACT
}

/// Append-only stock ledger. `referenceType`/`referenceId` loosely link the movement
/// to the business record that produced it (goods receipt / transfer / adjustment).
model InventoryStockMovement {
  id             String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String                     @map("tenant_id") @db.Uuid
  tenant         Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  productId      String                     @map("product_id") @db.Uuid
  product        InventoryProduct           @relation(fields: [productId], references: [id], onDelete: Restrict)
  locationId     String                     @map("location_id") @db.Uuid
  location       InventoryLocation          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  type           InventoryStockMovementType
  quantityDelta  Int                        @map("quantity_delta")
  quantityBefore Int                        @map("quantity_before")
  quantityAfter  Int                        @map("quantity_after")
  reason         String?
  referenceType  String?                    @map("reference_type")
  referenceId    String?                    @map("reference_id")
  notes          String?
  postedBy       String?                    @map("posted_by")
  occurredAt     DateTime                   @default(now()) @map("occurred_at")
  createdAt      DateTime                   @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, productId, occurredAt])
  @@index([tenantId, locationId, occurredAt])
  @@index([tenantId, referenceType, referenceId])
  @@map("inventory_stock_movements")
}

enum InventoryPurchaseRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CONVERTED
  CANCELLED
}

/// Purchase request with lightweight approval state machine (draft → pending →
/// approved/rejected → converted into a purchase order). stays self-contained in
/// the inventory module; intent-to-purchase approvals are a first-tier nudge for a
/// future WorkflowModule integration.
model InventoryPurchaseRequest {
  id               String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                         @map("tenant_id") @db.Uuid
  tenant           Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  requestNumber    String                         @map("request_number")
  status           InventoryPurchaseRequestStatus @default(DRAFT)
  requestedBy      String                         @map("requested_by")
  requestedAt      DateTime                       @default(now()) @map("requested_at")
  departmentId     String?                        @map("department_id") @db.Uuid
  department       Department?                    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  vendorId         String?                        @map("vendor_id") @db.Uuid
  vendor           InventoryVendor?               @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  requiresApproval Boolean                        @default(true) @map("requires_approval")
  reviewedById     String?                        @map("reviewed_by_id")
  approvedById     String?                        @map("approved_by_id")
  approvedAt       DateTime?                      @map("approved_at")
  rejectionReason  String?                        @map("rejection_reason")
  notes            String?
  createdBy        String?                        @map("created_by")
  updatedBy        String?                        @map("updated_by")
  createdAt        DateTime                       @default(now()) @map("created_at")
  updatedAt        DateTime                       @updatedAt @map("updated_at")

  items         InventoryPurchaseRequestItem[]
  purchaseOrder InventoryPurchaseOrder?        @relation("PurchaseRequestPurchaseOrder")

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("inventory_purchase_requests")
}

model InventoryPurchaseRequestItem {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                   @map("tenant_id") @db.Uuid
  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  requestId         String                   @map("request_id") @db.Uuid
  request           InventoryPurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId         String                   @map("product_id") @db.Uuid
  product           InventoryProduct         @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantityRequested Int                      @map("quantity_requested")
  quantityApproved  Int?                     @map("quantity_approved")
  unitPriceCents    Int?                     @map("unit_price_cents")
  notes             String?

  @@index([tenantId])
  @@index([requestId])
  @@map("inventory_purchase_request_items")
}

enum InventoryPurchaseOrderStatus {
  DRAFT
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model InventoryPurchaseOrder {
  id                String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                       @map("tenant_id") @db.Uuid
  tenant            Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  poNumber          String                       @map("po_number")
  vendorId          String                       @map("vendor_id") @db.Uuid
  vendor            InventoryVendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  status            InventoryPurchaseOrderStatus @default(DRAFT)
  purchaseRequestId String?                      @unique @map("purchase_request_id") @db.Uuid
  purchaseRequest   InventoryPurchaseRequest?    @relation("PurchaseRequestPurchaseOrder", fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  orderDate         DateTime                     @default(now()) @map("order_date")
  expectedDate      DateTime?                    @map("expected_date")
  totalCents        Int                          @default(0) @map("total_cents")
  approvedById      String?                      @map("approved_by_id")
  approvedAt        DateTime?                    @map("approved_at")
  receivedAt        DateTime?                    @map("received_at")
  notes             String?
  createdBy         String?                      @map("created_by")
  updatedBy         String?                      @map("updated_by")
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")

  items         InventoryPurchaseOrderItem[]
  goodsReceipts InventoryGoodsReceipt[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("inventory_purchase_orders")
}

model InventoryPurchaseOrderItem {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                 @map("tenant_id") @db.Uuid
  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  poId             String                 @map("po_id") @db.Uuid
  po               InventoryPurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId        String                 @map("product_id") @db.Uuid
  product          InventoryProduct       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantityOrdered  Int                    @map("quantity_ordered")
  quantityReceived Int                    @default(0) @map("quantity_received")
  unitPriceCents   Int                    @default(0) @map("unit_price_cents")
  notes            String?

  receiptItems InventoryGoodsReceiptItem[]

  @@index([tenantId])
  @@index([poId])
  @@map("inventory_purchase_order_items")
}

enum InventoryGoodsReceiptStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model InventoryGoodsReceipt {
  id         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String                      @map("tenant_id") @db.Uuid
  tenant     Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  grnNumber  String                      @map("grn_number")
  vendorId   String                      @map("vendor_id") @db.Uuid
  vendor     InventoryVendor             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  poId       String?                     @map("po_id") @db.Uuid
  po         InventoryPurchaseOrder?     @relation(fields: [poId], references: [id], onDelete: SetNull)
  status     InventoryGoodsReceiptStatus @default(DRAFT)
  receivedAt DateTime                    @default(now()) @map("received_at")
  receivedBy String?                     @map("received_by")
  notes      String?
  createdBy  String?                     @map("created_by")
  updatedBy  String?                     @map("updated_by")
  createdAt  DateTime                    @default(now()) @map("created_at")
  updatedAt  DateTime                    @updatedAt @map("updated_at")

  items InventoryGoodsReceiptItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("inventory_goods_receipts")
}

model InventoryGoodsReceiptItem {
  id               String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                      @map("tenant_id") @db.Uuid
  tenant           Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  grnId            String                      @map("grn_id") @db.Uuid
  grn              InventoryGoodsReceipt       @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poItemId         String?                     @map("po_item_id") @db.Uuid
  poItem           InventoryPurchaseOrderItem? @relation(fields: [poItemId], references: [id], onDelete: SetNull)
  productId        String                      @map("product_id") @db.Uuid
  product          InventoryProduct            @relation(fields: [productId], references: [id], onDelete: Restrict)
  locationId       String                      @map("location_id") @db.Uuid
  location         InventoryLocation           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  quantityReceived Int                         @map("quantity_received")
  unitPriceCents   Int                         @default(0) @map("unit_price_cents")
  notes            String?
  createdAt        DateTime                    @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([grnId])
  @@map("inventory_goods_receipt_items")
}

enum InventoryStockTransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model InventoryStockTransfer {
  id             String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String                       @map("tenant_id") @db.Uuid
  tenant         Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  transferNumber String                       @map("transfer_number")
  fromLocationId String                       @map("from_location_id") @db.Uuid
  fromLocation   InventoryLocation            @relation("InventoryTransferFromLocations", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocationId   String                       @map("to_location_id") @db.Uuid
  toLocation     InventoryLocation            @relation("InventoryTransferToLocations", fields: [toLocationId], references: [id], onDelete: Restrict)
  status         InventoryStockTransferStatus @default(PENDING)
  requestedBy    String?                      @map("requested_by")
  requestedAt    DateTime                     @default(now()) @map("requested_at")
  completedBy    String?                      @map("completed_by")
  completedAt    DateTime?                    @map("completed_at")
  notes          String?
  createdBy      String?                      @map("created_by")
  updatedBy      String?                      @map("updated_by")
  createdAt      DateTime                     @default(now()) @map("created_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")

  items InventoryStockTransferItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("inventory_stock_transfers")
}

model InventoryStockTransferItem {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String                 @map("tenant_id") @db.Uuid
  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  transferId String                 @map("transfer_id") @db.Uuid
  transfer   InventoryStockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String                 @map("product_id") @db.Uuid
  product    InventoryProduct       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Int
  createdAt  DateTime               @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([transferId])
  @@map("inventory_stock_transfer_items")
}

enum InventoryStockAdjustmentStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model InventoryStockAdjustment {
  id               String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                         @map("tenant_id") @db.Uuid
  tenant           Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  adjustmentNumber String                         @map("adjustment_number")
  locationId       String                         @map("location_id") @db.Uuid
  location         InventoryLocation              @relation(fields: [locationId], references: [id], onDelete: Restrict)
  status           InventoryStockAdjustmentStatus @default(DRAFT)
  reason           String?
  description      String?
  adjustedBy       String?                        @map("adjusted_by")
  adjustedAt       DateTime?                      @map("adjusted_at")
  createdBy        String?                        @map("created_by")
  updatedBy        String?                        @map("updated_by")
  createdAt        DateTime                       @default(now()) @map("created_at")
  updatedAt        DateTime                       @updatedAt @map("updated_at")

  items InventoryStockAdjustmentItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("inventory_stock_adjustments")
}

model InventoryStockAdjustmentItem {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String                   @map("tenant_id") @db.Uuid
  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  adjustmentId  String                   @map("adjustment_id") @db.Uuid
  adjustment    InventoryStockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  productId     String                   @map("product_id") @db.Uuid
  product       InventoryProduct         @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantityDelta Int                      @map("quantity_delta")
  reason        String?
  createdAt     DateTime                 @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([adjustmentId])
  @@map("inventory_stock_adjustment_items")
}

// ── Fixed assets ────────────────────────────────────────────────────────────

enum InventoryAssetStatus {
  IN_STOCK
  ASSIGNED
  UNDER_MAINTENANCE
  DECOMMISSIONED
  DISPOSED
  WRITTEN_OFF
}

enum InventoryAssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
  DISPOSED
}

enum InventoryDepreciationMethod {
  NONE
  STRAIGHT_LINE
}

/// A capitalized fixed asset. Purchased through the inventory module (or recorded
/// directly); tagged, assigned to an employee/department/campus, maintained,
/// depreciated on a schedule and eventually disposed.
model InventoryAsset {
  id                    String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String                      @map("tenant_id") @db.Uuid
  tenant                Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assetCode             String                      @map("asset_code")
  tagNumber             String                      @map("tag_number")
  name                  String
  description           String?
  categoryId            String                      @map("category_id") @db.Uuid
  category              InventoryCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  vendorId              String?                     @map("vendor_id") @db.Uuid
  vendor                InventoryVendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  locationId            String?                     @map("location_id") @db.Uuid
  location              InventoryLocation?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  serialNumber          String?                     @map("serial_number")
  brand                 String?
  modelName             String?                     @map("model_name")
  purchaseDate          DateTime?                   @map("purchase_date") @db.Date
  purchaseCostCents     Int?                        @map("purchase_cost_cents")
  warrantyStartDate     DateTime?                   @map("warranty_start_date") @db.Date
  warrantyEndDate       DateTime?                   @map("warranty_end_date") @db.Date
  warrantyProvider      String?                     @map("warranty_provider")
  status                InventoryAssetStatus        @default(IN_STOCK)
  condition             InventoryAssetCondition     @default(NEW)
  depreciationMethod    InventoryDepreciationMethod @default(NONE) @map("depreciation_method")
  usefulLifeMonths      Int?                        @map("useful_life_months")
  salvageValueCents     Int                         @default(0) @map("salvage_value_cents")
  currentBookValueCents Int?                        @map("current_book_value_cents")
  notes                 String?
  createdBy             String?                     @map("created_by")
  updatedBy             String?                     @map("updated_by")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")
  deletedAt             DateTime?                   @map("deleted_at")

  assignments         InventoryAssetAssignment[]
  maintenanceRecords  InventoryAssetMaintenance[]
  depreciationEntries InventoryAssetDepreciationEntry[]
  warrantyClaims      InventoryAssetWarrantyClaim[]
  disposals           InventoryAssetDisposal[]

  @@unique([tenantId, assetCode])
  @@unique([tenantId, tagNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@index([tenantId, deletedAt])
  @@map("inventory_assets")
}

enum InventoryAssignmentType {
  EMPLOYEE
  DEPARTMENT
  CAMPUS
  OTHER
}

enum InventoryAssignmentStatus {
  ACTIVE
  RETURNED
}

/// One assignment record. Returning an asset closes the ACTIVE record; an asset has
/// at most one ACTIVE assignment at any time (enforced by the service).
model InventoryAssetAssignment {
  id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String                    @map("tenant_id") @db.Uuid
  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assetId      String                    @map("asset_id") @db.Uuid
  asset        InventoryAsset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assigneeType InventoryAssignmentType   @map("assignee_type")
  employeeId   String?                   @map("employee_id") @db.Uuid
  employee     Employee?                 @relation("InventoryAssetEmployeeAssignees", fields: [employeeId], references: [id], onDelete: SetNull)
  departmentId String?                   @map("department_id") @db.Uuid
  department   Department?               @relation("InventoryAssetDepartmentAssignees", fields: [departmentId], references: [id], onDelete: SetNull)
  campusId     String?                   @map("campus_id") @db.Uuid
  campus       Campus?                   @relation("InventoryAssetCampusAssignees", fields: [campusId], references: [id], onDelete: SetNull)
  assigneeName String?                   @map("assignee_name")
  assignedBy   String?                   @map("assigned_by")
  assignedAt   DateTime                  @default(now()) @map("assigned_at")
  returnedAt   DateTime?                 @map("returned_at")
  status       InventoryAssignmentStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, assetId])
  @@index([tenantId, status])
  @@map("inventory_asset_assignments")
}

enum InventoryMaintenanceType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
  OTHER
}

enum InventoryMaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model InventoryAssetMaintenance {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                     @map("tenant_id") @db.Uuid
  tenant            Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assetId           String                     @map("asset_id") @db.Uuid
  asset             InventoryAsset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  maintenanceNumber String                     @map("maintenance_number")
  vendorId          String?                    @map("vendor_id") @db.Uuid
  vendor            InventoryVendor?           @relation("InventoryMaintenanceVendors", fields: [vendorId], references: [id], onDelete: SetNull)
  type              InventoryMaintenanceType   @default(PREVENTIVE)
  status            InventoryMaintenanceStatus @default(SCHEDULED)
  scheduledDate     DateTime?                  @map("scheduled_date")
  startedAt         DateTime?                  @map("started_at")
  completedAt       DateTime?                  @map("completed_at")
  description       String?
  costCents         Int?                       @map("cost_cents")
  performedBy       String?                    @map("performed_by")
  notes             String?
  createdBy         String?                    @map("created_by")
  updatedBy         String?                    @map("updated_by")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, assetId])
  @@index([tenantId, status])
  @@map("inventory_asset_maintenance")
}

enum InventoryWarrantyClaimStatus {
  OPEN
  APPROVED
  REPAIRED
  REJECTED
  CLOSED
}

model InventoryAssetWarrantyClaim {
  id          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String                       @map("tenant_id") @db.Uuid
  tenant      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assetId     String                       @map("asset_id") @db.Uuid
  asset       InventoryAsset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  claimNumber String                       @map("claim_number")
  status      InventoryWarrantyClaimStatus @default(OPEN)
  openedAt    DateTime                     @default(now()) @map("opened_at")
  description String?
  resolution  String?
  costCents   Int                          @default(0) @map("cost_cents")
  closedAt    DateTime?                    @map("closed_at")
  notes       String?
  createdBy   String?                      @map("created_by")
  updatedBy   String?                      @map("updated_by")
  createdAt   DateTime                     @default(now()) @map("created_at")
  updatedAt   DateTime                     @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, assetId])
  @@map("inventory_asset_warranty_claims")
}

/// One month's straight-line depreciation for an asset. A unique (asset, periodStart)
/// guard makes the depreciation run idempotent per accounting period.
model InventoryAssetDepreciationEntry {
  id                    String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String                      @map("tenant_id") @db.Uuid
  tenant                Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assetId               String                      @map("asset_id") @db.Uuid
  asset                 InventoryAsset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  periodStart           DateTime                    @map("period_start") @db.Date
  periodEnd             DateTime                    @map("period_end") @db.Date
  method                InventoryDepreciationMethod @default(STRAIGHT_LINE)
  openingBookValueCents Int                         @map("opening_book_value_cents")
  depreciationCents     Int                         @map("depreciation_cents")
  closingBookValueCents Int                         @map("closing_book_value_cents")
  createdAt             DateTime                    @default(now()) @map("created_at")

  @@unique([tenantId, assetId, periodStart])
  @@index([tenantId])
  @@index([tenantId, assetId])
  @@map("inventory_asset_depreciation_entries")
}

enum InventoryDisposalType {
  SALE
  SCRAP
  DONATION
  RETURN_TO_VENDOR
}

enum InventoryDisposalStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model InventoryAssetDisposal {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String                  @map("tenant_id") @db.Uuid
  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assetId        String                  @map("asset_id") @db.Uuid
  asset          InventoryAsset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  disposalNumber String                  @map("disposal_number")
  type           InventoryDisposalType   @default(SCRAP)
  status         InventoryDisposalStatus @default(DRAFT)
  disposalDate   DateTime?               @map("disposal_date") @db.Date
  proceedsCents  Int                     @default(0) @map("proceeds_cents")
  remarks        String?
  approvedBy     String?                 @map("approved_by")
  completedAt    DateTime?               @map("completed_at")
  createdBy      String?                 @map("created_by")
  updatedBy      String?                 @map("updated_by")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, assetId])
  @@map("inventory_asset_disposals")
}

// ---------------------------------------------------------------------------
// Helpdesk / Feedback — the institution's own service desk (students, staff,
// parents raise tickets against internal departments like IT, Maintenance,
// Accounts), distinct from the platform control-plane SupportTicket model
// (a tenant raising a ticket TO the SaaS platform). Covers categories,
// departments, SLA policies, the ticket status lifecycle (resolution/
// reopening), assignment, escalation, internal notes, attachments,
// feedback + satisfaction scoring, dashboards and reports. Lifecycle events
// fan out through the shared NotificationsService; optional approval flows
// attach to the generic workflow engine via entityType "HelpdeskTicket".
// ---------------------------------------------------------------------------

enum HelpdeskTicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum HelpdeskTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
  CRITICAL
}

enum HelpdeskTicketSource {
  WEB
  EMAIL
  PHONE
  WALK_IN
  API
  OTHER
}

enum HelpdeskCommentVisibility {
  PUBLIC
  INTERNAL
}

enum HelpdeskHistoryEvent {
  CREATED
  UPDATED
  STATUS_CHANGED
  ASSIGNED
  PRIORITY_CHANGED
  DEPARTMENT_CHANGED
  CATEGORY_CHANGED
  COMMENTED
  ATTACHED
  ESCALATED
  RESOLVED
  REOPENED
  CLOSED
  FEEDBACK_SUBMITTED
  SLA_BREACHED
}

enum HelpdeskEscalationReason {
  RESPONSE_BREACH
  RESOLUTION_BREACH
  MANUAL
}

enum HelpdeskSequenceKind {
  TICKET
}

/// Per-tenant monotonic numbering series (mirrors InventorySequence) — allocates
/// human-readable ticket numbers like HD-2026-000123 under the tenant guard.
model HelpdeskSequence {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String               @map("tenant_id") @db.Uuid
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  kind      HelpdeskSequenceKind
  prefix    String
  nextValue Int                  @default(1) @map("next_value")
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@unique([tenantId, kind])
  @@index([tenantId])
  @@map("helpdesk_sequences")
}

/// A routing/support department (IT, Maintenance, Accounts, Library, Hostel, ...). Deliberately
/// separate from the academic `Department` model: helpdesk routing units are operational, not
/// academic org units, and many (IT, Facilities) have no academic counterpart.
model HelpdeskDepartment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code        String
  name        String
  description String?
  email       String?
  campusId    String?  @map("campus_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String?  @map("created_by")
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  categories  HelpdeskCategory[]
  slaPolicies HelpdeskSlaPolicy[]
  tickets     HelpdeskTicket[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("helpdesk_departments")
}

/// Ticket category, optionally nested. Carries routing defaults (priority + department) and can
/// pin an SLA policy; `requiresApproval` marks categories whose creation should attach a generic
/// workflow-engine approval instance.
model HelpdeskCategory {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String                 @map("tenant_id") @db.Uuid
  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code                String
  name                String
  description         String?
  parentId            String?                @map("parent_id") @db.Uuid
  parent              HelpdeskCategory?      @relation("HelpdeskCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children            HelpdeskCategory[]     @relation("HelpdeskCategoryTree")
  defaultPriority     HelpdeskTicketPriority @default(MEDIUM) @map("default_priority")
  defaultDepartmentId String?                @map("default_department_id") @db.Uuid
  defaultDepartment   HelpdeskDepartment?    @relation(fields: [defaultDepartmentId], references: [id], onDelete: SetNull)
  slaPolicyId         String?                @map("sla_policy_id") @db.Uuid
  slaPolicy           HelpdeskSlaPolicy?     @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  requiresApproval    Boolean                @default(false) @map("requires_approval")
  isActive            Boolean                @default(true) @map("is_active")
  sequenceOrder       Int                    @default(0) @map("sequence_order")
  createdBy           String?                @map("created_by")
  updatedBy           String?                @map("updated_by")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  tickets HelpdeskTicket[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@map("helpdesk_categories")
}

/// Response/resolution target policy. Matching precedence at ticket creation:
/// category-pinned policy > (priority + department) exact match > priority match > department
/// match > tenant default. Escalation re-uses the RBAC role catalog via `escalateToRoleCode`.
model HelpdeskSlaPolicy {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String                  @map("tenant_id") @db.Uuid
  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code                 String
  name                 String
  description          String?
  priority             HelpdeskTicketPriority?
  departmentId         String?                 @map("department_id") @db.Uuid
  department           HelpdeskDepartment?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  responseMinutes      Int                     @default(240) @map("response_minutes")
  resolutionMinutes    Int                     @default(1440) @map("resolution_minutes")
  /// Minutes before a due time at which a ticket is flagged AT_RISK in dashboards/reports.
  atRiskMinutes        Int?                    @map("at_risk_minutes")
  escalateToRoleCode   String?                 @map("escalate_to_role_code")
  /// Grace minutes past a due time before the SLA sweep auto-escalates; null disables escalation.
  escalateAfterMinutes Int?                    @map("escalate_after_minutes")
  isDefault            Boolean                 @default(false) @map("is_default")
  isActive             Boolean                 @default(true) @map("is_active")
  createdBy            String?                 @map("created_by")
  updatedBy            String?                 @map("updated_by")
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  tickets    HelpdeskTicket[]
  categories HelpdeskCategory[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, priority])
  @@index([tenantId, departmentId])
  @@map("helpdesk_sla_policies")
}

model HelpdeskTicket {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String                 @map("tenant_id") @db.Uuid
  tenant                  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ticketNumber            String                 @map("ticket_number")
  subject                 String
  description             String
  status                  HelpdeskTicketStatus   @default(NEW)
  priority                HelpdeskTicketPriority @default(MEDIUM)
  source                  HelpdeskTicketSource   @default(WEB)
  categoryId              String                 @map("category_id") @db.Uuid
  category                HelpdeskCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  departmentId            String?                @map("department_id") @db.Uuid
  department              HelpdeskDepartment?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  slaPolicyId             String?                @map("sla_policy_id") @db.Uuid
  slaPolicy               HelpdeskSlaPolicy?     @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  /// Plain UUIDs (no FK), matching the createdBy convention — requester may be a User OR an
  /// external contact captured by name/email only.
  requesterUserId         String?                @map("requester_user_id") @db.Uuid
  requesterName           String?                @map("requester_name")
  requesterEmail          String?                @map("requester_email")
  assignedToUserId        String?                @map("assigned_to_user_id") @db.Uuid
  responseDueAt           DateTime?              @map("response_due_at")
  resolutionDueAt         DateTime?              @map("resolution_due_at")
  firstRespondedAt        DateTime?              @map("first_responded_at")
  resolvedAt              DateTime?              @map("resolved_at")
  closedAt                DateTime?              @map("closed_at")
  cancelledAt             DateTime?              @map("cancelled_at")
  reopenedCount           Int                    @default(0) @map("reopened_count")
  escalationLevel         Int                    @default(0) @map("escalation_level")
  escalatedAt             DateTime?              @map("escalated_at")
  resolutionSummary       String?                @map("resolution_summary")
  tags                    String[]               @default([])
  satisfactionScore       Int?                   @map("satisfaction_score")
  satisfactionComment     String?                @map("satisfaction_comment")
  satisfactionSubmittedAt DateTime?              @map("satisfaction_submitted_at")
  createdBy               String?                @map("created_by")
  updatedBy               String?                @map("updated_by")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  comments    HelpdeskTicketComment[]
  attachments HelpdeskTicketAttachment[]
  history     HelpdeskTicketHistory[]
  escalations HelpdeskEscalation[]
  feedback    HelpdeskFeedback[]

  @@unique([tenantId, ticketNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([tenantId, assignedToUserId])
  @@index([tenantId, departmentId])
  @@index([tenantId, categoryId])
  @@index([tenantId, resolutionDueAt])
  @@map("helpdesk_tickets")
}

/// A ticket message. INTERNAL comments are staff-only notes and never notify the requester or
/// appear in the requester's self-service view.
model HelpdeskTicketComment {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                    @map("tenant_id") @db.Uuid
  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ticketId         String                    @map("ticket_id") @db.Uuid
  ticket           HelpdeskTicket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUserId     String?                   @map("author_user_id") @db.Uuid
  visibility       HelpdeskCommentVisibility @default(PUBLIC)
  body             String
  isResolutionNote Boolean                   @default(false) @map("is_resolution_note")
  createdBy        String?                   @map("created_by")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  attachments HelpdeskTicketAttachment[]

  @@index([tenantId])
  @@index([tenantId, ticketId])
  @@map("helpdesk_ticket_comments")
}

/// Links a ticket (or one of its comments) to an already-uploaded Document. The document row
/// itself is managed by the shared documents module/storage layer; `documentId` is a plain UUID
/// validated on attach rather than a hard FK, so helpdesk never has to widen the Document model.
model HelpdeskTicketAttachment {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String                 @map("tenant_id") @db.Uuid
  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ticketId   String                 @map("ticket_id") @db.Uuid
  ticket     HelpdeskTicket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId  String?                @map("comment_id") @db.Uuid
  comment    HelpdeskTicketComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  documentId String                 @map("document_id") @db.Uuid
  filename   String
  mimeType   String                 @map("mime_type")
  sizeBytes  Int?                   @map("size_bytes")
  uploadedBy String?                @map("uploaded_by")
  createdAt  DateTime               @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, ticketId])
  @@map("helpdesk_ticket_attachments")
}

/// Immutable lifecycle timeline (status/assignment/priority/department/category changes,
/// comments, escalations, resolution, reopening, feedback).
model HelpdeskTicketHistory {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ticketId    String               @map("ticket_id") @db.Uuid
  ticket      HelpdeskTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  event       HelpdeskHistoryEvent
  actorUserId String?              @map("actor_user_id") @db.Uuid
  actorType   String               @default("USER") @map("actor_type")
  fromValue   String?              @map("from_value")
  toValue     String?              @map("to_value")
  note        String?
  createdAt   DateTime             @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, ticketId])
  @@map("helpdesk_ticket_history")
}

model HelpdeskEscalation {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                   @map("tenant_id") @db.Uuid
  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ticketId           String                   @map("ticket_id") @db.Uuid
  ticket             HelpdeskTicket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  reason             HelpdeskEscalationReason
  level              Int                      @default(1)
  fromAssigneeUserId String?                  @map("from_assignee_user_id") @db.Uuid
  toUserId           String?                  @map("to_user_id") @db.Uuid
  toRoleCode         String?                  @map("to_role_code")
  note               String?
  escalatedByUserId  String?                  @map("escalated_by_user_id") @db.Uuid
  createdAt          DateTime                 @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, ticketId])
  @@map("helpdesk_escalations")
}

/// One satisfaction response per ticket (unique per tenant+ticket). The score is also
/// denormalized onto HelpdeskTicket.satisfactionScore for fast dashboard aggregation.
model HelpdeskFeedback {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ticketId          String         @map("ticket_id") @db.Uuid
  ticket            HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  score             Int
  comment           String?
  submittedByUserId String?        @map("submitted_by_user_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at")

  @@unique([tenantId, ticketId])
  @@index([tenantId])
  @@map("helpdesk_feedback")
}
