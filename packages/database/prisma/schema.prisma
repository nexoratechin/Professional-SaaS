// ---------------------------------------------------------------------------
// Notifications (minimal vertical slice proving tenant-aware background jobs —
// see apps/api's NotificationsModule and apps/worker's NotificationsProcessor).
// Templates/broadcasts/delivery-provider integrations are Phase 8+; this is the
// tenant-isolation-correct dispatch mechanism only.
// ---------------------------------------------------------------------------

model Notification {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recipientUserId String?             @map("recipient_user_id") @db.Uuid
  channel         NotificationChannel
  subject         String
  body            String
  status          NotificationStatus  @default(PENDING)
  error           String?
  sentAt          DateTime?           @map("sent_at")
  createdBy       String?             @map("created_by") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([recipientUserId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Documents (tenant-scoped file metadata — see apps/api's StorageService/
// DocumentsModule). storageKey always embeds the owning tenantId as a path
// prefix; StorageService refuses to sign a URL for a key outside the caller's
// tenant prefix regardless of what this table says, so tenant isolation for
// file access is enforced twice: once by the tenant-scoped Prisma query that
// finds the Document row, once by the key-prefix check before signing.
// ---------------------------------------------------------------------------

model Document {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category         String
  storageKey       String         @unique @map("storage_key")
  originalFilename String         @map("original_filename")
  mimeType         String         @map("mime_type")
  sizeBytes        Int?           @map("size_bytes")
  status           DocumentStatus @default(PENDING_UPLOAD)
  uploadedBy       String?        @map("uploaded_by") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, category])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Workflow engine — a single, reusable, tenant-configurable state-machine +
// approval-chain engine. It knows nothing about admissions/fees/exams/etc.:
// each future business module attaches to it purely by starting a
// WorkflowInstance against its own entityType/entityId and a
// WorkflowDefinition the tenant configured for that entityType — approval
// chains are DATA (rows below), never a hardcoded per-module code path.
// Audit trail is NOT duplicated here — every lifecycle event (definition
// created/activated, instance started, task decided, transition fired,
// escalation, completion) is written through the existing centralized
// AuditService/PlatformAuditLog (module = 'workflows').
// ---------------------------------------------------------------------------

model WorkflowDefinition {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code        String
  name        String
  description String?
  /// Free-form string the future business module chooses (e.g. "FeeRefund", "LeaveRequest") —
  /// never an enum, so a new consumer never needs a schema change to plug into the engine.
  entityType  String    @map("entity_type")
  version     Int       @default(1)
  /// At most one ACTIVE definition per (tenantId, entityType) is enforced at the application
  /// layer (WorkflowDefinitionsService), not a DB constraint — Prisma has no partial unique index
  /// support (see this file's header "Known trade-off" note); activating a new version
  /// deactivates the previous one in the same transaction.
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  states      WorkflowState[]
  transitions WorkflowTransition[]
  instances   WorkflowInstance[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, entityType, isActive])
  @@map("workflow_definitions")
}

model WorkflowState {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                @map("tenant_id") @db.Uuid
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  definitionId       String                @map("definition_id") @db.Uuid
  definition         WorkflowDefinition    @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  code               String
  name               String
  category           WorkflowStateCategory @default(IN_PROGRESS)
  /// Whether a rejected instance sitting in this state can be resubmitted (see
  /// WorkflowEngineService.resubmit) rather than staying permanently terminal.
  allowsResubmission Boolean               @default(false) @map("allows_resubmission")
  sequenceOrder      Int                   @default(0) @map("sequence_order")
  createdAt          DateTime              @default(now()) @map("created_at")

  outgoingTransitions WorkflowTransition[] @relation("WorkflowTransitionFromState")
  incomingTransitions WorkflowTransition[] @relation("WorkflowTransitionToState")
  instancesCurrent    WorkflowInstance[]

  @@unique([definitionId, code])
  @@index([tenantId])
  @@map("workflow_states")
}

model WorkflowTransition {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String                   @map("tenant_id") @db.Uuid
  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  definitionId         String                   @map("definition_id") @db.Uuid
  definition           WorkflowDefinition       @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  code                 String
  name                 String
  fromStateId          String                   @map("from_state_id") @db.Uuid
  fromState            WorkflowState            @relation("WorkflowTransitionFromState", fields: [fromStateId], references: [id])
  toStateId            String                   @map("to_state_id") @db.Uuid
  toState              WorkflowState            @relation("WorkflowTransitionToState", fields: [toStateId], references: [id])
  action               WorkflowTransitionAction
  /// When more than one transition shares the same (fromState, action) — e.g. "auto-escalate to
  /// the Principal above ₹50,000, otherwise to the HOD" — conditions are evaluated in descending
  /// priority order and the first whose conditionExpression matches the instance's context wins.
  priority             Int                      @default(0)
  /// A tiny, safe JSON condition tree (see apps/api's condition-evaluator.ts) evaluated against
  /// WorkflowInstance.context — never a stored code string, so there is nothing here that could
  /// execute arbitrary logic. Null means "always eligible".
  conditionExpression  Json?                    @map("condition_expression")
  approvalMode         WorkflowApprovalMode     @default(NONE) @map("approval_mode")
  parallelRule         WorkflowParallelRule?    @map("parallel_rule")
  parallelQuorumCount  Int?                     @map("parallel_quorum_count")
  /// Hours after a task tied to this transition is created before it's considered overdue. Null
  /// means no deadline (never escalates).
  deadlineHours        Int?                     @map("deadline_hours")
  /// Role an overdue task escalates to — plain string, not a Role relation, because the target
  /// role is resolved by code within whichever tenant the instance belongs to at escalation time
  /// (same reason Permission-catalog references are strings elsewhere in this schema).
  escalationRoleCode   String?                  @map("escalation_role_code")
  escalationAfterHours Int?                     @map("escalation_after_hours")
  createdAt            DateTime                 @default(now()) @map("created_at")

  approvers WorkflowTransitionApprover[]
  tasks     WorkflowApprovalTask[]

  @@unique([definitionId, code])
  @@index([tenantId])
  @@index([fromStateId])
  @@map("workflow_transitions")
}

/// One "slot" an approval must pass through. Multiple rows sharing the same transitionId model
/// either a SEQUENTIAL chain (ordered by sequenceOrder — e.g. HOD then Accountant) or a PARALLEL
/// panel (all created together — e.g. any two of three Exam Board members). See
/// WorkflowApproverType for what a slot resolves to.
model WorkflowTransitionApprover {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  transitionId   String               @map("transition_id") @db.Uuid
  transition     WorkflowTransition   @relation(fields: [transitionId], references: [id], onDelete: Cascade)
  approverType   WorkflowApproverType @map("approver_type")
  /// Role.code within this tenant (when approverType = ROLE).
  roleCode       String?              @map("role_code")
  /// A specific tenant User.id (when approverType = SPECIFIC_USER).
  specificUserId String?              @map("specific_user_id") @db.Uuid
  /// Key to read out of WorkflowInstance.context and match against the resolved user's UserRole
  /// scope columns (e.g. "departmentId" -> scopeDepartmentId) — reuses the hierarchical RBAC
  /// scope system verbatim rather than inventing a parallel one. Null means GLOBAL-only holders
  /// of the role are eligible.
  scopeField     String?              @map("scope_field")
  sequenceOrder  Int                  @default(0) @map("sequence_order")
  createdAt      DateTime             @default(now()) @map("created_at")

  tasks WorkflowApprovalTask[]

  @@index([tenantId])
  @@index([transitionId])
  @@map("workflow_transition_approvers")
}

model WorkflowInstance {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  definitionId   String                 @map("definition_id") @db.Uuid
  definition     WorkflowDefinition     @relation(fields: [definitionId], references: [id])
  entityType     String                 @map("entity_type")
  entityId       String                 @map("entity_id")
  currentStateId String                 @map("current_state_id") @db.Uuid
  currentState   WorkflowState          @relation(fields: [currentStateId], references: [id])
  status         WorkflowInstanceStatus @default(IN_PROGRESS)
  /// Arbitrary snapshot the starting module provides (e.g. { amount, departmentId }) — the only
  /// thing condition evaluation and approver-scope resolution ever look at. Updated on
  /// resubmission with whatever the resubmitter provides.
  context        Json?
  startedBy      String?                @map("started_by") @db.Uuid
  startedAt      DateTime               @default(now()) @map("started_at")
  completedAt    DateTime?              @map("completed_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  tasks WorkflowApprovalTask[]

  /// One workflow instance per business record, forever — a resubmission reopens THIS instance
  /// (see WorkflowEngineService.resubmit) rather than spawning a duplicate.
  @@unique([tenantId, entityType, entityId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([definitionId])
  @@map("workflow_instances")
}

model WorkflowApprovalTask {
  id                  String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String                      @map("tenant_id") @db.Uuid
  tenant              Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  instanceId          String                      @map("instance_id") @db.Uuid
  instance            WorkflowInstance            @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  transitionId        String                      @map("transition_id") @db.Uuid
  transition          WorkflowTransition          @relation(fields: [transitionId], references: [id])
  approverSlotId      String?                     @map("approver_slot_id") @db.Uuid
  approverSlot        WorkflowTransitionApprover? @relation(fields: [approverSlotId], references: [id])
  /// Populated at creation for SPECIFIC_USER slots; for ROLE slots stays null until the decision
  /// is made (any matching role/scope holder may decide a pending ROLE task — see
  /// WorkflowApproverResolutionService), then records who actually acted.
  assignedUserId      String?                     @map("assigned_user_id") @db.Uuid
  status              WorkflowTaskStatus          @default(PENDING)
  sequenceOrder       Int                         @default(0) @map("sequence_order")
  dueAt               DateTime?                   @map("due_at")
  decidedByUserId     String?                     @map("decided_by_user_id") @db.Uuid
  decidedAt           DateTime?                   @map("decided_at")
  comment             String?
  escalatedAt         DateTime?                   @map("escalated_at")
  /// Set by the escalation sweep (apps/worker) alongside escalatedAt — widens who may decide
  /// this task to ALSO include holders of this role, without revoking the original approver's
  /// ability to (status stays PENDING; escalation adds an eligible decider, it doesn't replace
  /// one). No approverSlot row exists for this widened eligibility since it isn't part of the
  /// definition's configured chain — it's a runtime SLA response.
  escalatedToRoleCode String?                     @map("escalated_to_role_code")
  createdAt           DateTime                    @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([instanceId])
  @@index([status, dueAt])
  @@index([assignedUserId, status])
  @@map("workflow_approval_tasks")
}

// ---------------------------------------------------------------------------
// Student 360 models (see the header block above for the design notes).
// ---------------------------------------------------------------------------

/// Core identity + profile row for Student 360. fullName is denormalized from
/// first/middle/last names by the students module service (kept denormalized so lists,
/// exports, print-outs, and the timeline don't re-join three columns every time). A student
/// can later link to a User portal account via userId (OWN-scope self-service), but the
/// record exists independently of the login account.
model Student {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String        @map("tenant_id") @db.Uuid
  tenant                Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  campusId              String        @map("campus_id") @db.Uuid
  campus                Campus        @relation(fields: [campusId], references: [id], onDelete: Restrict)
  userId                String?       @map("user_id") @db.Uuid
  admissionNumber       String        @map("admission_number")
  rollNumber            String?       @map("roll_number")
  registrationNumber    String?       @map("registration_number")
  firstName             String        @map("first_name")
  middleName            String?       @map("middle_name")
  lastName              String        @map("last_name")
  fullName              String        @map("full_name")
  gender                StudentGender @default(NOT_SPECIFIED)
  bloodGroup            BloodGroup    @default(UNKNOWN) @map("blood_group")
  dateOfBirth           DateTime?     @map("date_of_birth")
  nationality           String?       @default("Indian")
  category              String?
  /// Current contact information — quick access on the profile/cards. Full communication
  /// history lives in StudentCommunication; guardians live in Guardian.
  email                 String?
  alternateEmail        String?       @map("alternate_email")
  primaryPhone          String?       @map("primary_phone")
  alternatePhone        String?       @map("alternate_phone")
  currentAddressLine1   String?       @map("current_address_line_1")
  currentAddressLine2   String?       @map("current_address_line_2")
  city                  String?
  state                 String?
  postalCode            String?       @map("postal_code")
  country               String?       @default("India")
  permanentAddressLine1 String?       @map("permanent_address_line_1")
  permanentAddressLine2 String?       @map("permanent_address_line_2")
  permanentCity         String?       @map("permanent_city")
  permanentState        String?       @map("permanent_state")
  permanentPostalCode   String?       @map("permanent_postal_code")
  permanentCountry      String?       @default("India") @map("permanent_country")
  profilePhotoKey       String?       @map("profile_photo_key")
  status                StudentStatus @default(APPLICANT)
  /// Current placement snapshot — an at-a-glance "where is this student now". The full,
  /// year-by-year picture lives in StudentEnrollment.
  programId             String?       @map("program_id") @db.Uuid
  program               Program?      @relation(fields: [programId], references: [id], onDelete: SetNull)
  batchId               String?       @map("batch_id") @db.Uuid
  batch                 Batch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)
  sectionId             String?       @map("section_id") @db.Uuid
  section               Section?      @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  academicYearId        String?       @map("academic_year_id") @db.Uuid
  academicYear          AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  admittedOn            DateTime?     @map("admitted_on")
  yearOfAdmission       Int?          @map("year_of_admission")
  createdBy             String?       @map("created_by") @db.Uuid
  updatedBy             String?       @map("updated_by") @db.Uuid
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  /// Soft delete: unlike master data, a student's timeline/history is what other rows point
  /// at, so hard-deleting would orphan it. Archiving (deletedAt) is the removal path; status
  /// transitions are the "state" path.
  deletedAt             DateTime?     @map("deleted_at")

  guardians        Guardian[]
  documents        StudentDocument[]
  admissions       StudentAdmission[]
  academicRecords  StudentAcademicRecord[]
  enrollments      StudentEnrollment[]
  attendance       StudentAttendance[]
  fees             StudentFee[]
  payments         StudentPayment[]
  exams            StudentExam[]
  results          StudentResult[]
  certificates     StudentCertificate[]
  libraryLoans     StudentLibraryLoan[]
  hostelBookings   StudentHostelBooking[]
  transportPasses  StudentTransportPass[]
  holds            StudentHold[]
  statusHistory    StudentStatusHistory[]
  communications   StudentCommunication[]
  activities       StudentActivity[]

  @@unique([tenantId, admissionNumber])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([campusId])
  @@index([programId])
  @@index([batchId])
  @@index([sectionId])
  @@index([tenantId, status])
  @@map("students")
}

/// A student's guardian / family contact / emergency contact. The kind/role taxonomy is an
/// enum because these are well-bounded product concepts; everything else (occupation,
/// address) is free text.
model Guardian {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId         String        @map("student_id") @db.Uuid
  student           Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name              String
  kind              GuardianKind
  role              GuardianRole  @default(PRIMARY)
  phone             String?
  email             String?
  occupation        String?
  monthlyIncomeCents Int?         @map("monthly_income_cents")
  address           String?
  createdBy         String?       @map("created_by") @db.Uuid
  updatedBy         String?       @map("updated_by") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([studentId])
  @@map("guardians")
}

/// Scanned/uploaded student documents (marksheets, ID proof, photos, certificates). Storage
/// key follows the same tenant-prefixed convention as the control-plane Document model;
/// verification is an explicit first-class step so the records office can vet each file.
model StudentDocument {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId        String               @map("student_id") @db.Uuid
  student          Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// e.g. ID_PROOF / ACADEMIC / ADDRESS_PROOF / PHOTO / OTHER — free-form so the tenant's
  /// admissions document checklist (TenantConfiguration) drives what categories exist.
  category         String
  documentName     String               @map("document_name")
  storageKey       String?              @map("storage_key")
  originalFilename String?              @map("original_filename")
  mimeType         String?              @map("mime_type")
  sizeBytes        Int?                 @map("size_bytes")
  status           StudentDocumentStatus @default(PENDING)
  verifiedAt       DateTime?            @map("verified_at")
  verifiedBy       String?              @map("verified_by") @db.Uuid
  remarks          String?
  uploadedBy       String?              @map("uploaded_by") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([studentId])
  @@index([tenantId, status])
  @@map("student_documents")
}

/// Admission history — every admission/application round this student went through (can be
/// more than one: applied, got an offer, deferred, re-admitted). mode is a free-form string
/// (MERIT / MANAGEMENT / LATERAL / DIRECT) so tenant policies don't require a schema change.
model StudentAdmission {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId          String          @map("student_id") @db.Uuid
  student            Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  applicationNumber  String          @map("application_number")
  programId          String          @map("program_id") @db.Uuid
  program            Program         @relation(fields: [programId], references: [id], onDelete: Restrict)
  academicYearId     String?         @map("academic_year_id") @db.Uuid
  academicYear       AcademicYear?   @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  appliedAt          DateTime        @map("applied_at")
  status             AdmissionStatus @default(APPLIED)
  mode               String?
  offerLetterKey     String?         @map("offer_letter_key")
  admissionFeeCents  Int?            @map("admission_fee_cents")
  remarks            String?
  createdBy          String?         @map("created_by") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@unique([tenantId, applicationNumber])
  @@index([tenantId])
  @@index([studentId])
  @@index([programId])
  @@map("student_admissions")
}

/// Academic (prior-education) history — institutions/certificates the student earned before
/// (or alongside) the current program: higher-secondary board marksheet, prior degree, etc.
model StudentAcademicRecord {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String               @map("tenant_id") @db.Uuid
  tenant                 Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId              String               @map("student_id") @db.Uuid
  student                Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  institution            String
  board                  String?
  degree                 String?
  yearOfPassing          Int?                 @map("year_of_passing")
  percentage             Float?
  gpa                    Float?
  grade                  String?
  marksObtained          Int?                 @map("marks_obtained")
  marksOutOf             Int?                 @map("marks_out_of")
  rank                   String?
  isHighestQualification Boolean              @default(false) @map("is_highest_qualification")
  verificationStatus     StudentDocumentStatus @default(PENDING) @map("verification_status")
  remarks                String?
  createdBy              String?              @map("created_by") @db.Uuid
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([studentId])
  @@map("student_academic_records")
}

/// Enrollment history — one row per academic year the student was enrolled in a program
/// (with the section/batch they sat in that year). This is the "which cohort, which year"
/// picture; the admission record captures the application side.
model StudentEnrollment {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId      String           @map("student_id") @db.Uuid
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId String           @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  termId         String?          @map("term_id") @db.Uuid
  term           Term?            @relation(fields: [termId], references: [id], onDelete: SetNull)
  programId      String           @map("program_id") @db.Uuid
  program        Program          @relation(fields: [programId], references: [id], onDelete: Restrict)
  sectionId      String?          @map("section_id") @db.Uuid
  section        Section?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  batchId        String?          @map("batch_id") @db.Uuid
  batch          Batch?           @relation(fields: [batchId], references: [id], onDelete: SetNull)
  rollNumber     String?          @map("roll_number")
  semester       Int?
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime?        @map("enrolled_at")
  completedAt    DateTime?        @map("completed_at")
  remarks        String?
  createdBy      String?          @map("created_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([tenantId, studentId, academicYearId, programId])
  @@index([tenantId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([tenantId, status])
  @@map("student_enrollments")
}

/// Per-student attendance ledger day/class records. attendanceType is free-form (CLASS / DAY /
/// PERIOD) so the timetable module's shape can drive it without a migration.
model StudentAttendance {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId     String           @map("student_id") @db.Uuid
  student       Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date          DateTime         @map("date")
  attendanceType String          @default("CLASS") @map("attendance_type")
  termId        String?          @map("term_id") @db.Uuid
  term          Term?            @relation(fields: [termId], references: [id], onDelete: SetNull)
  subjectCode   String?          @map("subject_code")
  subjectName   String?          @map("subject_name")
  status        AttendanceStatus @default(PRESENT)
  markedByUserId String?         @map("marked_by_user_id") @db.Uuid
  remarks       String?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([studentId])
  @@index([studentId, date])
  @@index([tenantId, status])
  @@map("student_attendance")
}

/// A fee demand line on a student's ledger. status is recomputed by the students module on
/// every create/update/payment from amountCents vs paidCents+waivedCents; OVERDUE is derived
/// at read time when dueDate has passed and the line isn't yet PAID.
model StudentFee {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId   String    @map("student_id") @db.Uuid
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId      String?   @map("term_id") @db.Uuid
  term        Term?     @relation(fields: [termId], references: [id], onDelete: SetNull)
  headCode    String    @map("head_code")
  headName    String    @map("head_name")
  amountCents Int       @map("amount_cents")
  paidCents   Int       @default(0) @map("paid_cents")
  waivedCents Int       @default(0) @map("waived_cents")
  status      FeeStatus @default(ISSUED)
  dueDate     DateTime? @map("due_date")
  remarks     String?
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  payments StudentPayment[]

  @@index([tenantId])
  @@index([studentId])
  @@index([tenantId, status])
  @@index([studentId, status])
  @@map("student_fees")
}

/// Payments recorded against a student's fee ledger. reuses the global PaymentMethod and
/// PaymentStatus enums rather than inventing a parallel taxonomy; recordedByUserId is the
/// tenant staff member who logged the receipt.
model StudentPayment {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId       String        @map("student_id") @db.Uuid
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentFeeId    String?       @map("student_fee_id") @db.Uuid
  studentFee      StudentFee?   @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  receiptNumber   String        @map("receipt_number")
  amountCents     Int           @map("amount_cents")
  currency        String        @default("INR")
  paymentDate     DateTime      @map("payment_date")
  method          PaymentMethod
  status          PaymentStatus @default(SUCCEEDED)
  referenceNumber String?       @map("reference_number")
  recordedByUserId String?      @map("recorded_by_user_id") @db.Uuid
  remarks         String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
  @@index([studentId])
  @@index([studentFeeId])
  @@map("student_payments")
}

/// An exam session this student sits (registered for). Kept student-tethered so the 360 tab
/// shows "their exams"; results hang off it but survive an exam deletion via SET NULL.
model StudentExam {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId  String     @map("student_id") @db.Uuid
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name       String
  examType   ExamType   @map("exam_type")
  termId     String?    @map("term_id") @db.Uuid
  term       Term?      @relation(fields: [termId], references: [id], onDelete: SetNull)
  programId  String?    @map("program_id") @db.Uuid
  program    Program?   @relation(fields: [programId], references: [id], onDelete: SetNull)
  sectionId  String?    @map("section_id") @db.Uuid
  section    Section?   @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  startDate  DateTime?  @map("start_date")
  endDate    DateTime?  @map("end_date")
  status     ExamStatus @default(SCHEDULED)
  createdBy  String?    @map("created_by") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  results StudentResult[]

  @@index([tenantId])
  @@index([studentId])
  @@index([programId])
  @@map("student_exams")
}

/// One subject's result within an exam (or standalone). Outcome drives the pass/fail view;
/// percentage/grade are optional so either grading style (numeric or letter) fits.
model StudentResult {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId   String        @map("student_id") @db.Uuid
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examId      String?       @map("exam_id") @db.Uuid
  exam        StudentExam?  @relation(fields: [examId], references: [id], onDelete: SetNull)
  subjectCode String        @map("subject_code")
  subjectName String        @map("subject_name")
  maxMarks    Int           @map("max_marks")
  obtainedMarks Int?        @map("obtained_marks")
  grade       String?
  percentage  Float?
  outcome     ResultOutcome @default(INCOMPLETE)
  publishedAt DateTime?     @map("published_at")
  publishedBy String?       @map("published_by") @db.Uuid
  remarks     String?
  createdBy   String?       @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([studentId])
  @@index([examId])
  @@map("student_results")
}

/// Certificate / transcript requests and their issuance lifecycle (request → generate →
/// approve → issue).
model StudentCertificate {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId         String             @map("student_id") @db.Uuid
  student           Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  certificateType   CertificateType    @map("certificate_type")
  certificateNumber String?            @map("certificate_number")
  title             String?
  requestDate       DateTime           @map("request_date")
  status            CertificateStatus  @default(REQUESTED)
  generatedAt       DateTime?          @map("generated_at")
  generatedByUserId String?            @map("generated_by_user_id") @db.Uuid
  approvedAt        DateTime?          @map("approved_at")
  approvedByUserId  String?            @map("approved_by_user_id") @db.Uuid
  issuedAt          DateTime?          @map("issued_at")
  issuedByUserId    String?            @map("issued_by_user_id") @db.Uuid
  storageKey        String?            @map("storage_key")
  remarks           String?
  createdBy         String?            @map("created_by") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@unique([tenantId, certificateNumber])
  @@index([tenantId])
  @@index([studentId])
  @@index([tenantId, status])
  @@map("student_certificates")
}

/// Library loans for this student (items are free-form strings — the dedicated library
/// catalog module is a later phase and will attach its own catalog item ids here).
model StudentLibraryLoan {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId   String            @map("student_id") @db.Uuid
  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  itemTitle   String            @map("item_title")
  itemAuthor  String?           @map("item_author")
  itemCode    String?           @map("item_code")
  itemType    String?           @map("item_type")
  borrowedAt  DateTime          @map("borrowed_at")
  dueDate     DateTime?         @map("due_date")
  returnedAt  DateTime?         @map("returned_at")
  status      LibraryLoanStatus @default(ISSUED)
  fineCents   Int               @default(0) @map("fine_cents")
  remarks     String?
  createdBy   String?           @map("created_by") @db.Uuid
  updatedBy   String?           @map("updated_by") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([studentId])
  @@index([tenantId, status])
  @@map("student_library_loans")
}

/// Hostel allocation/booking for this student across their stay.
model StudentHostelBooking {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId       String              @map("student_id") @db.Uuid
  student         Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  hostelName      String              @map("hostel_name")
  roomNumber      String              @map("room_number")
  bedNumber       String?             @map("bed_number")
  allocationDate  DateTime?           @map("allocation_date")
  checkInDate     DateTime?           @map("check_in_date")
  checkOutDate    DateTime?           @map("check_out_date")
  status          HostelBookingStatus @default(REQUESTED)
  monthlyRentCents Int?               @map("monthly_rent_cents")
  remarks         String?
  createdBy       String?             @map("created_by") @db.Uuid
  updatedBy       String?             @map("updated_by") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([studentId])
  @@index([tenantId, status])
  @@map("student_hostel_bookings")
}

/// Transport pass / route allocation for this student.
model StudentTransportPass {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId     String               @map("student_id") @db.Uuid
  student       Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  routeCode     String?              @map("route_code")
  routeName     String               @map("route_name")
  pickupPoint   String?              @map("pickup_point")
  dropPoint     String?              @map("drop_point")
  vehicleNumber String?              @map("vehicle_number")
  periodStart   DateTime             @map("period_start")
  periodEnd     DateTime?            @map("period_end")
  status        TransportPassStatus  @default(ACTIVE)
  amountCents   Int?                 @map("amount_cents")
  remarks       String?
  createdBy     String?              @map("created_by") @db.Uuid
  updatedBy     String?              @map("updated_by") @db.Uuid
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([studentId])
  @@index([tenantId, status])
  @@map("student_transport_passes")
}

/// A hold/flag on the student's record (academic/financial/administrative/etc.) — e.g.
/// blocks a transcript request until a fee is resolved. Holds are lifted, never deleted.
model StudentHold {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId        String           @map("student_id") @db.Uuid
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type             StudentHoldType
  reason           String
  placedOn         DateTime         @map("placed_on")
  placedByUserId   String?          @map("placed_by_user_id") @db.Uuid
  status           StudentHoldStatus @default(ACTIVE)
  liftedOn         DateTime?        @map("lifted_on")
  liftedByUserId   String?          @map("lifted_by_user_id") @db.Uuid
  remarks          String?
  createdBy        String?          @map("created_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([studentId])
  @@index([tenantId, status])
  @@map("student_holds")
}

/// Append-only status transition journal for a student. The first row for a student has a null
/// fromStatus (created into its initial state).
model StudentStatusHistory {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId        String         @map("student_id") @db.Uuid
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromStatus       StudentStatus? @map("from_status")
  toStatus         StudentStatus  @map("to_status")
  reason           String?
  changedByUserId  String?        @map("changed_by_user_id") @db.Uuid
  changedAt        DateTime       @default(now()) @map("changed_at")

  @@index([tenantId])
  @@index([studentId])
  @@index([studentId, changedAt])
  @@map("student_status_history")
}

/// Communication history with the student / their guardians (calls, emails, SMS, meetings…).
model StudentCommunication {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId        String               @map("student_id") @db.Uuid
  student          Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type             CommunicationType
  direction        CommunicationDirection @default(OUTBOUND)
  subject          String?
  body             String
  sentAt           DateTime             @map("sent_at")
  recipientType    String               @default("STUDENT") @map("recipient_type")
  recipientName    String?              @map("recipient_name")
  recipientPhone   String?              @map("recipient_phone")
  recipientEmail   String?              @map("recipient_email")
  conductedByUserId String?             @map("conducted_by_user_id") @db.Uuid
  remarks          String?
  createdBy        String?              @map("created_by") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([studentId])
  @@index([studentId, sentAt])
  @@map("student_communications")
}

/// Append-only activity timeline for Student 360. eventType is a free-form string (e.g.
/// student.created / student.status_changed / fee.payment_recorded / hold.placed) so modules
/// can log events without a schema change; entityType/entityId point at the related row
/// (payment, hold, certificate…). The timeline endpoint unions these with status-history rows.
model StudentActivity {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId   String    @map("student_id") @db.Uuid
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  eventType   String    @map("event_type")
  title       String
  description String?
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id") @db.Uuid
  occurredAt  DateTime  @default(now()) @map("occurred_at")
  actorUserId String?   @map("actor_user_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([studentId])
  @@index([studentId, occurredAt])
  @@map("student_activities")
}
