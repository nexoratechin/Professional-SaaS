// College ERP SaaS — Foundation + Organization domains
//
// Foundation (Phase 1): tenants, users, roles, permissions, user_roles, sessions, login_events
// — the SaaS control plane and tenant identity/RBAC core.
// Organization: campuses, departments, academic_years, terms, rooms PLUS buildings, sections,
// batches — master data every later academic/admissions/attendance/exam module anchors to. The
// schema, RBAC permissions, and tenant-isolation wiring are complete, AND a full CRUD API module
// (search/filter/import/export + scoped permissions) ships with it — see apps/api's organization
// module — so later work has a stable, usable foundation to build on.
//
// Conventions applied across every model in this file:
// - Primary keys are database-generated UUIDs (`gen_random_uuid()`, native to Postgres 13+ —
//   pgcrypto is enabled defensively in the migration for older Postgres compatibility), not
//   cuid()s, per this project's "production-grade" requirement.
// - Every tenant-owned model carries a real, required, indexed, FK'd tenantId column — even
//   where derivable through a parent relation — so tenant-isolation enforcement (see
//   packages/database/src/client.ts) can be mechanical (driven off the DMMF) rather than bespoke
//   per model. Tenant relations use onDelete: Restrict; tenants are status-transitioned, not
//   hard-deleted.
// - createdBy/updatedBy are plain nullable UUID columns, not enforced Prisma relations: the
//   actor may be a tenant User OR a PlatformUser (see PlatformAuditLog, which already
//   disambiguates actor type for the full audit trail) — these columns are a lightweight
//   "who touched this last" convenience, not the system of record for authorship.
// - Soft deletion (deletedAt) is added where records are reference/master data that other rows
//   go on to point at (campuses, departments, academic years, terms, rooms, custom roles) —
//   hard-deleting these would orphan history. It's deliberately NOT added to Tenant/User (their
//   status enums already model "gone" without a second, competing concept) or to join/log tables
//   (an assignment's existence is itself binary; sessions/login events are immutable).
// - Known trade-off: Prisma's schema DSL has no partial/filtered unique index support, so
//   `@@unique([tenantId, code])`-style constraints on soft-deletable models apply even to
//   soft-deleted rows — a soft-deleted campus/department/etc.'s code stays reserved rather than
//   becoming reusable. Acceptable for now; revisit with a hand-written partial index migration
//   if code reuse after deletion becomes a real product requirement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
  ONE_TIME
}

/// SUSPENDED is distinct from PAST_DUE: PAST_DUE is a billing grace period (the tenant still has
/// access while a payment is chased), SUSPENDED is a deliberate access cutoff (manual admin
/// action — see SaasService.suspendSubscription) or Tenant.status mirroring a tenant-level
/// suspension. Both differ from CANCELED (final, requester-initiated end of service) and EXPIRED
/// (the current billing period elapsed with nothing to renew it).
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  EXPIRED
}

/// CUSTOM makes negotiated/one-off pricing an explicit, queryable line-item type rather than
/// overloading BASE — e.g. a hand-negotiated discount or a one-time setup fee for a specific
/// tenant, never derived from the Plan's own catalog pricing.
enum SubscriptionItemType {
  BASE
  PER_STUDENT
  PER_CAMPUS
  ADDON_MODULE
  CUSTOM
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum PlatformUserRole {
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
}

enum LoginEventResult {
  SUCCESS
  FAILED_PASSWORD
  FAILED_TENANT_SUSPENDED
  FAILED_USER_INACTIVE
  FAILED_UNKNOWN_EMAIL
  FAILED_ACCOUNT_LOCKED
  FAILED_SUSPICIOUS_LOGIN_BLOCKED
}

enum AuditScope {
  PLATFORM
  TENANT
}

enum RoomType {
  CLASSROOM
  LABORATORY
  SEMINAR_HALL
  AUDITORIUM
  LIBRARY
  OFFICE
  OTHER
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum DocumentStatus {
  PENDING_UPLOAD
  UPLOADED
}

enum PermissionAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  APPROVE
  PUBLISH
  EXPORT
  REFUND
  MANAGE
}

/// What a role's grant of a permission is narrowed to. The TYPE lives on RolePermission (part
/// of the role's definition — e.g. "HOD's students.view is department-scoped" is a fact about
/// the HOD role, not about any one assignment); the concrete VALUE (which department) lives on
/// UserRole (bound per assignment — Dr. Smith's HOD assignment is for the CS department, Dr.
/// Jones's is for Physics, same role). OWN means "records the acting user is themselves the
/// subject of" (a student viewing their own grades) — enforced by the owning module's queries
/// once that module exists, not by RBAC itself.
enum PermissionScopeType {
  GLOBAL
  CAMPUS
  DEPARTMENT
  PROGRAM
  OWN
}

/// A single, structured, typed timeline distinct from PlatformAuditLog's generic CRUD/action
/// trail — purpose-built for a "Security" feed (MFA changes, backup-code use, device trust,
/// suspicious logins, lockouts, password changes). Polymorphic actor (nullable tenantId/userId/
/// platformUserId), same convention as PlatformAuditLog, because it is the one security concept
/// that spans BOTH the tenant-user and platform-admin realms — every other new security model in
/// this file stays tenant-scoped-only (see the User/PlatformUser section header for the scoping
/// rationale).
enum SecurityEventType {
  MFA_ENABLED
  MFA_DISABLED
  MFA_CHALLENGE_SUCCEEDED
  MFA_CHALLENGE_FAILED
  BACKUP_CODE_USED
  BACKUP_CODES_REGENERATED
  NEW_DEVICE_LOGIN
  SUSPICIOUS_LOGIN_FLAGGED
  SUSPICIOUS_LOGIN_BLOCKED
  TRUSTED_DEVICE_ADDED
  TRUSTED_DEVICE_REVOKED
  PASSWORD_CHANGED
  PASSWORD_REUSE_BLOCKED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  SESSION_REVOKED
  ALL_SESSIONS_REVOKED
}

enum SecurityEventSeverity {
  INFO
  WARNING
  CRITICAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

/// Lifecycle of a payment attempt against an invoice: PENDING (recorded, awaiting settlement),
/// SUCCEEDED (reconciled — marks the invoice PAID on transition), FAILED (rejection — the
/// invoice stays open and can be retried within the grace period), REFUNDED (post-settlement
/// reversal; the invoice stays PAID).
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

/// How a subscription payment was collected. No real gateway is wired yet (the payments module
/// is Phase 6+), so manual/offline reconciliation is the primary mode; gateway methods exist so
/// a future integration maps onto the same model without a migration.
enum PaymentMethod {
  CARD
  UPI
  BANK_TRANSFER
  CASH
  OFFLINE
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// BOOLEAN entitlements are on/off (mirrors the existing FeatureFlag semantics — "can this
/// tenant see the admissions module at all"). QUANTITY entitlements carry a numeric limit
/// (e.g. "max 5 campuses", "max 2000 students") that a module can check against a live count.
enum EntitlementType {
  BOOLEAN
  QUANTITY
}

/// Where a materialized Entitlement row's value came from — recorded so EntitlementsService.
/// recompute() can safely delete-and-rebuild PLAN/PLAN_MODULE/SUBSCRIPTION_ITEM-sourced rows on
/// every plan/subscription change while leaving TENANT_OVERRIDE rows (a platform admin's manual,
/// one-off grant for a specific tenant) untouched — the same override-survives-recompute contract
/// TenantFeatureFlag already has with Plan.planFeatures, just generalized to also cover quantities.
enum EntitlementSource {
  PLAN
  PLAN_MODULE
  TENANT_OVERRIDE
  SUBSCRIPTION_ITEM
}

/// Category a WorkflowState falls into — lets the engine ask "is this instance done, and how"
/// generically (no module needs to hardcode which specific state codes count as "approved" for
/// its own workflow) rather than by comparing against a hardcoded state code string.
enum WorkflowStateCategory {
  INITIAL
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
}

/// The action that fires a WorkflowTransition. SUBMIT starts an instance (from no state / the
/// initial state); APPROVE/REJECT are approver decisions; RESUBMIT re-enters the flow after a
/// rejection that allows it (see WorkflowState.allowsResubmission); ESCALATE is system-triggered
/// when a task's deadline passes (see WorkflowTransition.escalationAfterHours); CANCEL is a
/// manual withdrawal by the requester or an administrator.
enum WorkflowTransitionAction {
  SUBMIT
  APPROVE
  REJECT
  RESUBMIT
  ESCALATE
  CANCEL
}

/// NONE: the transition fires automatically with no approval step (e.g. straight-through
/// submission). SEQUENTIAL: WorkflowTransitionApprover slots are satisfied one at a time in
/// sequenceOrder — the next slot's task is only created once the current one is approved.
/// PARALLEL: every slot's task is created at once; WorkflowTransition.parallelRule decides when
/// enough decisions have come in to resolve the transition.
enum WorkflowApprovalMode {
  NONE
  SEQUENTIAL
  PARALLEL
}

/// How a PARALLEL transition resolves once approver decisions start coming in. ALL: every slot
/// must approve (a single rejection fails it immediately). ANY: the first decision (approve or
/// reject) wins. QUORUM: parallelQuorumCount approvals are needed; the transition fails early if
/// enough slots have rejected that quorum becomes mathematically impossible.
enum WorkflowParallelRule {
  ALL
  ANY
  QUORUM
}

/// Who can act on a WorkflowTransitionApprover slot. ROLE (the common, non-hardcoded case):
/// anyone holding the given tenant Role — narrowed to WorkflowInstance.context[scopeField] via
/// the SAME UserRole scope columns the hierarchical RBAC system already uses (no separate
/// approver-scope concept). SPECIFIC_USER: a single named user id, for the rare singleton
/// approver (e.g. "the Principal", when that's one specific account rather than a role).
enum WorkflowApproverType {
  ROLE
  SPECIFIC_USER
}

enum WorkflowInstanceStatus {
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
}

enum WorkflowTaskStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
  EXPIRED
  SKIPPED
}

// ---------------------------------------------------------------------------
// SaaS control plane
// ---------------------------------------------------------------------------

model Tenant {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String       @unique
  name         String
  status       TenantStatus @default(TRIAL)
  billingEmail String       @map("billing_email")
  timezone     String       @default("Asia/Kolkata")
  createdBy    String?      @map("created_by") @db.Uuid
  updatedBy    String?      @map("updated_by") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  subscriptions               Subscription[]
  subscriptionItems           SubscriptionItem[]
  featureOverrides            TenantFeatureFlag[]
  usageEvents                 UsageEvent[]
  users                       User[]
  roles                       Role[]
  rolePermissions             RolePermission[]
  userRoles                   UserRole[]
  sessions                    Session[]
  loginEvents                 LoginEvent[]
  auditLogs                   PlatformAuditLog[]
  campuses                    Campus[]
  departments                 Department[]
  programs                    Program[]
  academicYears               AcademicYear[]
  terms                       Term[]
  rooms                       Room[]
  buildings                   Building[]
  sections                    Section[]
  batches                     Batch[]
  notifications               Notification[]
  documents                   Document[]
  passwordResetTokens         PasswordResetToken[]
  emailVerificationTokens     EmailVerificationToken[]
  mfaBackupCodes              MfaBackupCode[]
  trustedDevices              TrustedDevice[]
  passwordHistory             PasswordHistory[]
  securityEvents              SecurityEvent[]
  securitySettings            TenantSecuritySettings?
  configuration              TenantConfiguration?
  workflowDefinitions         WorkflowDefinition[]
  workflowStates              WorkflowState[]
  workflowTransitions         WorkflowTransition[]
  workflowTransitionApprovers WorkflowTransitionApprover[]
  workflowInstances           WorkflowInstance[]
  workflowApprovalTasks       WorkflowApprovalTask[]
  invoices                    Invoice[]
  invoiceLineItems            InvoiceLineItem[]
  payments                    Payment[]
  supportTickets              SupportTicket[]
  entitlements                Entitlement[]
  students                    Student[]
  guardians                   Guardian[]
  studentDocuments            StudentDocument[]
  studentAdmissions           StudentAdmission[]
  studentAcademicRecords      StudentAcademicRecord[]
  studentEnrollments          StudentEnrollment[]
  studentAttendance           StudentAttendance[]
  studentFees                 StudentFee[]
  studentPayments             StudentPayment[]
  studentExams                StudentExam[]
  studentResults              StudentResult[]
  studentCertificates         StudentCertificate[]
  studentLibraryLoans         StudentLibraryLoan[]
  studentHostelBookings       StudentHostelBooking[]
  studentTransportPasses      StudentTransportPass[]
  studentHolds                StudentHold[]
  studentStatusHistory        StudentStatusHistory[]
  studentCommunications       StudentCommunication[]
  studentActivities           StudentActivity[]

  @@index([status])
  @@map("tenants")
}

model Plan {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  description  String?
  priceCents   Int?         @map("price_cents")
  currency     String       @default("INR")
  billingCycle BillingCycle @default(ANNUAL) @map("billing_cycle")
  isCustom     Boolean      @default(false) @map("is_custom")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  subscriptions Subscription[]
  planFeatures  PlanFeatureFlag[]
  planModules   PlanModule[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String             @map("tenant_id") @db.Uuid
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  planId             String             @map("plan_id")
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(TRIALING)
  billingCycle       BillingCycle       @map("billing_cycle")
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  canceledAt         DateTime?          @map("canceled_at")
  /// True when the tenant (or an admin on their behalf) has opted out of auto-renewal: the
  /// subscription keeps service through the current period end, then the worker sweep turns it
  /// CANCELED instead of renewing it. Reversing it (reinstate) lets the subscription renew again.
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  items    SubscriptionItem[]
  invoices Invoice[]
  payments Payment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("subscriptions")
}

/// moduleKey is only set on items that grant an entitlement — ADDON_MODULE (a catalog module
/// purchased directly on this subscription rather than bundled via Plan.planModules) and CUSTOM
/// items representing a negotiated one-off feature grant. It is null for BASE/PER_STUDENT/
/// PER_CAMPUS items, which are pure billing quantities (student/campus counts) with nothing to
/// materialize as an Entitlement — see EntitlementsService.recompute.
model SubscriptionItem {
  id             String               @id @default(cuid())
  tenantId       String               @map("tenant_id") @db.Uuid
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscriptionId String               @map("subscription_id")
  subscription   Subscription         @relation(fields: [subscriptionId], references: [id])
  itemType       SubscriptionItemType @map("item_type")
  description    String
  moduleKey      String?              @map("module_key")
  quantity       Int                  @default(1)
  unitPriceCents Int                  @map("unit_price_cents")
  currency       String               @default("INR")
  createdAt      DateTime             @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([subscriptionId])
  @@map("subscription_items")
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  module      String
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  planFeatures    PlanFeatureFlag[]
  tenantOverrides TenantFeatureFlag[]

  @@map("feature_flags")
}

model PlanFeatureFlag {
  id            String      @id @default(cuid())
  planId        String      @map("plan_id")
  plan          Plan        @relation(fields: [planId], references: [id])
  featureFlagId String      @map("feature_flag_id")
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id])

  @@unique([planId, featureFlagId])
  @@map("plan_feature_flags")
}

/// A named add-on capacity/module bundled into a Plan — e.g. "5 extra campuses" or "library
/// module" — distinct from PlanFeatureFlag (a plain boolean on/off toggle). moduleKey is a
/// free-form catalog key (not an FK to FeatureFlag) since a module can grant a QUANTITY limit
/// that no boolean FeatureFlag models today. No tenantId — like Plan/PlanFeatureFlag this is
/// pure catalog data, only ever read/written through PlatformPrismaService.
model PlanModule {
  id            String          @id @default(cuid())
  planId        String          @map("plan_id")
  plan          Plan            @relation(fields: [planId], references: [id])
  moduleKey     String          @map("module_key")
  name          String
  type          EntitlementType @default(BOOLEAN)
  /// Only meaningful when type = QUANTITY (e.g. limitValue = 5 extra campuses). Null for BOOLEAN.
  limitValue    Int?            @map("limit_value")
  createdAt     DateTime        @default(now()) @map("created_at")

  @@unique([planId, moduleKey])
  @@map("plan_modules")
}

model TenantFeatureFlag {
  id                      String      @id @default(cuid())
  tenantId                String      @map("tenant_id") @db.Uuid
  tenant                  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  featureFlagId           String      @map("feature_flag_id")
  featureFlag             FeatureFlag @relation(fields: [featureFlagId], references: [id])
  enabled                 Boolean
  reason                  String?
  createdByPlatformUserId String?     @map("created_by_platform_user_id")
  createdAt               DateTime    @default(now()) @map("created_at")

  @@unique([tenantId, featureFlagId])
  @@index([tenantId])
  @@map("tenant_feature_flags")
}

model UsageEvent {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  eventType  String   @map("event_type")
  quantity   Decimal  @db.Decimal(18, 4)
  occurredAt DateTime @default(now()) @map("occurred_at")
  metadata   Json?

  @@index([tenantId, eventType, occurredAt])
  @@map("usage_events")
}

/// The single materialized source of truth entitlement resolution reads from (see
/// EntitlementsService.recompute, called whenever a tenant's subscription/plan/plan-modules
/// change) — TenantFeaturesService.getEffectiveFeatures/isEnabled read Entitlement rows instead
/// of live-joining Plan.planFeatures, so a plan swap or module grant takes effect on the very
/// next request with no code deployment. `key` is either a FeatureFlag.key (BOOLEAN, sourced
/// from PLAN/TENANT_OVERRIDE) or a PlanModule.moduleKey (BOOLEAN or QUANTITY, sourced from
/// PLAN_MODULE/SUBSCRIPTION_ITEM). `effectiveUntil` is set to the owning Subscription's
/// currentPeriodEnd at recompute time so an expired subscription's entitlements self-heal
/// (queries filter on effectiveUntil) without the worker needing to run any entitlement logic
/// itself — see EntitlementsService.isEntitled/getEffectiveFeatures. TENANT_OVERRIDE rows have
/// effectiveUntil = null (they don't expire with a billing period) and are the only source
/// recompute() preserves rather than deletes-and-rebuilds.
model Entitlement {
  id             String            @id @default(cuid())
  tenantId       String            @map("tenant_id") @db.Uuid
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  key            String
  type           EntitlementType   @default(BOOLEAN)
  boolValue      Boolean           @default(false) @map("bool_value")
  /// Only meaningful when type = QUANTITY. Null for BOOLEAN.
  limitValue     Int?              @map("limit_value")
  source         EntitlementSource
  /// The Plan.id, PlanModule.id, or SubscriptionItem.id this row was materialized from —
  /// informational only (recompute always regenerates from the live subscription, never reads
  /// this back), null for TENANT_OVERRIDE.
  sourceRef      String?           @map("source_ref")
  effectiveFrom  DateTime          @default(now()) @map("effective_from")
  effectiveUntil DateTime?         @map("effective_until")
  reason         String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("entitlements")
}

/// Platform-generated billing record for one tenant's subscription period. Always written
/// through PlatformPrismaService with an explicit tenantId (same convention as
/// Subscription/UsageEvent above) — tenant admins never create or edit these, only view their
/// own via the tenant self-service read endpoint. No payment-gateway integration exists yet
/// (Phase 6+) — `markPaid`/`void` are manual platform-admin reconciliation actions.
model Invoice {
  id                      String        @id @default(cuid())
  tenantId                String        @map("tenant_id") @db.Uuid
  tenant                  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscriptionId          String?       @map("subscription_id")
  subscription            Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoiceNumber           String        @unique @map("invoice_number")
  status                  InvoiceStatus @default(DRAFT)
  currency                String        @default("INR")
  subtotalCents           Int           @map("subtotal_cents")
  taxCents                Int           @default(0) @map("tax_cents")
  totalCents              Int           @map("total_cents")
  periodStart             DateTime      @map("period_start")
  periodEnd               DateTime      @map("period_end")
  issuedAt                DateTime?     @map("issued_at")
  dueAt                   DateTime?     @map("due_at")
  paidAt                  DateTime?     @map("paid_at")
  voidedAt                DateTime?     @map("voided_at")
  createdByPlatformUserId String?       @map("created_by_platform_user_id")
  /// MinIO/S3 key of the generated invoice PDF (always under the owning tenant's prefix, so
  /// StorageService's tenant-key assertion applies). Null until the first time the PDF is
  /// rendered — generation is lazy and re-runnable, so a failed upload never bricks a download.
  pdfStorageKey           String?       @map("pdf_storage_key")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("invoices")
}

/// A single payment attempt against a subscription invoice. Every invoice lines up N payments
/// (typically one, but retries produce sequential attempts; the lifecycle sweep also records
/// auto-charges). Payments are platform control-plane data (like Subscription/Invoice): always
/// reached through PlatformPrismaService with explicit tenantId/invoiceId filtering — never the
/// tenant-guard extension.
model Payment {
  id            String        @id @default(cuid())
  tenantId      String        @map("tenant_id") @db.Uuid
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscriptionId String       @map("subscription_id")
  subscription  Subscription  @relation(fields: [subscriptionId], references: [id])
  invoiceId     String        @map("invoice_id")
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])
  amountCents   Int           @map("amount_cents")
  currency      String        @default("INR")
  status        PaymentStatus @default(PENDING)
  method        PaymentMethod
  /// External gateway transaction id for a real integration (Phase 6+/payments module); null
  /// for manual/offline reconciliation, which is the only mode today.
  gatewayReference String? @unique @map("gateway_reference")
  failureReason String?       @map("failure_reason")
  paidAt        DateTime?     @map("paid_at")
  refundedAt    DateTime?     @map("refunded_at")
  createdByPlatformUserId String? @map("created_by_platform_user_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([invoiceId])
  @@index([subscriptionId])
  @@index([status])
  @@map("payments")
}

/// SaaS-wide billing knobs, enforced by both apps/api and apps/worker (subscription-lifecycle
/// sweep). A single 'default' row. Tax rate is in basis points (1800 = 18%); invoice
/// numbering is sequential under a configurable prefix using next_invoice_sequence as an
/// atomic counter (see InvoicesService.allocateInvoiceNumber). gracePeriodDays is how long a
/// PAST_DUE subscription keeps access with an overdue invoice before the worker SUSPENDs it;
/// retryIntervalDays is how often the same sweep re-attempts a failed payment.
model BillingConfig {
  id                      String   @id @default("default")
  taxName                 String   @default("GST") @map("tax_name")
  taxRateBps              Int      @default(1800) @map("tax_rate_bps")
  invoicePrefix           String   @default("INV") @map("invoice_prefix")
  nextInvoiceSequence     Int      @default(1) @map("next_invoice_sequence")
  gracePeriodDays         Int      @default(7) @map("grace_period_days")
  renewalDueDays          Int      @default(15) @map("renewal_due_days")
  retryIntervalDays       Int      @default(1) @map("retry_interval_days")
  prorationEnabled        Boolean  @default(true) @map("proration_enabled")
  updatedByPlatformUserId String?  @map("updated_by_platform_user_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("billing_config")
}

model InvoiceLineItem {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id") @db.Uuid
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoiceId      String   @map("invoice_id")
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int      @default(1)
  unitPriceCents Int      @map("unit_price_cents")
  amountCents    Int      @map("amount_cents")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_line_items")
}

/// Support request tracked by the platform ops team. tenantId is OPTIONAL (same convention as
/// LoginEvent/PlatformAuditLog) — a ticket can be tenant-specific (raised by a tenant user, or by
/// a platform admin on a tenant's behalf) or a general platform issue with no tenant at all.
/// Always accessed via PlatformPrismaService with explicit tenantId filtering when a tenant
/// context is involved — never the tenant-guard extension (this is control-plane data).
model SupportTicket {
  id                       String                @id @default(cuid())
  tenantId                 String?               @map("tenant_id") @db.Uuid
  tenant                   Tenant?               @relation(fields: [tenantId], references: [id])
  subject                  String
  description              String
  status                   SupportTicketStatus   @default(OPEN)
  priority                 SupportTicketPriority @default(MEDIUM)
  raisedByUserId           String?               @map("raised_by_user_id") @db.Uuid
  raisedByPlatformUserId   String?               @map("raised_by_platform_user_id")
  assignedToPlatformUserId String?               @map("assigned_to_platform_user_id")
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")
  resolvedAt               DateTime?             @map("resolved_at")

  comments SupportTicketComment[]

  @@index([tenantId])
  @@index([status])
  @@index([assignedToPlatformUserId])
  @@map("support_tickets")
}

model SupportTicketComment {
  id                   String        @id @default(cuid())
  ticketId             String        @map("ticket_id")
  ticket               SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType           String        @map("author_type")
  authorUserId         String?       @map("author_user_id") @db.Uuid
  authorPlatformUserId String?       @map("author_platform_user_id")
  body                 String
  createdAt            DateTime      @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("support_ticket_comments")
}

/// The single centralized, append-only audit trail for both platform- and tenant-level
/// sensitive actions across every module (auth, RBAC, users, tenants, subscriptions, documents,
/// notifications, security config, and — once built — the business modules like
/// students/fees/payments/exams). `module` classifies WHICH subsystem produced the entry (see
/// packages/auth's AUDIT_MODULES) so the searchable audit UI can filter by it independently of
/// `action`/`entityType`. `requestId` correlates every entry written during the same inbound
/// HTTP request (see apps/api's RequestIdMiddleware) even across multiple audit writes in one
/// handler. `actorEmail` is a denormalized snapshot of the actor's email AT THE TIME of the
/// action — captured once by AuditService itself (not threaded through every call site) so the
/// trail stays human-readable even if the underlying user is later renamed, deactivated, or the
/// tenant is long gone.
/// Known DB-level control not expressible in the Prisma schema DSL: a BEFORE UPDATE OR DELETE
/// trigger (added by migration 20260907170000_add_centralized_immutable_audit_log) rejects any
/// attempt to mutate or remove a row here, even via raw SQL or a future application bug —
/// AuditService itself also only ever INSERTs (no update/delete method exists on it).
model PlatformAuditLog {
  id                  String     @id @default(cuid())
  scope               AuditScope
  tenantId            String?    @map("tenant_id") @db.Uuid
  tenant              Tenant?    @relation(fields: [tenantId], references: [id])
  actorType           String     @map("actor_type")
  actorUserId         String?    @map("actor_user_id") @db.Uuid
  actorPlatformUserId String?    @map("actor_platform_user_id")
  /// Denormalized snapshot, not a live relation — see model doc comment.
  actorEmail          String?    @map("actor_email")
  action              String
  /// Which subsystem produced this entry — see packages/auth's AUDIT_MODULES.
  module              String     @default("platform")
  entityType          String     @map("entity_type")
  entityId            String?    @map("entity_id")
  before              Json?
  after               Json?
  ipAddress           String?    @map("ip_address")
  userAgent           String?    @map("user_agent")
  /// Correlates every audit entry written during the same inbound HTTP request — see
  /// apps/api's RequestIdMiddleware. Null for entries written outside an HTTP request (seed
  /// scripts, background jobs).
  requestId           String?    @map("request_id")
  createdAt           DateTime   @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@index([module, createdAt])
  @@index([requestId])
  @@index([actorEmail])
  @@map("platform_audit_logs")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model PlatformUser {
  id                  String           @id @default(cuid())
  email               String           @unique
  passwordHash        String           @map("password_hash")
  fullName            String           @map("full_name")
  role                PlatformUserRole @default(PLATFORM_SUPPORT)
  isActive            Boolean          @default(true) @map("is_active")
  failedLoginAttempts Int              @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?        @map("locked_until")
  /// MFA/TOTP for the platform-admin realm mirrors the tenant-user realm's mechanism (same
  /// packages/auth core, same AES-256-GCM-at-rest encryption) since PlatformUser is the
  /// highest-privilege account in the whole system. Deliberately NOT extended with trusted
  /// devices / suspicious-login detection / password history — see PlatformMfaService's doc
  /// comment for that scope boundary.
  mfaEnabled          Boolean          @default(false) @map("mfa_enabled")
  mfaSecretEncrypted  String?          @map("mfa_secret_encrypted")
  mfaEnabledAt        DateTime?        @map("mfa_enabled_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  sessions       PlatformSession[]
  mfaBackupCodes PlatformMfaBackupCode[]
  securityEvents SecurityEvent[]

  @@map("platform_users")
}

model PlatformSession {
  id               String       @id @default(cuid())
  platformUserId   String       @map("platform_user_id")
  platformUser     PlatformUser @relation(fields: [platformUserId], references: [id])
  refreshTokenHash String       @unique @map("refresh_token_hash")
  userAgent        String?      @map("user_agent")
  ipAddress        String?      @map("ip_address")
  expiresAt        DateTime     @map("expires_at")
  revokedAt        DateTime?    @map("revoked_at")
  lastUsedAt       DateTime     @default(now()) @map("last_used_at")
  createdAt        DateTime     @default(now()) @map("created_at")

  @@index([platformUserId])
  @@map("platform_sessions")
}

model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String     @map("tenant_id") @db.Uuid
  tenant              Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  email               String
  passwordHash        String?    @map("password_hash")
  fullName            String     @map("full_name")
  status              UserStatus @default(INVITED)
  emailVerifiedAt     DateTime?  @map("email_verified_at")
  lastLoginAt         DateTime?  @map("last_login_at")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  /// TOTP secret is encrypted at rest (AES-256-GCM, apps/api's MfaSecretCipher) — unlike
  /// refresh/reset tokens it must be decryptable to verify a 6-digit code, so it can't be a
  /// one-way hash. mfaEnabled flips true only after enroll+confirm succeeds (see MfaService) —
  /// a secret can exist mid-enrollment without mfaEnabled being true yet.
  mfaEnabled          Boolean    @default(false) @map("mfa_enabled")
  mfaSecretEncrypted  String?    @map("mfa_secret_encrypted")
  mfaEnabledAt        DateTime?  @map("mfa_enabled_at")
  createdBy           String?    @map("created_by") @db.Uuid
  updatedBy           String?    @map("updated_by") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  userRoles               UserRole[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  mfaBackupCodes          MfaBackupCode[]
  trustedDevices          TrustedDevice[]
  passwordHistory         PasswordHistory[]
  securityEvents          SecurityEvent[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("users")
}

model Role {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code      String
  name      String
  isSystem  Boolean   @default(false) @map("is_system")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique
  module      String
  action      PermissionAction
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@index([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roleId       String              @map("role_id") @db.Uuid
  role         Role                @relation(fields: [roleId], references: [id])
  permissionId String              @map("permission_id") @db.Uuid
  permission   Permission          @relation(fields: [permissionId], references: [id])
  /// What kind of scope this role's grant of this permission operates under — see
  /// PermissionScopeType. The concrete scope VALUE (which campus/department/program) is bound
  /// per user assignment on UserRole, not here.
  scopeType    PermissionScopeType @default(GLOBAL) @map("scope_type")
  createdBy    String?             @map("created_by") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at")

  @@unique([roleId, permissionId])
  @@index([tenantId])
  @@map("role_permissions")
}

model UserRole {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId            String      @map("user_id") @db.Uuid
  user              User        @relation(fields: [userId], references: [id])
  roleId            String      @map("role_id") @db.Uuid
  role              Role        @relation(fields: [roleId], references: [id])
  /// Org-unit anchors for this specific assignment, used whenever one of the role's granted
  /// permissions has a CAMPUS/DEPARTMENT/PROGRAM scopeType. At most one is normally set,
  /// matching whichever scope the assignment represents (e.g. a HOD assignment sets
  /// scopeDepartmentId); enforced at the application layer, not a DB constraint.
  scopeCampusId     String?     @map("scope_campus_id") @db.Uuid
  scopeCampus       Campus?     @relation(fields: [scopeCampusId], references: [id], onDelete: SetNull)
  scopeDepartmentId String?     @map("scope_department_id") @db.Uuid
  scopeDepartment   Department? @relation(fields: [scopeDepartmentId], references: [id], onDelete: SetNull)
  scopeProgramId    String?     @map("scope_program_id") @db.Uuid
  scopeProgram      Program?    @relation(fields: [scopeProgramId], references: [id], onDelete: SetNull)
  assignedByUserId  String?     @map("assigned_by_user_id") @db.Uuid
  assignedAt        DateTime    @default(now()) @map("assigned_at")

  @@unique([tenantId, userId, roleId])
  @@index([tenantId])
  @@index([userId])
  @@index([scopeCampusId])
  @@index([scopeDepartmentId])
  @@index([scopeProgramId])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id])
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([tenantId, userId])
  @@map("sessions")
}

model LoginEvent {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String?          @map("tenant_id") @db.Uuid
  tenant         Tenant?          @relation(fields: [tenantId], references: [id])
  emailAttempted String           @map("email_attempted")
  result         LoginEventResult
  ipAddress      String?          @map("ip_address")
  userAgent      String?          @map("user_agent")
  occurredAt     DateTime         @default(now()) @map("occurred_at")

  @@index([tenantId, occurredAt])
  @@index([emailAttempted, occurredAt])
  @@map("login_events")
}

/// Single-use, short-lived token for the forgot/reset-password flow. Only the SHA-256 hash is
/// stored (same convention as refresh tokens) — the raw value exists only in the link sent to
/// the user. A successful reset revokes every active Session for the user (see
/// PasswordResetService), so a stolen old session can't outlive a password change.
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([userId])
  @@map("password_reset_tokens")
}

/// Single-use, short-lived token for confirming a user's email address. Verification is
/// tracked (emailVerifiedAt) but deliberately does NOT block login (see UsersService.invite) —
/// an admin who invites a user with a known-good email and sets their password has already
/// vouched for the account; gating login on verification is left for a future self-registration
/// flow where nobody has vouched for the email yet.
model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([userId])
  @@map("email_verification_tokens")
}

// ---------------------------------------------------------------------------
// Advanced security controls (tenant-user realm). All required tenantId, so the tenant-guard
// extension auto-scopes them like any other tenant-owned model WHEN accessed through a
// request-scoped TenantScopedPrismaClient. Several of the services that own these tables also
// run pre-authentication (the MFA challenge step of login itself, before a session/JWT exists),
// where no request-scoped tenant context is available yet — those call sites deliberately go
// through PlatformPrismaService with an explicit tenantId on every query instead, the same
// established pattern AuthService/PasswordResetService/EmailVerificationService already use for
// User/Session/token rows. Deliberately NOT extended to the platform-admin realm (beyond MFA
// itself, see PlatformUser/PlatformMfaBackupCode) — see PlatformMfaService's doc comment.
// ---------------------------------------------------------------------------

/// Single-use recovery codes for when a user's authenticator device is unavailable. Hashed with
/// SHA-256 (packages/auth's high-entropy-opaque-value convention), not bcrypt — these are
/// crypto-random, never user-chosen, so bcrypt's slow-by-design property buys nothing here.
model MfaBackupCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([userId])
  @@map("mfa_backup_codes")
}

/// Platform-admin-realm equivalent of MfaBackupCode — a separate table (no tenantId at all)
/// rather than a polymorphic column on the tenant-realm table, matching this schema's existing
/// Session/PlatformSession precedent of parallel realm-specific models.
model PlatformMfaBackupCode {
  id             String       @id @default(cuid())
  platformUserId String       @map("platform_user_id")
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  codeHash       String       @unique @map("code_hash")
  usedAt         DateTime?    @map("used_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([platformUserId])
  @@map("platform_mfa_backup_codes")
}

/// "Remember this device" — set only after a full MFA challenge succeeds (never as a substitute
/// for MFA, only as a way to skip re-prompting for `trustedDeviceDays`). deviceTokenHash follows
/// the opaque-token/SHA-256 convention; the raw token lives only in an httpOnly cookie.
model TrustedDevice {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId          String    @map("user_id") @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceTokenHash String    @unique @map("device_token_hash")
  label           String?
  userAgent       String?   @map("user_agent")
  ipAddress       String?   @map("ip_address")
  lastUsedAt      DateTime  @default(now()) @map("last_used_at")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([tenantId, userId])
  @@map("trusted_devices")
}

/// Stores each REPLACED password hash (not the current one, which lives on User.passwordHash)
/// so a future change can be checked against the last N — see SecuritySettingsService's
/// passwordHistoryCount. Rows beyond the configured count are pruned on each password change.
model PasswordHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([userId, createdAt])
  @@map("password_history")
}

model SecurityEvent {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope          AuditScope
  tenantId       String?               @map("tenant_id") @db.Uuid
  tenant         Tenant?               @relation(fields: [tenantId], references: [id])
  userId         String?               @map("user_id") @db.Uuid
  user           User?                 @relation(fields: [userId], references: [id])
  platformUserId String?               @map("platform_user_id")
  platformUser   PlatformUser?         @relation(fields: [platformUserId], references: [id])
  eventType      SecurityEventType     @map("event_type")
  severity       SecurityEventSeverity @default(INFO)
  ipAddress      String?               @map("ip_address")
  userAgent      String?               @map("user_agent")
  metadata       Json?
  createdAt      DateTime              @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([platformUserId, createdAt])
  @@index([eventType, createdAt])
  @@map("security_events")
}

/// Tenant-level security policy — one row per tenant (created lazily on first read/write with
/// defaults, see SecuritySettingsService). Every threshold is nullable so "unset" cleanly means
/// "inherit the platform default" (PlatformSecuritySettings) rather than needing a sentinel
/// value. mfaRequired only takes effect if the tenant's plan grants FEATURE_KEYS.MFA AND
/// PlatformSecuritySettings.mfaGloballyEnabled is true — enforced in SecuritySettingsService, not
/// the DB.
model TenantSecuritySettings {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String   @unique @map("tenant_id") @db.Uuid
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  mfaRequired            Boolean  @default(false) @map("mfa_required")
  passwordHistoryCount   Int?     @map("password_history_count")
  maxFailedLoginAttempts Int?     @map("max_failed_login_attempts")
  accountLockoutMinutes  Int?     @map("account_lockout_minutes")
  trustedDeviceDays      Int?     @map("trusted_device_days")
  notifyOnNewDeviceLogin Boolean  @default(true) @map("notify_on_new_device_login")
  blockSuspiciousLogins  Boolean  @default(false) @map("block_suspicious_logins")
  createdBy              String?  @map("created_by") @db.Uuid
  updatedBy              String?  @map("updated_by") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("tenant_security_settings")
}

/// Tenant-specific configuration engine — a single JSONB document per tenant storing every
/// configurable aspect of the institution: branding, academic calendar, grading, attendance,
/// fee structure, admissions, numbering formats, certificate/notification templates, etc.
/// Created lazily on first read with empty defaults; the `data` JSON field carries all values
/// so adding new configuration sections never requires a schema migration.
model TenantConfiguration {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @unique @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  data      Json     @default("{}")
  version   Int      @default(1)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tenant_configurations")
}

/// Control-plane singleton (one row; SecuritySettingsService finds-or-creates it) — global
/// defaults applied wherever a tenant hasn't overridden, plus platform-realm-only toggles
/// (mfaRequiredForPlatformAdmins) and kill switches a platform admin can flip without a deploy.
model PlatformSecuritySettings {
  id                              String   @id @default(cuid())
  mfaGloballyEnabled              Boolean  @default(true) @map("mfa_globally_enabled")
  mfaRequiredForPlatformAdmins    Boolean  @default(false) @map("mfa_required_for_platform_admins")
  defaultMaxFailedLoginAttempts   Int      @default(5) @map("default_max_failed_login_attempts")
  defaultAccountLockoutMinutes    Int      @default(15) @map("default_account_lockout_minutes")
  defaultPasswordHistoryCount     Int      @default(5) @map("default_password_history_count")
  defaultTrustedDeviceDays        Int      @default(30) @map("default_trusted_device_days")
  suspiciousLoginDetectionEnabled Boolean  @default(true) @map("suspicious_login_detection_enabled")
  updatedBy                       String?  @map("updated_by")
  createdAt                       DateTime @default(now()) @map("created_at")
  updatedAt                       DateTime @updatedAt @map("updated_at")

  @@map("platform_security_settings")
}

