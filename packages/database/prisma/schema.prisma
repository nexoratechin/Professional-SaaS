// College ERP SaaS â€” Foundation + Organization domains
//
// Foundation (Phase 1): tenants, users, roles, permissions, user_roles, sessions, login_events
// â€” the SaaS control plane and tenant identity/RBAC core.
// Organization: campuses, departments, academic_years, terms, rooms PLUS buildings, sections,
// batches â€” master data every later academic/admissions/attendance/exam module anchors to. The
// schema, RBAC permissions, and tenant-isolation wiring are complete, AND a full CRUD API module
// (search/filter/import/export + scoped permissions) ships with it â€” see apps/api's organization
// module â€” so later work has a stable, usable foundation to build on.
//
// Conventions applied across every model in this file:
// - Primary keys are database-generated UUIDs (`gen_random_uuid()`, native to Postgres 13+ â€”
//   pgcrypto is enabled defensively in the migration for older Postgres compatibility), not
//   cuid()s, per this project's "production-grade" requirement.
// - Every tenant-owned model carries a real, required, indexed, FK'd tenantId column â€” even
//   where derivable through a parent relation â€” so tenant-isolation enforcement (see
//   packages/database/src/client.ts) can be mechanical (driven off the DMMF) rather than bespoke
//   per model. Tenant relations use onDelete: Restrict; tenants are status-transitioned, not
//   hard-deleted.
// - createdBy/updatedBy are plain nullable UUID columns, not enforced Prisma relations: the
//   actor may be a tenant User OR a PlatformUser (see PlatformAuditLog, which already
//   disambiguates actor type for the full audit trail) â€” these columns are a lightweight
//   "who touched this last" convenience, not the system of record for authorship.
// - Soft deletion (deletedAt) is added where records are reference/master data that other rows
//   go on to point at (campuses, departments, academic years, terms, rooms, custom roles) â€”
//   hard-deleting these would orphan history. It's deliberately NOT added to Tenant/User (their
//   status enums already model "gone" without a second, competing concept) or to join/log tables
//   (an assignment's existence is itself binary; sessions/login events are immutable).
// - Known trade-off: Prisma's schema DSL has no partial/filtered unique index support, so
//   `@@unique([tenantId, code])`-style constraints on soft-deletable models apply even to
//   soft-deleted rows â€” a soft-deleted campus/department/etc.'s code stays reserved rather than
//   becoming reusable. Acceptable for now; revisit with a hand-written partial index migration
//   if code reuse after deletion becomes a real product requirement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
  ONE_TIME
}

/// SUSPENDED is distinct from PAST_DUE: PAST_DUE is a billing grace period (the tenant still has
/// access while a payment is chased), SUSPENDED is a deliberate access cutoff (manual admin
/// action â€” see SaasService.suspendSubscription) or Tenant.status mirroring a tenant-level
/// suspension. Both differ from CANCELED (final, requester-initiated end of service) and EXPIRED
/// (the current billing period elapsed with nothing to renew it).
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  EXPIRED
}

/// CUSTOM makes negotiated/one-off pricing an explicit, queryable line-item type rather than
/// overloading BASE â€” e.g. a hand-negotiated discount or a one-time setup fee for a specific
/// tenant, never derived from the Plan's own catalog pricing.
enum SubscriptionItemType {
  BASE
  PER_STUDENT
  PER_CAMPUS
  ADDON_MODULE
  CUSTOM
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum PlatformUserRole {
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
}

enum LoginEventResult {
  SUCCESS
  FAILED_PASSWORD
  FAILED_TENANT_SUSPENDED
  FAILED_USER_INACTIVE
  FAILED_UNKNOWN_EMAIL
  FAILED_ACCOUNT_LOCKED
  FAILED_SUSPICIOUS_LOGIN_BLOCKED
}

enum AuditScope {
  PLATFORM
  TENANT
}

enum RoomType {
  CLASSROOM
  LABORATORY
  SEMINAR_HALL
  AUDITORIUM
  LIBRARY
  OFFICE
  OTHER
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
  WHATSAPP
  PUSH
}

/// QUEUED: the BullMQ job for this notification is currently in flight (a restart-safe way to
/// distinguish "created, waiting for a worker" from "worker is actively attempting delivery").
/// SUPPRESSED: delivery was skipped without an error — the recipient opted out of the channel,
/// or the tenant has no active provider for the channel in production (dev falls back to console).
enum NotificationStatus {
  PENDING
  QUEUED
  SENT
  SUPPRESSED
  FAILED
}

enum NotificationCampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELED
  FAILED
}

/// One row per provider delivery attempt — the delivery log. SENT = handed to the provider;
/// DELIVERED = provider confirmed receipt (in-app, or provider-reported); FAILED/SUPPRESSED as on
/// NotificationStatus.
enum NotificationDeliveryStatus {
  SENT
  DELIVERED
  FAILED
  SUPPRESSED
}

/// Lifecycle of a centralized-managed document. PENDING_UPLOAD: upload URL issued, file not yet
/// uploaded. UPLOADED: upload confirmed, queued (or waiting) for virus scan. AWAITING_SCAN:
/// scan job in flight. READY: current version scanned clean and available for download.
/// VERIFIED: an authorized reviewer confirmed the document's authenticity. REJECTED: rejected
/// by reviewer decision or infected upload — the document is re-uploadable (replacement).
/// REPLACED: superseded by a newer version (kept for history). EXPIRED: past expiresAt or the
/// document type's retention period (worker sweep or explicit action). QUARANTINED: a
/// virus-scanned version was found infected and its object was removed from storage.
enum DocumentStatus {
  PENDING_UPLOAD
  UPLOADED
  AWAITING_SCAN
  READY
  VERIFIED
  REJECTED
  REPLACED
  EXPIRED
  QUARANTINED
}

/// Per-file (DocumentVersion) virus-scan lifecycle. PENDING → SCANNING → CLEAN | INFECTED |
/// ERROR. QUARANTINED: INFECTED and the object was deleted from storage (kept for forensics
/// only). Errors leave the file untouched and are retryable via a re-scan.
enum DocumentScanStatus {
  PENDING
  SCANNING
  CLEAN
  INFECTED
  ERROR
  QUARANTINED
}

/// Who a DocumentAccessGrant is scoped to — an individual tenant user or a tenant Role.
enum DocumentGranteeType {
  USER
  ROLE
}

enum PermissionAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  APPROVE
  PUBLISH
  EXPORT
  REFUND
  MANAGE
}

/// What a role's grant of a permission is narrowed to. The TYPE lives on RolePermission (part
/// of the role's definition â€” e.g. "HOD's students.view is department-scoped" is a fact about
/// the HOD role, not about any one assignment); the concrete VALUE (which department) lives on
/// UserRole (bound per assignment â€” Dr. Smith's HOD assignment is for the CS department, Dr.
/// Jones's is for Physics, same role). OWN means "records the acting user is themselves the
/// subject of" (a student viewing their own grades) â€” enforced by the owning module's queries
/// once that module exists, not by RBAC itself.
enum PermissionScopeType {
  GLOBAL
  CAMPUS
  DEPARTMENT
  PROGRAM
  OWN
}

/// A single, structured, typed timeline distinct from PlatformAuditLog's generic CRUD/action
/// trail â€” purpose-built for a "Security" feed (MFA changes, backup-code use, device trust,
/// suspicious logins, lockouts, password changes). Polymorphic actor (nullable tenantId/userId/
/// platformUserId), same convention as PlatformAuditLog, because it is the one security concept
/// that spans BOTH the tenant-user and platform-admin realms â€” every other new security model in
/// this file stays tenant-scoped-only (see the User/PlatformUser section header for the scoping
/// rationale).
enum SecurityEventType {
  MFA_ENABLED
  MFA_DISABLED
  MFA_CHALLENGE_SUCCEEDED
  MFA_CHALLENGE_FAILED
  BACKUP_CODE_USED
  BACKUP_CODES_REGENERATED
  NEW_DEVICE_LOGIN
  SUSPICIOUS_LOGIN_FLAGGED
  SUSPICIOUS_LOGIN_BLOCKED
  TRUSTED_DEVICE_ADDED
  TRUSTED_DEVICE_REVOKED
  PASSWORD_CHANGED
  PASSWORD_REUSE_BLOCKED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  SESSION_REVOKED
  ALL_SESSIONS_REVOKED
}

enum SecurityEventSeverity {
  INFO
  WARNING
  CRITICAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

/// Lifecycle of a payment attempt against an invoice: PENDING (recorded, awaiting settlement),
/// SUCCEEDED (reconciled â€” marks the invoice PAID on transition), FAILED (rejection â€” the
/// invoice stays open and can be retried within the grace period), REFUNDED (post-settlement
/// reversal; the invoice stays PAID).
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

/// How a subscription payment was collected. No real gateway is wired yet (the payments module
/// is Phase 6+), so manual/offline reconciliation is the primary mode; gateway methods exist so
/// a future integration maps onto the same model without a migration.
enum PaymentMethod {
  CARD
  UPI
  BANK_TRANSFER
  CASH
  OFFLINE
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// BOOLEAN entitlements are on/off (mirrors the existing FeatureFlag semantics â€” "can this
/// tenant see the admissions module at all"). QUANTITY entitlements carry a numeric limit
/// (e.g. "max 5 campuses", "max 2000 students") that a module can check against a live count.
enum EntitlementType {
  BOOLEAN
  QUANTITY
}

/// Where a materialized Entitlement row's value came from â€” recorded so EntitlementsService.
/// recompute() can safely delete-and-rebuild PLAN/PLAN_MODULE/SUBSCRIPTION_ITEM-sourced rows on
/// every plan/subscription change while leaving TENANT_OVERRIDE rows (a platform admin's manual,
/// one-off grant for a specific tenant) untouched â€” the same override-survives-recompute contract
/// TenantFeatureFlag already has with Plan.planFeatures, just generalized to also cover quantities.
enum EntitlementSource {
  PLAN
  PLAN_MODULE
  TENANT_OVERRIDE
  SUBSCRIPTION_ITEM
}

/// Category a WorkflowState falls into â€” lets the engine ask "is this instance done, and how"
/// generically (no module needs to hardcode which specific state codes count as "approved" for
/// its own workflow) rather than by comparing against a hardcoded state code string.
enum WorkflowStateCategory {
  INITIAL
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
}

/// The action that fires a WorkflowTransition. SUBMIT starts an instance (from no state / the
/// initial state); APPROVE/REJECT are approver decisions; RESUBMIT re-enters the flow after a
/// rejection that allows it (see WorkflowState.allowsResubmission); ESCALATE is system-triggered
/// when a task's deadline passes (see WorkflowTransition.escalationAfterHours); CANCEL is a
/// manual withdrawal by the requester or an administrator.
enum WorkflowTransitionAction {
  SUBMIT
  APPROVE
  REJECT
  RESUBMIT
  ESCALATE
  CANCEL
}

/// NONE: the transition fires automatically with no approval step (e.g. straight-through
/// submission). SEQUENTIAL: WorkflowTransitionApprover slots are satisfied one at a time in
/// sequenceOrder â€” the next slot's task is only created once the current one is approved.
/// PARALLEL: every slot's task is created at once; WorkflowTransition.parallelRule decides when
/// enough decisions have come in to resolve the transition.
enum WorkflowApprovalMode {
  NONE
  SEQUENTIAL
  PARALLEL
}

/// How a PARALLEL transition resolves once approver decisions start coming in. ALL: every slot
/// must approve (a single rejection fails it immediately). ANY: the first decision (approve or
/// reject) wins. QUORUM: parallelQuorumCount approvals are needed; the transition fails early if
/// enough slots have rejected that quorum becomes mathematically impossible.
enum WorkflowParallelRule {
  ALL
  ANY
  QUORUM
}

/// Who can act on a WorkflowTransitionApprover slot. ROLE (the common, non-hardcoded case):
/// anyone holding the given tenant Role â€” narrowed to WorkflowInstance.context[scopeField] via
/// the SAME UserRole scope columns the hierarchical RBAC system already uses (no separate
/// approver-scope concept). SPECIFIC_USER: a single named user id, for the rare singleton
/// approver (e.g. "the Principal", when that's one specific account rather than a role).
enum WorkflowApproverType {
  ROLE
  SPECIFIC_USER
}

enum WorkflowInstanceStatus {
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
}

enum WorkflowTaskStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
  EXPIRED
  SKIPPED
}

